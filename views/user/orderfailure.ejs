<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Failed | Irowz Elite</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <%- include('../partials/userprofile/style') %>
    
    <style>
        :root {
            --primary-gold: #b4883e;
            --dark-gold: #8e6b2f;
            --danger-red: #dc3545;
            --dark-red: #c82333;
            --text-dark: #333;
            --text-muted: #666;
            --light-bg: #f8f9fa;
        }
        
        body {
            font-family: 'Nunito Sans', sans-serif;
            background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
            margin: 0;
            padding: 0;
        }
        
        /* Failure Wrapper */
        .failure-wrapper {
            min-height: 100vh;
            padding: 60px 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .failure-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 20px;
            width: 100%;
        }
        
        /* Brand Header */
        .brand-header {
            background: linear-gradient(135deg, var(--danger-red), var(--dark-red));
            padding: 25px 30px;
            border-radius: 12px 12px 0 0;
            text-align: center;
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.2);
        }
        
        .brand-logo {
            color: white;
            font-size: 1.5rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        
        /* Failure Content Card */
        .failure-content {
            background: white;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 4px 20px rgba(220, 53, 69, 0.15);
            padding: 50px 40px;
            text-align: center;
            margin-bottom: 30px;
        }
        
        /* Failure Animation */
        .failure-icon-wrapper {
            margin-bottom: 30px;
            animation: failureEntry 0.8s ease-out;
        }
        
        @keyframes failureEntry {
            0% {
                opacity: 0;
                transform: scale(0.5) rotate(-180deg);
            }
            60% {
                transform: scale(1.1) rotate(0deg);
            }
            100% {
                opacity: 1;
                transform: scale(1) rotate(0deg);
            }
        }
        
        .failure-icon {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, var(--danger-red), var(--dark-red));
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 30px rgba(220, 53, 69, 0.3);
            animation: failureShake 1s ease-in-out, failurePulse 2s ease-in-out 1s infinite;
            position: relative;
        }
        
        .failure-icon::before {
            content: '';
            position: absolute;
            width: 140px;
            height: 140px;
            border: 3px solid rgba(220, 53, 69, 0.3);
            border-radius: 50%;
            animation: ripple 2s ease-out infinite;
        }
        
        @keyframes ripple {
            0% {
                transform: scale(1);
                opacity: 1;
            }
            100% {
                transform: scale(1.3);
                opacity: 0;
            }
        }
        
        .failure-icon i {
            font-size: 55px;
            color: white;
            animation: xMark 0.6s ease-in-out 0.3s both;
        }
        
        @keyframes failureShake {
            0%, 100% { transform: translateX(0) rotate(0deg); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-8px) rotate(-3deg); }
            20%, 40%, 60%, 80% { transform: translateX(8px) rotate(3deg); }
        }
        
        @keyframes failurePulse {
            0%, 100% {
                box-shadow: 0 10px 30px rgba(220, 53, 69, 0.3);
            }
            50% {
                box-shadow: 0 15px 40px rgba(220, 53, 69, 0.5);
            }
        }
        
        @keyframes xMark {
            0% {
                transform: scale(0) rotate(-90deg);
                opacity: 0;
            }
            70% {
                transform: scale(1.2) rotate(10deg);
            }
            100% {
                transform: scale(1) rotate(0deg);
                opacity: 1;
            }
        }
        
        /* Failure Text */
        .failure-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--danger-red);
            margin-bottom: 15px;
            animation: fadeInUp 0.6s ease-out 0.4s both;
        }
        
        .failure-subtitle {
            font-size: 1.2rem;
            color: var(--text-muted);
            margin-bottom: 10px;
            line-height: 1.6;
            animation: fadeInUp 0.6s ease-out 0.5s both;
        }
        
        .failure-message {
            font-size: 1rem;
            color: var(--text-muted);
            line-height: 1.8;
            max-width: 600px;
            margin: 0 auto 30px;
            animation: fadeInUp 0.6s ease-out 0.6s both;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        /* Order Details Card */
        .order-details-card {
            background: linear-gradient(135deg, #fff5f5, #ffe8e8);
            border-radius: 12px;
            padding: 30px;
            margin: 30px 0;
            text-align: left;
            border: 2px solid rgba(220, 53, 69, 0.2);
            animation: fadeInUp 0.6s ease-out 0.7s both;
        }
        
        .order-details-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .order-details-title i {
            color: var(--danger-red);
        }
        
        .order-detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid rgba(220, 53, 69, 0.1);
        }
        
        .order-detail-row:last-child {
            border-bottom: none;
        }
        
        .order-detail-label {
            font-weight: 600;
            color: var(--text-dark);
            font-size: 0.95rem;
        }
        
        .order-detail-value {
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.95rem;
        }
        
        .order-id {
            color: var(--primary-gold);
            font-weight: 700;
            font-family: 'Courier New', monospace;
            font-size: 1rem;
        }
        
        .payment-status {
            background: var(--danger-red);
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        /* Help Info Card */
        .help-info-card {
            background: linear-gradient(135deg, #b4883e,#8e6b2f);
            border-radius: 12px;
            padding: 25px;
            margin: 30px 0;
            text-align: left;
            box-shadow: 0 4px 15px rgba(23, 162, 184, 0.2);
            animation: fadeInUp 0.6s ease-out 0.8s both;
        }
        
        .help-info-card h4 {
            color: white;
            font-size: 1.1rem;
            font-weight: 700;
            margin: 0 0 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .help-info-card p {
            color: rgba(255, 255, 255, 0.95);
            margin: 0;
            line-height: 1.7;
            font-size: 0.95rem;
        }
        
        /* Reasons List */
        .failure-reasons {
            background: white;
            border-radius: 12px;
            padding: 30px;
            margin: 30px 0;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            animation: fadeInUp 0.6s ease-out 0.9s both;
        }
        
        .reasons-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .reasons-title i {
            color: var(--danger-red);
        }
        
        .reason-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            padding: 15px;
            background: var(--light-bg);
            border-radius: 8px;
            margin-bottom: 12px;
            transition: all 0.3s ease;
        }
        
        .reason-item:hover {
            transform: translateX(5px);
            background: #fff5f5;
        }
        
        .reason-icon {
            width: 40px;
            height: 40px;
            background: rgba(220, 53, 69, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--danger-red);
            flex-shrink: 0;
        }
        
        .reason-text {
            flex: 1;
            padding-top: 8px;
        }
        
        .reason-text strong {
            color: var(--text-dark);
            display: block;
            margin-bottom: 3px;
        }
        
        .reason-text span {
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        
        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin: 40px 0;
            flex-wrap: wrap;
            animation: fadeInUp 0.6s ease-out 1s both;
        }
        
        .btn-primary-custom {
            background: linear-gradient(135deg, var(--primary-gold), var(--dark-gold));
            color: white;
            border: none;
            padding: 15px 35px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 15px rgba(180, 136, 62, 0.3);
            transition: all 0.3s ease;
        }
        
        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(180, 136, 62, 0.4);
            color: white;
            text-decoration: none;
        }
        
        .btn-danger-custom {
            background: linear-gradient(135deg, var(--danger-red), var(--dark-red));
            color: white;
            border: none;
            padding: 15px 35px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
            transition: all 0.3s ease;
        }
        
        .btn-danger-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(220, 53, 69, 0.4);
            color: white;
            text-decoration: none;
        }
        
        .btn-outline-custom {
            background: transparent;
            color: var(--primary-gold);
            border: 2px solid var(--primary-gold);
            padding: 13px 33px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
        }
        
        .btn-outline-custom:hover {
            background: var(--primary-gold);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }
        
        /* Support Section */
        .support-section {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            animation: fadeInUp 0.6s ease-out 1.1s both;
        }
        
        .support-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 20px;
            text-align: center;
        }
        
        .support-options {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }
        
        .support-option {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            background: var(--light-bg);
            border-radius: 10px;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .support-option:hover {
            transform: translateY(-5px);
            background: #fff5f5;
            text-decoration: none;
        }
        
        .support-option i {
            font-size: 2rem;
            color: var(--primary-gold);
            margin-bottom: 10px;
        }
        
        .support-option strong {
            color: var(--text-dark);
            margin-bottom: 5px;
        }
        
        .support-option span {
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
            .failure-wrapper {
                padding: 30px 0;
            }
            
            .failure-content {
                padding: 40px 25px;
            }
            
            .failure-title {
                font-size: 2rem;
            }
            
            .order-details-card,
            .failure-reasons,
            .support-section {
                padding: 25px 20px;
            }
            
            .action-buttons {
                flex-direction: column;
                align-items: stretch;
            }
            
            .btn-primary-custom,
            .btn-danger-custom,
            .btn-outline-custom {
                width: 100%;
                justify-content: center;
            }
            
            .order-detail-row {
                flex-direction: column;
                gap: 8px;
                align-items: flex-start;
            }
            
            .support-options {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 480px) {
            .failure-icon {
                width: 100px;
                height: 100px;
            }
            
            .failure-icon i {
                font-size: 45px;
            }
            
            .failure-title {
                font-size: 1.75rem;
            }
            
            .brand-logo {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/userprofile/header') %>
    
    <div class="failure-wrapper">
        <div class="failure-container">
            
            <!-- Brand Header -->
            <div class="brand-header">
                <h1 class="brand-logo">
                    <i class="fas fa-exclamation-triangle"></i>
                    MILLIMILLET
                </h1>
            </div>
            
            <!-- Failure Content -->
            <div class="failure-content">
                <!-- Failure Icon -->
                <div class="failure-icon-wrapper">
                    <div class="failure-icon">
                        <i class="fas fa-times"></i>
                    </div>
                </div>
                
                <!-- Failure Text -->
                <h2 class="failure-title">Payment Failed!</h2>
                <p class="failure-subtitle">
                    Unfortunately, your payment could not be processed.
                </p>
                <p class="failure-message">
                    Don't worry, no amount has been deducted from your account. 
                    You can try again or choose a different payment method. 
                    If the issue persists, please contact your bank or our support team.
                </p>
                
                <!-- Order Details (if available) -->
                <% if (order) { %>
                <div class="order-details-card">
                    <h3 class="order-details-title">
                        <i class="fas fa-file-invoice"></i>
                        Order Information
                    </h3>
                    
                    <div class="order-detail-row">
                        <span class="order-detail-label">Order ID:</span>
                        <span class="order-detail-value order-id">#<%= order.orderId %></span>
                    </div>
                    
                    <div class="order-detail-row">
                        <span class="order-detail-label">Order Date:</span>
                        <span class="order-detail-value">
                            <%= new Date(order.orderDate).toLocaleDateString('en-IN', { 
                                weekday: 'long',
                                year: 'numeric', 
                                month: 'long', 
                                day: 'numeric' 
                            }) %>
                        </span>
                    </div>
                    
                    <div class="order-detail-row">
                        <span class="order-detail-label">Total Amount:</span>
                        <span class="order-detail-value" style="font-size: 1.1rem; color: var(--danger-red);">
                            ₹<%= order.finalAmount.toFixed(2) %>
                        </span>
                    </div>
                    
                    <div class="order-detail-row">
                        <span class="order-detail-label">Payment Status:</span>
                        <span class="payment-status">Failed</span>
                    </div>
                </div>
                <% } %>
                
                <!-- Help Info -->
                <div class="help-info-card">
                    <h4>
                        <i class="fas fa-info-circle"></i>
                        What Happened?
                    </h4>
                    <p>
                        Payment failures can occur due to various reasons. Please review the common causes below 
                        and try again. Our support team is always here to help if you need assistance.
                    </p>
                </div>
            </div>
            
            <!-- Failure Reasons -->
            <div class="failure-reasons">
                <h3 class="reasons-title">
                    <i class="fas fa-exclamation-circle"></i>
                    Common Reasons for Payment Failure
                </h3>
                
                <div class="reason-item">
                    <div class="reason-icon">
                        <i class="fas fa-wallet"></i>
                    </div>
                    <div class="reason-text">
                        <strong>Insufficient Balance</strong>
                        <span>Your account may not have enough funds to complete the transaction.</span>
                    </div>
                </div>
                
                <div class="reason-item">
                    <div class="reason-icon">
                        <i class="fas fa-wifi"></i>
                    </div>
                    <div class="reason-text">
                        <strong>Network Issues</strong>
                        <span>Poor internet connectivity may have interrupted the payment process.</span>
                    </div>
                </div>
                
                <div class="reason-item">
                    <div class="reason-icon">
                        <i class="fas fa-university"></i>
                    </div>
                    <div class="reason-text">
                        <strong>Bank Restrictions</strong>
                        <span>Your bank may have declined the transaction due to security settings.</span>
                    </div>
                </div>
                
                <div class="reason-item">
                    <div class="reason-icon">
                        <i class="fas fa-credit-card"></i>
                    </div>
                    <div class="reason-text">
                        <strong>Card Details</strong>
                        <span>Incorrect card information or expired card may cause payment failure.</span>
                    </div>
                </div>
                
                <div class="reason-item">
                    <div class="reason-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="reason-text">
                        <strong>Transaction Timeout</strong>
                        <span>The payment session may have expired due to inactivity.</span>
                    </div>
                </div>
            </div>
            
            <!-- Action Buttons -->
            <div class="action-buttons">
                <% if (order) { %>
                <a href="/checkout/<%= order.orderId %>" class="btn-danger-custom">
                    <i class="fas fa-redo"></i>
                    Retry Payment
                </a>
                <a href="/orders/<%= order.orderId %>" class="btn-outline-custom">
                    <i class="fas fa-receipt"></i>
                    View Order Details
                </a>
                <% } %>
                <a href="/shop" class="btn-primary-custom">
                    <i class="fas fa-shopping-cart"></i>
                    Continue Shopping
                </a>
            </div>
            
            <!-- Support Section -->
            <div class="support-section">
                <h3 class="support-title">Need Help? We're Here for You!</h3>
                <div class="support-options">
                    <a href="/contact" class="support-option">
                        <i class="fas fa-headset"></i>
                        <strong>Contact Support</strong>
                        <span>Get help from our team</span>
                    </a>
                    
                    <a href="/faq" class="support-option">
                        <i class="fas fa-question-circle"></i>
                        <strong>FAQ</strong>
                        <span>Find quick answers</span>
                    </a>
                    
                    <a href="tel:+911234567890" class="support-option">
                        <i class="fas fa-phone"></i>
                        <strong>Call Us</strong>
                        <span>+91 123 456 7890</span>
                    </a>
                </div>
            </div>
            
        </div>
    </div>
    
    <%- include('../partials/userprofile/footer') %>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Button click animations
        document.querySelectorAll('.btn-primary-custom, .btn-danger-custom, .btn-outline-custom').forEach(button => {
            button.addEventListener('click', function(e) {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = '';
                }, 150);
            });
        });
        
        // Add entrance animations on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);
        
        // Observe animated elements
        document.querySelectorAll('.reason-item, .support-option').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'all 0.5s ease-out';
            observer.observe(el);
        });
        
        // Smooth scroll to center on load
        window.addEventListener('load', () => {
            setTimeout(() => {
                document.querySelector('.failure-content').scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
            }, 100);
        });
    </script>
</body>
</html>