<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart | Your App</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nunito Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #E8DCC4;
            min-height: 100vh;
        }

        .main-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .page-header {
            margin-bottom: 30px;
        }

        .page-title {
            color: #2d2d2d;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .breadcrumb {
            display: flex;
            gap: 8px;
            align-items: center;
            font-size: 0.9rem;
            list-style: none;
            padding: 0;
        }

        .breadcrumb a {
            color: #8b7355;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .breadcrumb a:hover {
            color: #755e45;
        }

        .breadcrumb-separator {
            color: #999;
        }

        .breadcrumb-active {
            color: #666;
        }

        /* Cart Layout */
        .cart-layout {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 30px;
        }

        /* Cart Items Section */
        .cart-items-section {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .cart-header {
            background: #f9f6f1;
            padding: 20px 25px;
            border-bottom: 2px solid #e8dcc4;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .cart-header h2 {
            color: #2d2d2d;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
        }

        .btn {
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
        }

        .btn-primary {
            background-color: #8b7355;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(139, 115, 85, 0.25);
        }

        .btn-primary:hover {
            background-color: #755e45;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(139, 115, 85, 0.35);
        }

        .btn-outline-danger {
            background-color: transparent;
            border: 2px solid #dc3545;
            color: #dc3545;
            padding: 8px 16px;
        }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: #ffffff;
        }

        .btn-outline {
            background-color: transparent;
            border: 2px solid #8b7355;
            color: #8b7355;
        }

        .btn-outline:hover {
            background-color: #8b7355;
            color: #ffffff;
        }

        /* Cart Item */
        .cart-item {
            display: grid;
            grid-template-columns: 120px 1fr auto;
            gap: 20px;
            padding: 25px;
            border-bottom: 1px solid #f5f0e8;
            align-items: center;
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .item-image {
            width: 120px;
            height: 120px;
            border-radius: 10px;
            overflow: hidden;
            border: 2px solid #f5f0e8;
        }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .item-image:hover img {
            transform: scale(1.05);
        }

        .item-details {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .item-name {
            font-weight: 700;
            color: #2d2d2d;
            font-size: 1.1rem;
            margin: 0;
        }

        .item-name a {
            color: #2d2d2d;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .item-name a:hover {
            color: #8b7355;
        }

        .item-price {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .current-price {
            color: #8b7355;
            font-weight: 700;
            font-size: 1.3rem;
        }

        .original-price {
            color: #999;
            text-decoration: line-through;
            font-size: 1rem;
        }

        .item-stock {
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .item-stock.in-stock {
            color: #28a745;
        }

        .item-stock.low-stock {
            color: #ffc107;
        }

        .item-stock.out-of-stock {
            color: #dc3545;
        }

        .item-actions {
            display: flex;
            flex-direction: column;
            gap: 15px;
            align-items: flex-end;
        }

        .quantity-controls {
            display: flex;
            align-items: center;
            border: 2px solid #d4c5b0;
            border-radius: 8px;
            overflow: hidden;
            background: #fafafa;
        }

        .qty-btn {
            background: #f9f6f1;
            border: none;
            padding: 8px 14px;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: 600;
            color: #8b7355;
            transition: background 0.3s ease;
        }

        .qty-btn:hover:not(:disabled) {
            background: #e8dcc4;
        }

        .qty-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .qty-input {
            border: none;
            padding: 8px 12px;
            width: 60px;
            text-align: center;
            outline: none;
            font-weight: 600;
            color: #2d2d2d;
            background: transparent;
        }

        .item-total-price {
            font-size: 1.3rem;
            font-weight: 700;
            color: #2d2d2d;
        }

        .item-remove {
            background: none;
            border: none;
            color: #dc3545;
            cursor: pointer;
            padding: 8px;
            font-size: 1.1rem;
            transition: color 0.3s ease;
        }

        .item-remove:hover {
            color: #a71e2a;
        }


        /* Order Summary Container */
        .order-summary {
            background: #fff;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            position: sticky;
            top: 20px;
        }

        .summary-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 20px;
            color: #333;
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 15px;
        }

        /* Summary Rows */
        .summary-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 12px 0;
            font-size: 14px;
            color: #666;
            border-bottom: 1px solid #f5f5f5;
        }

        .summary-row:last-of-type {
            border-bottom: none;
        }

        .summary-label {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
        }

        .summary-label i {
            margin-right: 6px;
            font-size: 14px;
        }

        .summary-value {
            font-weight: 600;
            color: #333;
            white-space: nowrap;
            margin-left: 15px;
        }

        /* Discount Row */
        .summary-row.discount .summary-value {
            color: #28a745;
            font-weight: 700;
        }

        .text-success {
            color: #28a745 !important;
        }

        /* Free Delivery Progress */
        .free-delivery-info {
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
            margin: 15px 0;
            border: 1px solid #e9ecef;
        }

        .progress-bar-container {
            width: 100%;
            height: 6px;
            background: #e0e0e0;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 10px;
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #28a745, #20c997);
            transition: width 0.3s ease;
            border-radius: 10px;
        }

        .delivery-text {
            display: block;
            text-align: center;
            font-size: 12px;
            color: #666;
            font-weight: 500;
        }

        .delivery-text i {
            color: #28a745;
            margin-right: 5px;
        }

        /* Divider */
        .summary-divider {
            border: 0;
            border-top: 2px dashed #dee2e6;
            margin: 20px 0;
            opacity: 0.6;
        }

        /* TOTAL Row - Make it prominent */
        .summary-row.total {
            padding: 20px 0;
            border-bottom: none;
            margin-top: 5px;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            margin: 0 -25px;
            padding: 20px 25px;
            border-radius: 8px;
        }

        .total-label {
            font-size: 18px;
            font-weight: 700;
            color: #333;
        }

        .total-value {
            font-size: 26px;
            font-weight: 700;
            color: #8b7355;
        }

        /* Savings Badge */
        .total-savings {
            background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
            color: #155724;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            margin: 20px 0;
            font-weight: 600;
            font-size: 15px;
            border: 1px solid #c3e6cb;
            box-shadow: 0 2px 4px rgba(40, 167, 69, 0.1);
        }

        .total-savings i {
            margin-right: 8px;
            font-size: 16px;
        }

        /* Promo Message */
        .promo-message {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 15px;
            border-radius: 8px;
            text-align: center;
            margin: 15px 0 20px 0;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 6px rgba(102, 126, 234, 0.3);
        }

        .promo-message i {
            font-size: 16px;
        }

        /* Checkout Button */
        .checkout-btn {
            width: 100%;
            padding: 16px;
            background: #8b7355;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .checkout-btn:hover:not(:disabled) {
            background: #6d5941;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(139, 115, 85, 0.3);
        }

        .checkout-btn:disabled {
            background: #ccc;
            cursor: not-allowed;
            opacity: 0.6;
        }

        .checkout-btn i {
            font-size: 18px;
        }

        /* Security Badge */
        .security-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px;
            color: #6c757d;
            font-size: 13px;
            background: #f8f9fa;
            border-radius: 6px;
            margin-bottom: 15px;
        }

        .security-badge i {
            color: #28a745;
            font-size: 16px;
        }

        /* Continue Shopping Link */
        .continue-shopping {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px;
            color: #8b7355;
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
            border: 2px solid #8b7355;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .continue-shopping:hover {
            background: #8b7355;
            color: white;
            text-decoration: none;
        }

        .continue-shopping i {
            font-size: 14px;
        }

        /* ================= EMPTY CART (THEME MATCHED – NO BLUE) ================= */

        .empty-cart {
            background: #ffffff;
            border-radius: 18px;
            padding: 60px 40px;
            max-width: 520px;
            margin: 80px auto;
            text-align: center;
            box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
            border: 2px dashed #cbb89d;
        }

        /* ICON */
        .empty-cart i {
            font-size: 58px;
            color: #8b7355;
            margin-bottom: 22px;
            background: #efe6d8;
            width: 110px;
            height: 110px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* TEXT */
        .empty-cart h3 {
            font-size: 24px;
            font-weight: 800;
            color: #2d2d2d;
            margin-bottom: 12px;
        }

        .empty-cart p {
            font-size: 15px;
            color: #6f5a42;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        /* BUTTON – REMOVE BOOTSTRAP BLUE */
        .empty-cart .btn {
            background: #8b7355;
            color: #fff;
            padding: 14px 30px;
            font-size: 15px;
            font-weight: 700;
            border-radius: 10px;
            border: none;
            box-shadow: 0 6px 14px rgba(139, 115, 85, 0.35);
        }

        /* HOVER */
        .empty-cart .btn:hover {
            background: #6f5a42;
            color: #fff;
        }

        /* REMOVE BLUE FOCUS / OUTLINE */
        .empty-cart .btn:focus,
        .empty-cart .btn:active {
            outline: none;
            box-shadow: 0 0 0 3px rgba(139, 115, 85, 0.25);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .order-summary {
                position: static;
                margin-top: 30px;
            }

            .total-label {
                font-size: 16px;
            }

            .total-value {
                font-size: 22px;
            }
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .cart-layout {
                grid-template-columns: 1fr;
            }

            .order-summary {
                position: static;
                order: -1;
            }
        }

        @media (max-width: 768px) {
            .main-container {
                padding: 20px 15px;
            }

            .cart-item {
                grid-template-columns: 100px 1fr;
                gap: 15px;
            }

            .item-image {
                width: 100px;
                height: 100px;
            }

            .item-actions {
                grid-column: 1 / -1;
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
                margin-top: 15px;
                padding-top: 15px;
                border-top: 1px solid #f5f0e8;
            }
        }

        @media (max-width: 480px) {
            .page-title {
                font-size: 1.5rem;
            }

            .cart-header {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }

            .cart-item {
                padding: 20px;
            }
        }
    </style>
    <%- include("../partials/user/header.ejs") %>
</head>

<body>
    <div class="main-container">
       <nav class="breadcrumb">
  <a href="/">Home</a>
  <span class="breadcrumb-separator">›</span>
  <span class="breadcrumb-active">Cart</span>
</nav>


        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">Your cart</h1>
        </div>

        <% if (cart && cart.products && cart.products.length> 0) { %>
            <div class="cart-layout">
                <!-- Cart Items -->
                <div class="cart-items-section">
                    <div class="cart-header">
                        <h2>Shopping Cart (<%= cart.products.length %> items)</h2>
                        <button class="btn btn-outline-danger" onclick="clearCart()">
                            <i class="fas fa-trash"></i> Clear Cart
                        </button>
                    </div>

                    <% cart.products.forEach((item)=> {
                        const product = item.productId;
                        const variant = product.variant?.find(
                        v => v._id.toString() === item.variantId.toString()
                        );

                        const stock = variant ? variant.stock : 0;
                        %>
                        <div class="cart-item" data-product-id="<%= product._id %>"
                            data-variant-id="<%= item.variantId %>">

                            <!-- Product Image -->
                            <div class="item-image">
                                <a href="/product/details/<%= product._id %>">
                                    <img src="<%= product.productImage && product.productImage.length > 0 
                                    ? '/uploads/images/' + product.productImage[0] 
                                    : '/placeholder.jpg' %>" alt="<%= product.productName %>">
                                </a>
                            </div>

                            <!-- Product Details -->
                            <div class="item-details">
                                <h3 class="item-name">
                                    <a href="/product/details/<%= item.productId._id %>">
                                        <%= item.productId.productName %>
                                    </a>
                                </h3>

                                <div class="item-price">
                                    <span class="current-price">Rs <%= item.price.toFixed(2) %></span>

                                </div>

                                <!-- Stock Status -->
                                <% if (stock===0) { %>
                                    <span class="item-stock out-of-stock">
                                        <i class="fas fa-times-circle"></i> Out of Stock
                                    </span>
                                    <% } else if (stock <=5) { %>
                                        <span class="item-stock low-stock">
                                            <i class="fas fa-exclamation-triangle"></i> Only <%= stock %> left
                                        </span>
                                        <% } else { %>
                                            <span class="item-stock in-stock">
                                                <i class="fas fa-check-circle"></i> In Stock
                                            </span>
                                            <% } %>
                            </div>

                            <div class="item-actions">
                                <div class="quantity-controls">

                                    <!-- DECREASE -->
                                    <button class="qty-btn" onclick="updateQuantity(
        '<%= product._id %>',
        '<%= item.variantId %>',
        -1
      )" <%=(item.quantity <=1 || stock===0) ? 'disabled' : '' %>>
                                        -
                                    </button>

                                    <!-- INPUT -->
                                    <input type="number" class="qty-input" value="<%= item.quantity %>" min="1"
                                        max="<%= Math.min(10, stock) %>" onchange="updateQuantity(
    '<%= product._id %>',
    '<%= item.variantId %>',
    0,
    this.value
  )" <%=stock===0 ? 'disabled' : '' %>
                                    >


                                    <!-- INCREASE -->
                                    <button class="qty-btn" onclick="updateQuantity(
                                                                        '<%= product._id %>',
                                                                        '<%= item.variantId %>', 1)" 
                                                                        <%=(item.quantity>= Math.min(10, stock) || stock === 0) ? 'disabled' : '' %>>
                                        +
                                    </button>
                                </div>


                                <div class="item-total-price">
  Rs <%= (item.price * item.quantity).toFixed(2) %>
</div>


                                <button class="item-remove" onclick="removeItem(
  '<%= product._id %>',
  '<%= item.variantId %>'
)">

                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </div>
                        <% }); %>
                </div>

<div class="order-summary">

                <!-- Order Summary -->
                <div class="summary-row">
  <span class="summary-label"><strong>Items Total</strong></span>
  <span class="summary-value" id="saletotal">
    Rs <%= saletotal.toFixed(2) %>
  </span>
</div>

<div class="summary-row">
  <span class="summary-label">
    <i class="fas fa-truck"></i> Delivery Charges
  </span>
  <% if (shipping === 0) { %>
   <span class="summary-value text-success" id="shipping"><strong>FREE</strong></span>

  <% } else { %>
   <span class="summary-value" id="shipping">Rs <%= shipping.toFixed(2) %></span>

  <% } %>
</div>

<hr class="summary-divider">
<% if (couponDiscount && couponDiscount > 0) { %>
  <div class="summary-row">
    <span class="summary-label text-success">
      <i class="fas fa-tag"></i> Coupon Discount
    </span>
    <span class="summary-value text-success">
      - Rs <%= couponDiscount.toFixed(2) %>
    </span>
  </div>
<% } %>


<div class="summary-row total">
  <span class="total-label">Total Amount</span>
  <span class="total-value" id="total">
    Rs <%= total.toFixed(2) %>
  </span>
</div>




                                                <!-- Promo Message -->
                                                <div class="promo-message">
                                                    <i class="fas fa-ticket-alt"></i>
                                                    <span>More offers at checkout!</span>
                                                </div>

                                                <!-- Checkout Button -->
                                                <% const hasOutOfStock=cart.products.some(item=> {
                                                    const variant = item.productId.variant?.find(
                                                    v => v._id.toString() === item.variantId.toString()
                                                    );
                                                    return !variant || variant.stock === 0;
                                                    });
                                                    %>


                                                    <button class="checkout-btn" onclick="proceedToCheckout()"
                                                        <%=hasOutOfStock ? 'disabled' : '' %>>
                                                        <% if (hasOutOfStock) { %>
                                                            <i class="fas fa-exclamation-circle"></i>
                                                            Remove Out of Stock Items
                                                            <% } else { %>
                                                                <i class="fas fa-lock"></i> Proceed to
                                                                Checkout
                                                                <% } %>
                                                    </button>

                                                    <!-- Security Badge -->
                                                    <div class="security-badge">
                                                        <i class="fas fa-shield-alt"></i>
                                                        <span>Safe & Secure Payments</span>
                                                    </div>

                                                    <!-- Continue Shopping -->
                                                    <a href="/shop" class="continue-shopping">
                                                        <i class="fas fa-arrow-left"></i> Continue
                                                        Shopping
                                                    </a>
                </div>
            </div>
    </div> <!-- End of cart-layout -->
    <% } else { %> <!-- Empty Cart -->
        <div class="empty-cart"> <i class="fas fa-shopping-cart"></i>
            <h3>Your cart is empty</h3>
            <p>Looks like you haven't added anything to your cart yet</p> <a href="/shop" class="btn btn-primary"> <i
                    class="fas fa-shopping-bag"></i> Start Shopping </a>
        </div>
        <% } %>
            </div>


            <script>
                async function updateQuantity(productId, variantId, change, newValue = null) {
                    const item = document.querySelector(
                        `[data-product-id="${productId}"][data-variant-id="${variantId}"]`
                    );
                    if (!item) return;

                    const qtyInput = item.querySelector('.qty-input');
                    const decreaseBtn = item.querySelector('.qty-btn:first-child');
                    const increaseBtn = item.querySelector('.qty-btn:last-child');

                    const currentQty = parseInt(qtyInput.value);
                    const maxQty = parseInt(qtyInput.max) || 10;

                    let newQty =
                        newValue !== null ? parseInt(newValue) : currentQty + change;

                    newQty = Math.max(1, Math.min(newQty, maxQty));

                    // 🔒 prevent spam clicking
                    decreaseBtn.disabled = true;
                    increaseBtn.disabled = true;

                    const response = await fetch('/updateCart', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            productId,
                            variantId,
                            quantity: newQty
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        qtyInput.value = newQty;

                        // ✅ FIX: update button states dynamically
                        decreaseBtn.disabled = newQty <= 1;
                        increaseBtn.disabled = newQty >= maxQty;

                        // Update item total
                        item.querySelector('.item-total-price').innerText =
                            `Rs ${data.itemTotal.toFixed(2)}`;

                        // Update summary
                       item.querySelector('.item-total-price').innerText =
  `Rs ${data.itemTotal.toFixed(2)}`;

document.getElementById('saletotal').innerText =
  `Rs ${data.saletotal.toFixed(2)}`;

document.getElementById('total').innerText =
  `Rs ${data.total.toFixed(2)}`;

const shippingEl = document.getElementById('shipping');
shippingEl.innerText =
  Number(data.shipping) === 0
    ? 'FREE'
    : `Rs ${Number(data.shipping).toFixed(2)}`;

                    }
                }
                async function removeItem(productId, variantId) {
                    const item = document.querySelector(
                        `[data-product-id="${productId}"][data-variant-id="${variantId}"]`
                    );
                    if (!item) return;

                    const result = await swal({
                        title: 'Remove Item?',
                        text: 'This item will be removed from your cart.',
                        icon: 'warning',
                        buttons: { cancel: 'Cancel', confirm: 'Remove' },
                        dangerMode: true
                    });

                    if (!result) return;

                    const response = await fetch('/removeCart', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, variantId })
                    });

                    const data = await response.json();

                    if (data.success) {
  window.location.reload();
                    } else {
                        swal('Error', data.message, 'error');
                    }
                }
                function proceedToCheckout() {
                    window.location.href = "/checkout";
                }
                async function clearCart() {
                    const result = await swal({
                        title: 'Clear Cart?',
                        text: 'All items will be removed from your cart.',
                        icon: 'warning',
                        buttons: { cancel: 'Cancel', confirm: 'Clear' },
                        dangerMode: true
                    });

                    if (!result) return;

                    const response = await fetch('/clearCart', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    const data = await response.json();

                    if (data.success) {
                        window.location.reload();
                    } else {
                        swal('Error', data.message, 'error');
                    }
                }

            </script>
</body>

</html>