    <div class="benefit-box">
      <i class="fas fa-dumbbell"></i>
      <h4>Perfect for Active Lifestyles</h4>
      <p>Ideal for fitness lovers, busy professionals, and growing kids.</p>
    </div>

   
  </div>
</div>

</div>

<div class="about-section">
  <h3>Our Promise</h3>
  <div class="about-values">
    <div class="value-box">
