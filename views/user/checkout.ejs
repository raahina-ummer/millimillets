<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | MilliMillet</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        * {
            font-family: 'Nunito Sans', sans-serif;
        }

        body {
            background-color: #E8DCC4;
            margin: 0;
            padding: 0;
        }

        .checkout-wrapper {
            background-color: #E8DCC4;
            min-height: 100vh;
            padding: 50px 0;
        }

        .page-title {
            color: #8B7355;
            font-weight: 800;
            font-size: 2.5rem;
            margin-bottom: 40px;
            text-transform: uppercase;
            letter-spacing: 2px;
            position: relative;
            padding-bottom: 20px;
        }

        .page-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, #8B7355, transparent);
        }

        .checkout-container {
            display: grid;
            grid-template-columns: 1fr 420px;
            gap: 35px;
            margin-top: 25px;
        }

        /* Section Cards */
        .checkout-section {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 25px rgba(139, 115, 85, 0.08);
            margin-bottom: 30px;
            overflow: hidden;
            border: 1px solid rgba(139, 115, 85, 0.05);
            transition: box-shadow 0.3s ease;
        }

        .checkout-section:hover {
            box-shadow: 0 6px 35px rgba(139, 115, 85, 0.12);
        }

        .section-header {
            background: linear-gradient(135deg, #f9f6f1 0%, #E8DCC4 100%);
            padding: 24px 30px;
            border-bottom: 1px solid rgba(139, 115, 85, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-header h3 {
            margin: 0;
            color: #8B7355;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
        }

        .section-header i {
            font-size: 1.4rem;
            opacity: 0.9;
        }

        .section-content {
            padding: 30px;
        }

        /* Address Cards */
        .address-card {
            border: 2px solid #d4c5b0;
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 18px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            background: #fafaf8;
        }

        .address-card:hover {
            border-color: #8B7355;
            box-shadow: 0 4px 20px rgba(139, 115, 85, 0.12);
            transform: translateY(-3px);
            background: white;
        }

        .address-card.selected {
            border-color: #8B7355;
            background: white;
            box-shadow: 0 6px 25px rgba(139, 115, 85, 0.15);
        }

        .address-card.selected::before {
            content: '✓';
            position: absolute;
            top: 18px;
            right: 18px;
            background: linear-gradient(135deg, #8B7355, #755e45);
            color: white;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: bold;
            box-shadow: 0 3px 12px rgba(139, 115, 85, 0.3);
        }

        .address-info h4 {
            margin: 0 0 12px;
            color: #333;
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: 0.3px;
        }

        .address-info p {
            margin: 0 0 8px;
            color: #666;
            line-height: 1.7;
            font-size: 0.95rem;
        }

        .address-info p:first-of-type {
            color: #755e45;
            font-weight: 600;
        }

        .address-actions {
            display: flex;
            gap: 12px;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid #E8DCC4;
        }

        .add-address-card {
            border: 2px dashed #d4c5b0;
            border-radius: 14px;
            padding: 45px 30px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            color: #8B7355;
            background: #fafaf8;
        }

        .add-address-card:hover {
            border-color: #8B7355;
            background: white;
            transform: translateY(-3px);
            box-shadow: 0 4px 20px rgba(139, 115, 85, 0.12);
        }

        .add-address-card i {
            font-size: 2.8rem;
            margin-bottom: 16px;
            display: block;
            color: #8B7355;
            opacity: 0.9;
        }

        .add-address-card h4 {
            color: #8B7355;
            font-weight: 700;
            margin-bottom: 8px;
            font-size: 1.1rem;
            letter-spacing: 0.3px;
        }

        .add-address-card p {
            color: #755e45;
            margin: 0;
            font-size: 0.95rem;
        }

        /* Payment Methods */
        .payment-method {
            display: flex;
            align-items: center;
            gap: 22px;
            padding: 22px 24px;
            border: 2px solid #d4c5b0;
            border-radius: 14px;
            margin-bottom: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #fafaf8;
        }

        .payment-method:hover {
            border-color: #8B7355;
            transform: translateY(-3px);
            box-shadow: 0 4px 20px rgba(139, 115, 85, 0.12);
            background: white;
        }

        .payment-method.selected {
            border-color: #8B7355;
            background: white;
            box-shadow: 0 6px 25px rgba(139, 115, 85, 0.15);
        }

        .payment-icon {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, #E8DCC4, #f0eae0);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8B7355;
            font-size: 1.6rem;
            flex-shrink: 0;
            transition: all 0.3s ease;
        }

        .payment-method.selected .payment-icon {
            background: linear-gradient(135deg, #8B7355, #755e45);
            color: white;
            box-shadow: 0 4px 15px rgba(139, 115, 85, 0.2);
        }

        .payment-info h4 {
            margin: 0 0 5px;
            color: #333;
            font-weight: 700;
            font-size: 1.05rem;
            letter-spacing: 0.3px;
        }

        .payment-info p {
            margin: 0;
            color: #666;
            font-size: 0.92rem;
            line-height: 1.4;
        }

        /* Order Items */
        .checkout-item {
            display: flex;
            gap: 22px;
            padding: 22px;
            background: #fafaf8;
            border-radius: 14px;
            margin-bottom: 16px;
            border: 1px solid #f0eae0;
            transition: all 0.3s ease;
        }

        .checkout-item:hover {
            background: white;
            border-color: #d4c5b0;
            box-shadow: 0 2px 12px rgba(139, 115, 85, 0.08);
        }

        .checkout-item:last-child {
            margin-bottom: 0;
        }

        .item-image {
            width: 100px;
            height: 100px;
            border-radius: 12px;
            overflow: hidden;
            flex-shrink: 0;
            border: 2px solid #d4c5b0;
            background: #f9f6f1;
        }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .item-details {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .item-name {
            font-weight: 700;
            color: #333;
            margin: 0 0 10px;
            font-size: 1.1rem;
            letter-spacing: 0.3px;
        }

        .item-quantity {
            color: #755e45;
            font-size: 0.95rem;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .item-price {
            color: #8B7355;
            font-weight: 800;
            font-size: 1.3rem;
            letter-spacing: 0.3px;
        }

        /* Order Summary Sidebar */
        .order-summary {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 25px rgba(139, 115, 85, 0.08);
            padding: 30px;
            height: fit-content;
            position: sticky;
            top: 20px;
            border: 1px solid rgba(139, 115, 85, 0.05);
        }

        .summary-title {
            margin: 0 0 28px;
            color: #8B7355;
            font-weight: 800;
            font-size: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            padding-bottom: 15px;
        }

        .summary-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 40px;
            height: 2px;
            background: #8B7355;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 16px;
            padding-bottom: 14px;
            border-bottom: 1px solid #f0eae0;
            align-items: center;
        }

        .summary-row:last-of-type {
            border-bottom: none;
        }

        .summary-row.total {
            border-top: 2px solid #8B7355;
            padding-top: 22px;
            margin-top: 22px;
            font-size: 1.35rem;
            font-weight: 800;
            color: #8B7355;
            letter-spacing: 0.5px;
        }

        .summary-label {
            color: #755e45;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .summary-value {
            color: #333;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .summary-value.discount {
            color: #28a745;
            font-weight: 800;
        }

        .summary-value.free {
            color: #28a745;
            font-weight: 700;
        }

        /* Place Order Button */
        .place-order-btn {
            width: 100%;
            background: linear-gradient(135deg, #8B7355, #755e45);
            color: white;
            border: none;
            padding: 16px 25px;
            border-radius: 12px;
            font-size: 1.05rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 28px;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            box-shadow: 0 4px 15px rgba(139, 115, 85, 0.2);
        }

        .place-order-btn:hover:not(:disabled) {
            background: linear-gradient(135deg, #755e45, #6b5139);
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(139, 115, 85, 0.3);
        }

        .place-order-btn:disabled {
            background: linear-gradient(135deg, #d4c5b0, #c9baaa);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .place-order-btn i {
            font-size: 1.1rem;
        }

        /* Security Info */
        .security-info {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #755e45;
            font-size: 0.92rem;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #f0eae0;
            line-height: 1.6;
        }

        .security-info i {
            color: #28a745;
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        /* Buttons */
        .btn-custom {
            padding: 9px 18px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-primary-custom {
            background: #8B7355;
            color: white;
            border: 2px solid #8B7355;
            box-shadow: 0 2px 8px rgba(139, 115, 85, 0.15);
        }

        .btn-primary-custom:hover {
            background: #755e45;
            border-color: #755e45;
            box-shadow: 0 4px 12px rgba(139, 115, 85, 0.25);
            transform: translateY(-1px);
        }

        .btn-outline-custom {
            background: white;
            color: #8B7355;
            border: 2px solid #8B7355;
        }

        .btn-outline-custom:hover {
            background: #8B7355;
            color: white;
            box-shadow: 0 4px 12px rgba(139, 115, 85, 0.25);
            transform: translateY(-1px);
        }

        .btn-danger-custom {
            background: white;
            color: #dc3545;
            border: 2px solid #dc3545;
        }

        .btn-danger-custom:hover {
            background: #dc3545;
            color: white;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.25);
            transform: translateY(-1px);
        }

        .btn-add-new {
            background: white;
            color: #8B7355;
            border: 2px solid #8B7355;
            padding: 11px 22px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            letter-spacing: 0.3px;
            box-shadow: 0 2px 8px rgba(139, 115, 85, 0.1);
        }

        .btn-add-new:hover {
            background: #8B7355;
            color: white;
            box-shadow: 0 4px 12px rgba(139, 115, 85, 0.25);
            transform: translateY(-1px);
        }

        .breadcrumb {
            background: transparent !important;
            padding: 0 !important;
            margin-bottom: 35px !important;
        }

        .breadcrumb-item a {
            color: #8B7355 !important;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

        .breadcrumb-item a:hover {
            color: #755e45 !important;
        }

        .breadcrumb-item.active {
            color: #755e45 !important;
            font-weight: 600;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            color: #8B7355;
            opacity: 0.5;
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .checkout-container {
                grid-template-columns: 1fr;
            }

            .order-summary {
                position: static;
                order: -1;
            }
        }

        @media (max-width: 768px) {
            .page-title {
                font-size: 2rem;
                margin-bottom: 30px;
            }

            .checkout-item {
                flex-direction: column;
                text-align: center;
            }

            .item-image {
                margin: 0 auto;
            }

            .address-actions {
                flex-direction: column;
            }

            .btn-custom {
                width: 100%;
                justify-content: center;
            }

            .section-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .btn-add-new {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/user/header.ejs') %>

    <div class="checkout-wrapper">
        <div class="container">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/cart">Cart</a></li>
                    <li class="breadcrumb-item active">Checkout</li>
                </ol>
            </nav>

            <h1 class="page-title">Checkout</h1>

            <div class="checkout-container">
                <!-- Left Column -->
                <div>
                    <!-- Shipping Address Section -->
                    <div class="checkout-section">
                        <div class="section-header">
                            <h3><i class="fas fa-map-marker-alt"></i> Shipping Address</h3>
                            <a href="/addAddress?redirect=checkout" class="btn-add-new">
                                <i class="fas fa-plus"></i> Add New
                            </a>
                        </div>
                        <div class="section-content">
                            <% if (addresses && addresses.length > 0) { %>
                                <% addresses.forEach((address)=> { %>
                                    <div class="address-card <%= address.isDefault ? 'selected' : '' %>"
                                        onclick="selectAddress('<%= address._id %>')"
                                        data-address-id="<%= address._id %>">
                                        <div class="address-info">
                                            <h4>
                                                <%= address.firstName %> <%= address.lastName %>
                                                <span style="font-size: 0.85rem; color: #8B7355; font-weight: 600;">
                                                    (<%= address.addressType.charAt(0).toUpperCase() +
                                                        address.addressType.slice(1) %>)
                                                </span>
                                            </h4>
                                            <p><strong>Phone:</strong> <%= address.phone %></p>
                                            <p><%= address.address %></p>
                                            <p><%= address.state %>, <%= address.pinCode %></p>
                                            <p><%= address.country %></p>
                                        </div>
                                        <div class="address-actions">
                                            <button class="btn-custom btn-outline-custom"
                                                onclick="editAddress('<%= address._id %>', event)">
                                                <i class="fas fa-edit"></i> Edit
                                            </button>
                                            <button class="btn-custom btn-danger-custom"
                                                onclick="deleteAddress('<%= address._id %>', event)">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } %>

                            <!-- Add New Address Card -->
                            <div class="add-address-card" onclick="openAddressModal()">
                                <i class="fas fa-plus-circle"></i>
                                <h4>Add New Address</h4>
                                <p>Add a new shipping address for delivery</p>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Method Section -->
                    <div class="checkout-section">
                        <div class="section-header">
                            <h3><i class="fas fa-credit-card"></i> Payment Method</h3>
                        </div>
                        <div class="section-content">
                            <div class="payment-method selected" onclick="selectPayment('cod')" data-payment="cod">
                                <div class="payment-icon">
                                    <i class="fas fa-money-bill-wave"></i>
                                </div>
                                <div class="payment-info">
                                    <h4>Cash on Delivery</h4>
                                    <p>Pay with cash when your order is delivered</p>
                                </div>
                            </div>

                            <div class="payment-method" onclick="selectPayment('razorpay')" data-payment="razorpay">
                                <div class="payment-icon">
                                    <i class="fas fa-credit-card"></i>
                                </div>
                                <div class="payment-info">
                                    <h4>Online Payment</h4>
                                    <p>Pay securely with Razorpay (UPI, Cards, Net Banking)</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Order Items Section -->
                    <div class="checkout-section">
                        <div class="section-header">
                            <h3><i class="fas fa-shopping-bag"></i> Order Items (<%= itemCount %> items)</h3>
                        </div>
                        <div class="section-content">
                            <% cart.products.forEach((product) => { %>
                                <div class="checkout-item">
                                    <div class="item-image">
                                        <img 
                                            src="<%= product.productId && product.productId.productImage && product.productId.productImage.length > 0 
                                                    ? '/uploads/images/' + product.productId.productImage[0] 
                                                    : '/placeholder.jpg' %>" 
                                            alt="<%= product.productId ? product.productId.productName : 'No image' %>">
                                    </div>
                                    <div class="item-details">
                                        <h4 class="item-name"><%= product.productId ? product.productId.productName : 'Unknown' %></h4>
                                        <div class="item-quantity">Quantity: <%= product.quantity %></div>
                                        <div class="item-price">
  ₹<%= (
    ((product.productId.variant && product.productId.variant.length > 0) 
      ? (product.productId.variant[0].salePrice || product.productId.variant[0].regularPrice) 
      : 0
    ) * product.quantity
  ).toFixed(2) %>
</div>

                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>

               <!-- Right Column - Order Summary -->
<div class="order-summary">
    <h3 class="summary-title">Order Summary</h3>

    <!-- Subtotal -->
    <div class="summary-row">
        <span class="summary-label">Subtotal (<%= itemCount %> items)</span>
        <span class="summary-value">₹<%= subtotal.toFixed(2) %></span>
    </div>

    <!-- Product Discount -->
    <% if (discount && parseFloat(discount) > 0) { %>
    <div class="summary-row">
        <span class="summary-label">Discount</span>
        <span class="summary-value discount">-₹<%= parseFloat(discount).toFixed(2) %></span>
    </div>
    <% } %>

    <!-- Apply/Remove Coupon Buttons -->
    <div style="margin-bottom: 15px; margin-top: 15px;">
        <button id="applyCouponBtn" 
            class="place-order-btn" 
            style="background:#f9f6f1; color:#8B7355; border:2px solid #8B7355; width:100%;" 
            onclick="openCouponModal()">
            <i class="fas fa-ticket-alt"></i> Apply Coupon
        </button>

        <button id="removeCouponBtn"
            class="place-order-btn"
            style="display:none; background:#dc3545; color:white; width:100%; margin-top:10px;"
            onclick="removeCoupon()">
            <i class="fas fa-times"></i> Remove Coupon
        </button>
    </div>

    <!-- Coupon Discount Row (Dynamic) -->
    <% if (couponDiscount && couponDiscount > 0) { %>
    <div class="summary-row" id="couponDiscountRow">
        <span class="summary-label">Coupon Discount</span>
        <span class="summary-value discount">-₹<%= parseFloat(couponDiscount).toFixed(2) %></span>
    </div>
    <% } %>

    <!-- Shipping -->
    <div class="summary-row">
        <span class="summary-label">Delivery Fee</span>
        <span class="summary-value">
            <% if (shipping === 0) { %>
                <span style="color: #28a745; font-weight: 700;">FREE</span>
            <% } else { %>
                ₹<%= shipping.toFixed(2) %>
            <% } %>
        </span>
    </div>

    <!-- Total -->
    <div class="summary-row total">
        <span>Total Amount</span>
        <span>₹<%= total.toFixed(2) %></span>
    </div>

    <!-- Place Order Button -->
   


 <button class="place-order-btn" 
        id="placeOrderBtn" 
        onclick="placeOrder()">
    <i class="fas fa-money-bill"></i> Place Order (COD)
</button>


<button class="place-order-btn" 
        style="background:#0d6efd; margin-top:10px;" 
        id="razorpayBtn" 
        onclick="placeOrderRazorpay()">
    <i class="fas fa-credit-card"></i> Pay With Razorpay
</button>

    <!-- Security Info -->
    <div class="security-info">
        <i class="fas fa-shield-alt"></i>
        <span>Your payment information is secure and encrypted</span>
    </div>
</div>

    <%- include('../partials/user/footer.ejs') %>

 <script>

let selectedAddressId = '<%= addresses.find(addr => addr.isDefault)?._id || (addresses.length > 0 ? addresses[0]._id : "") %>';
let selectedPaymentMethod = 'cod';


function selectAddress(addressId) {
  document.querySelectorAll('.address-card').forEach(card => card.classList.remove('selected'));
  const selectedCard = document.querySelector(`[data-address-id="${addressId}"]`);
  if (selectedCard) selectedCard.classList.add('selected');
  selectedAddressId = addressId;
}

function selectPayment(paymentMethod) {
  document.querySelectorAll('.payment-method').forEach(method => method.classList.remove('selected'));
  document.querySelector(`[data-payment="${paymentMethod}"]`).classList.add('selected');

  selectedPaymentMethod = paymentMethod;

  if (paymentMethod === "razorpay") {
    document.getElementById("razorpayBtn").style.display = "block";
    document.getElementById("placeOrderBtn").style.display = "none";
  } else {
    document.getElementById("placeOrderBtn").style.display = "block";
    document.getElementById("razorpayBtn").style.display = "none";
  }
}


function openAddressModal() {
  window.location.href = "/addAddress?redirect=checkout";
}

async function editAddress(addressId, event) {
  event.stopPropagation();
  window.location.href = /editAddress/${addressId}?redirect=checkout;
}

async function deleteAddress(addressId, event) {
  event.stopPropagation();
  const result = await swal({
    title: "Delete Address?",
    text: "This address will be permanently deleted.",
    icon: "warning",
    buttons: { cancel: "Cancel", confirm: { text: "Delete", value: true } },
    dangerMode: true
  });

  if (result) {
    const response = await fetch(/deleteAddress/${addressId}, { method: 'DELETE' });
    const data = await response.json();

    if (data.success) {
      swal("Deleted!", "Address deleted successfully.", "success").then(() => location.reload());
    } else {
      swal("Error!", data.message, "error");
    }
  }
}

/* ---------- Razorpay Payment ---------- */

async function payNow(amount, orderId) {
  const res = await fetch("/create-order", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ amount })
  });

  const data = await res.json();

  const options = {
    key: data.key,
    amount: data.order.amount,
    currency: "INR",
    name: "Milli Millet Ecommerce",
    order_id: data.order.id,
    handler: async function (response) {
      // Verify payment
      const verifyRes = await fetch("/verify-payment", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ paymentResponse: response, orderId })
      });
      const verifyData = await verifyRes.json();
      if (verifyData.success) {
        window.location.href = /ordersuccess?orderId=${orderId};
      } else {
        window.location.href = /orderfailure?orderId=${orderId};
      }
    },
    theme: { color: "#3399cc" }
  };

  const rzp = new Razorpay(options);
  rzp.open();
}

// Place Order function for COD only
async function placeOrder() {
  if (!selectedAddressId) return swal("Error!", "Please select a shipping address", "error");

  const btn = document.getElementById('placeOrderBtn');
  const originalHTML = btn.innerHTML;

  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
  btn.disabled = true;

  try {
    const response = await fetch('/placeOrder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ 
        addressId: selectedAddressId, 
        paymentMethod: 'cod'
      })
    });

    const data = await response.json();

    if (data.success) {
      window.location.href = /ordersuccess?orderId=${data.orderId};
    } else {
      swal("Error!", data.message, "error");
      btn.innerHTML = originalHTML;
      btn.disabled = false;
    }
  } catch (error) {
    swal("Error!", "Something went wrong. Please try again.", "error");
    btn.innerHTML = originalHTML;
    btn.disabled = false;
  }
}

// Place Order function for Razorpay only
async function placeOrderRazorpay() {
  if (!selectedAddressId) return swal("Error!", "Please select a shipping address", "error");

  const btn = document.getElementById('razorpayBtn');
  const originalHTML = btn.innerHTML;

  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
  btn.disabled = true;

  try {
    const response = await fetch('/placeOrder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ 
        addressId: selectedAddressId, 
        paymentMethod: 'razorpay'
      })
    });

    const data = await response.json();

    if (data.success) {
      payNow(data.amount, data.orderId);
    } else {
      swal("Error!", data.message, "error");
      btn.innerHTML = originalHTML;
      btn.disabled = false;
    }
  } catch (error) {
    swal("Error!", "Something went wrong. Please try again.", "error");
    btn.innerHTML = originalHTML;
    btn.disabled = false;
  }
}

/* ---------- Coupon Apply ---------- */

function openCouponModal() {
  swal({
    title: "Apply Coupon",
    content: { element: "input", attributes: { placeholder: "Enter coupon code", type: "text" } },
    buttons: { cancel: "Cancel", confirm: { text: "Apply", value: "apply" } }
  }).then(value => { if (value) applyCoupon(value); });
}

async function applyCoupon(couponCode) {
  const response = await fetch('/applyCoupon', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: "include",
    body: JSON.stringify({ couponCode })
  });

  const data = await response.json();

  if (!data.success) return swal("Invalid!", data.message, "error");

  swal("Success!", "Coupon applied successfully!", "success");
  
  const totalElement = document.querySelector(".summary-row.total span:last-child");
  if (totalElement) totalElement.innerText = Rs${data.newTotal.toFixed(2)};

  let discountRow = document.getElementById("couponDiscountRow");
  if (!discountRow) {
    discountRow = document.createElement("div");
    discountRow.id = "couponDiscountRow";
    discountRow.classList.add("summary-row");
    discountRow.innerHTML = `
      <span class="summary-label">Coupon Discount</span>
      <span class="summary-value discount">-Rs ${data.discount.toFixed(2)}</span>`;
    
    const totalRow = document.querySelector(".summary-row.total");
    totalRow.parentNode.insertBefore(discountRow, totalRow);
  } else {
    discountRow.style.display = "block";
  }

  // Update Apply button
  const applyBtn = document.querySelector('#applyCouponBtn');
  applyBtn.innerHTML = '✔ Applied';
  applyBtn.disabled = true;
  applyBtn.style.background = "#C3E6CB";
  applyBtn.style.color = "#155724";

  // Show Remove button
  const removeBtn = document.getElementById("removeCouponBtn");
  if (removeBtn) removeBtn.style.display = "block";
}

/* ---------- Remove Coupon ---------- */

async function removeCoupon() {
  const response = await fetch('/removeCoupon', {
    method: 'POST',
    headers: { "Content-Type": "application/json" },
    credentials: "include"
  });

  const data = await response.json();

  if (!data.success) return swal("Error!", data.message, "error");

  swal("Removed!", "Coupon removed", "success");

  const discountRow = document.querySelector("#couponDiscountRow");
  if (discountRow) discountRow.style.display = "none";

  const applyBtn = document.querySelector('#applyCouponBtn');
  applyBtn.innerHTML = 'Apply Coupon';
  applyBtn.disabled = false;
  applyBtn.style.background = "";
  applyBtn.style.color = "";

  const removeBtn = document.getElementById("removeCouponBtn");
  if (removeBtn) removeBtn.style.display = "none";
}

/* ---------- Verify Razorpay Payment ---------- */

async function verifyPayment(paymentResponse, orderId) {
  const res = await fetch("/verify-payment", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ paymentResponse, orderId })
  });

  const data = await res.json();

  if (data.success) {
    swal("Payment Successful!", "Redirecting...", "success");
    setTimeout(() => window.location.href = /ordersuccess?orderId=${orderId}, 1500);
  } else {
    swal("Payment Failed!", "Try again.", "error");
  }
}
</script>


</body>
</html>