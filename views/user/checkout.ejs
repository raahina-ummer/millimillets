<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | MilliMillet</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        * {
            font-family: 'Nunito Sans', sans-serif;
        }

        body {
            background-color: #f8f9fa;
            /* light neutral */
        }

        .checkout-wrapper {
            background-color: #f8f9fa;
            padding: 40px 0;
        }


        .page-title {
            color: #8B7355;
            font-weight: 800;
            font-size: 2.5rem;
            margin-bottom: 40px;
            text-transform: uppercase;
            letter-spacing: 2px;
            position: relative;
            padding-bottom: 20px;
        }

        .page-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, #8B7355, transparent);
        }

        .checkout-container {
            display: grid;
            grid-template-columns: 1fr 420px;
            gap: 35px;
            margin-top: 25px;
        }

        /* Section Cards */
        .section-header {
            background: #ffffff;
            padding: 18px 24px;
            border-bottom: 1px solid #e5e7eb;
        }

        .section-header h3 {
            color: #111827;
            font-size: 1.1rem;
        }


        .checkout-section:hover {
            box-shadow: 0 6px 35px rgba(139, 115, 85, 0.12);
        }

        .section-header {
            background: linear-gradient(135deg, #f9f6f1 0%, #E8DCC4 100%);
            padding: 24px 30px;
            border-bottom: 1px solid rgba(139, 115, 85, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-header h3 {
            margin: 0;
            color: #8B7355;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
        }

        .section-header i {
            font-size: 1.4rem;
            opacity: 0.9;
        }

        .section-content {
            padding: 30px;
        }

        /* Address Cards */
        .address-card {
            border: 2px solid #d4c5b0;
            border-radius: 14px;
            padding: 22px;
            margin-bottom: 18px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            background: #fafaf8;
        }

        .address-card:hover {
            border-color: #8B7355;
            box-shadow: 0 4px 20px rgba(139, 115, 85, 0.12);
            transform: translateY(-3px);
            background: white;
        }

        .address-card.selected {
            border-color: #8B7355;
            background: white;
            box-shadow: 0 6px 25px rgba(139, 115, 85, 0.15);
        }

        .address-card.selected::before {
            content: '✓';
            position: absolute;
            top: 18px;
            right: 18px;
            background: linear-gradient(135deg, #8B7355, #755e45);
            color: white;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: bold;
            box-shadow: 0 3px 12px rgba(139, 115, 85, 0.3);
        }

        .address-info h4 {
            margin: 0 0 12px;
            color: #333;
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: 0.3px;
        }

        .address-info p {
            margin: 0 0 8px;
            color: #666;
            line-height: 1.7;
            font-size: 0.95rem;
        }

        .address-info p:first-of-type {
            color: #755e45;
            font-weight: 600;
        }

        .address-actions {
            display: flex;
            gap: 12px;
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid #E8DCC4;
        }

        .add-address-card {
            border: 2px dashed #d4c5b0;
            border-radius: 14px;
            padding: 45px 30px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            color: #8B7355;
            background: #fafaf8;
        }

        .add-address-card:hover {
            border-color: #8B7355;
            background: white;
            transform: translateY(-3px);
            box-shadow: 0 4px 20px rgba(139, 115, 85, 0.12);
        }

        .add-address-card i {
            font-size: 2.8rem;
            margin-bottom: 16px;
            display: block;
            color: #8B7355;
            opacity: 0.9;
        }

        .add-address-card h4 {
            color: #8B7355;
            font-weight: 700;
            margin-bottom: 8px;
            font-size: 1.1rem;
            letter-spacing: 0.3px;
        }

        .add-address-card p {
            color: #755e45;
            margin: 0;
            font-size: 0.95rem;
        }

        /* Payment Methods */
       

        .payment-method:hover {
            border-color: #8B7355;
            transform: translateY(-3px);
            box-shadow: 0 4px 20px rgba(139, 115, 85, 0.12);
            background: white;
        }

       
        .payment-icon {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, #E8DCC4, #f0eae0);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8B7355;
            font-size: 1.6rem;
            flex-shrink: 0;
            transition: all 0.3s ease;
        }

        .payment-method.selected .payment-icon {
            background: linear-gradient(135deg, #8B7355, #755e45);
            color: white;
            box-shadow: 0 4px 15px rgba(139, 115, 85, 0.2);
        }

        .payment-info h4 {
            margin: 0 0 5px;
            color: #333;
            font-weight: 700;
            font-size: 1.05rem;
            letter-spacing: 0.3px;
        }

        .payment-info p {
            margin: 0;
            color: #666;
            font-size: 0.92rem;
            line-height: 1.4;
        }

        /* Order Items */
        .checkout-item {
            display: flex;
            gap: 22px;
            padding: 22px;
            background: #fafaf8;
            border-radius: 14px;
            margin-bottom: 16px;
            border: 1px solid #f0eae0;
            transition: all 0.3s ease;
        }

        .checkout-item:hover {
            background: white;
            border-color: #d4c5b0;
            box-shadow: 0 2px 12px rgba(139, 115, 85, 0.08);
        }

        .checkout-item:last-child {
            margin-bottom: 0;
        }

        .item-image {
            width: 100px;
            height: 100px;
            border-radius: 12px;
            overflow: hidden;
            flex-shrink: 0;
            border: 2px solid #d4c5b0;
            background: #f9f6f1;
        }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .item-details {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .item-name {
            font-weight: 700;
            color: #333;
            margin: 0 0 10px;
            font-size: 1.1rem;
            letter-spacing: 0.3px;
        }

        .item-quantity {
            color: #755e45;
            font-size: 0.95rem;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .item-price {
            color: #8B7355;
            font-weight: 800;
            font-size: 1.3rem;
            letter-spacing: 0.3px;
        }

        /* Order Summary Sidebar */
        .order-summary {
            background: #ffffff;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
            padding: 24px;
            position: sticky;
            top: 20px;
        }

        .summary-title {
            font-size: 1.25rem;
            color: #111827;
            text-transform: none;
            letter-spacing: 0;
        }



        .summary-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 40px;
            height: 2px;
            background: #8B7355;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 16px;
            padding-bottom: 14px;
            border-bottom: 1px solid #f0eae0;
            align-items: center;
        }

        .summary-row:last-of-type {
            border-bottom: none;
        }

        .summary-row.total {
            border-top: 2px solid #8B7355;
            padding-top: 22px;
            margin-top: 22px;
            font-size: 1.35rem;
            font-weight: 800;
            color: #8B7355;
            letter-spacing: 0.5px;
        }

        .summary-label {
            color: #755e45;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .summary-value {
            color: #333;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .summary-value.discount {
            color: #28a745;
            font-weight: 800;
        }

        .summary-value.free {
            color: #28a745;
            font-weight: 700;
        }

        /* Place Order Button */
       .place-order-btn {
    width: 100%;
    background: #2563eb;
    color: white;
    border: none;
    padding: 14px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    margin-top: 20px;
}

.place-order-btn:hover {
    background: #1d4ed8;
}


        .place-order-btn:hover:not(:disabled) {
            background: linear-gradient(135deg, #755e45, #6b5139);
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(139, 115, 85, 0.3);
        }

        .place-order-btn:disabled {
            background: linear-gradient(135deg, #d4c5b0, #c9baaa);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .place-order-btn i {
            font-size: 1.1rem;
        }

        #applyCouponBtn {
    background: #ffffff;
    color: #2563eb;
    border: 1px dashed #2563eb;
}


        /* Security Info */
        .security-info {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #755e45;
            font-size: 0.92rem;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #f0eae0;
            line-height: 1.6;
        }

        .security-info i {
            color: #28a745;
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        /* Buttons */
        .btn-custom {
            padding: 9px 18px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-primary-custom {
            background: #8B7355;
            color: white;
            border: 2px solid #8B7355;
            box-shadow: 0 2px 8px rgba(139, 115, 85, 0.15);
        }

        .btn-primary-custom:hover {
            background: #755e45;
            border-color: #755e45;
            box-shadow: 0 4px 12px rgba(139, 115, 85, 0.25);
            transform: translateY(-1px);
        }

        .btn-outline-custom {
            background: white;
            color: #8B7355;
            border: 2px solid #8B7355;
        }

        .btn-outline-custom:hover {
            background: #8B7355;
            color: white;
            box-shadow: 0 4px 12px rgba(139, 115, 85, 0.25);
            transform: translateY(-1px);
        }

        .btn-danger-custom {
            background: white;
            color: #dc3545;
            border: 2px solid #dc3545;
        }

        .btn-danger-custom:hover {
            background: #dc3545;
            color: white;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.25);
            transform: translateY(-1px);
        }

        .btn-add-new {
            background: white;
            color: #8B7355;
            border: 2px solid #8B7355;
            padding: 11px 22px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            letter-spacing: 0.3px;
            box-shadow: 0 2px 8px rgba(139, 115, 85, 0.1);
        }

        .btn-add-new:hover {
            background: #8B7355;
            color: white;
            box-shadow: 0 4px 12px rgba(139, 115, 85, 0.25);
            transform: translateY(-1px);
        }

        .breadcrumb {
            background: transparent !important;
            padding: 0 !important;
            margin-bottom: 35px !important;
        }

        .breadcrumb-item a {
            color: #8B7355 !important;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

        .breadcrumb-item a:hover {
            color: #755e45 !important;
        }

        .breadcrumb-item.active {
            color: #755e45 !important;
            font-weight: 600;
        }

        .breadcrumb-item+.breadcrumb-item::before {
            color: #8B7355;
            opacity: 0.5;
        }


        .payment-section {
    margin-top: 25px;
}

.payment-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: #111827;
}

.payment-method {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    cursor: pointer;
    margin-bottom: 10px;
    background: #fff;
}

.payment-method i {
    color: #6b7280;
}

.payment-method.selected {
    border-color: #2563eb;
    background: #eff6ff;
}

.payment-method.selected i {
    color: #2563eb;
}


        /* Responsive Design */
        @media (max-width: 1024px) {
            .checkout-container {
                grid-template-columns: 1fr;
            }

            .order-summary {
                position: static;
                order: -1;
            }
        }

        @media (max-width: 768px) {
            .page-title {
                font-size: 2rem;
                margin-bottom: 30px;
            }

            .checkout-item {
                flex-direction: column;
                text-align: center;
            }

            .item-image {
                margin: 0 auto;
            }

            .address-actions {
                flex-direction: column;
            }

            .btn-custom {
                width: 100%;
                justify-content: center;
            }

            .section-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .btn-add-new {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/user/header.ejs') %>

        <div class="checkout-wrapper">
            <div class="container">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item"><a href="/cart">Cart</a></li>
                        <li class="breadcrumb-item active">Checkout</li>
                    </ol>
                </nav>

                <h1 class="page-title">Checkout</h1>

                <div class="checkout-container">
                    <!-- Left Column -->
                    <div>
                        <!-- Shipping Address Section -->
                        <div class="checkout-section">
                            <div class="section-header">
                                <h3><i class="fas fa-map-marker-alt"></i> Shipping Address</h3>
                                <a href="/addAddress?redirect=checkout" class="btn-add-new">
                                    <i class="fas fa-plus"></i> Add New
                                </a>
                            </div>
                            <div class="section-content">
                                <% if (addresses && addresses.length> 0) { %>
                                    <% addresses.forEach((address)=> { %>
                                        <div class="address-card <%= address.isDefault ? 'selected' : '' %>"
                                            onclick="selectAddress('<%= address._id %>')"
                                            data-address-id="<%= address._id %>">
                                            <div class="address-info">
                                                <h4>
                                                    <%= address.firstName %>
                                                        <%= address.lastName %>
                                                            <span
                                                                style="font-size: 0.85rem; color: #8B7355; font-weight: 600;">
                                                                (<%= address.addressType.charAt(0).toUpperCase() +
                                                                    address.addressType.slice(1) %>)
                                                            </span>
                                                </h4>
                                                <p><strong>Phone:</strong>
                                                    <%= address.phone %>
                                                </p>
                                                <p>
                                                    <%= address.address %>
                                                </p>
                                                <p>
                                                    <%= address.state %>, <%= address.pinCode %>
                                                </p>
                                                <p>
                                                    <%= address.country %>
                                                </p>
                                            </div>
                                            <div class="address-actions">
                                                <button class="btn-custom btn-outline-custom"
                                                    onclick="editAddress('<%= address._id %>', event)">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>
                                                <button class="btn-custom btn-danger-custom"
                                                    onclick="deleteAddress('<%= address._id %>', event)">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </div>
                                        </div>
                                        <% }); %>
                                            <% } %>

                                                <!-- Add New Address Card -->
                                                <div class="add-address-card" onclick="openAddressModal()">
                                                    <i class="fas fa-plus-circle"></i>
                                                    <h4>Add New Address</h4>
                                                    <p>Add a new shipping address for delivery</p>
                                                </div>
                            </div>
                        </div>

                      
                        <!-- Order Items Section -->
                        <div class="checkout-section">
                            <div class="section-header">
                                <h3><i class="fas fa-shopping-bag"></i> Order Items (<%= itemCount %> items)</h3>
                            </div>
                            <div class="section-content">
                                <% cart.products.forEach((product)=> { %>
                                    <div class="checkout-item">
                                        <div class="item-image">
                                            <img src="<%= product.productId && product.productId.productImage && product.productId.productImage.length > 0 
                                                    ? '/uploads/images/' + product.productId.productImage[0] 
                                                    : '/placeholder.jpg' %>"
                                                alt="<%= product.productId ? product.productId.productName : 'No image' %>">
                                        </div>
                                        <div class="item-details">
                                            <h4 class="item-name">
                                                <%= product.productId ? product.productId.productName : 'Unknown' %>
                                            </h4>
                                            <div class="item-variant">
  <small><%= product.variantName %></small>
</div>

                                            <div class="item-quantity">Quantity: <%= product.quantity %>
                                            </div>
                                          <div class="item-price">
  ₹<%= (product.price * product.quantity).toFixed(2) %>
</div>


                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column - Order Summary -->
                    <div class="order-summary">
                        <h3 class="summary-title">Order Summary</h3>

                        <!-- Subtotal (MRP) -->
                        <div class="summary-row">
                            <span class="summary-label">
                                Subtotal (MRP) (<%= itemCount %> items)
                            </span>
                            <span class="summary-value">
                                ₹<%= subtotal.toFixed(2) %>
                            </span>
                        </div>

                        <!-- Product Discount -->
                        <% if (discount && discount> 0) { %>
                            <div class="summary-row">
                                <span class="summary-label">Product Discount</span>
                                <span class="summary-value discount">
                                    -₹<%= discount.toFixed(2) %>
                                </span>
                            </div>
                            <% } %>

                                <!-- Sale Total -->
                                <div class="summary-row">
                                    <span class="summary-label"><strong>Sale Total</strong></span>
                                    <span class="summary-value">
                                        ₹<%= saletotal.toFixed(2) %>
                                    </span>
                                </div>

                                <!-- Apply / Remove Coupon -->
                                <div style="margin-bottom:15px; margin-top:15px;">
                                    <% if (!appliedCoupon) { %>
                                        <button id="applyCouponBtn" class="place-order-btn"
                                            style="background:#f9f6f1; color:#8B7355; border:2px solid #8B7355; width:100%;"
                                            onclick="openCouponModal()">
                                            <i class="fas fa-ticket-alt"></i> Apply Coupon
                                        </button>
                                        <% } else { %>
                                            <div class="applied-coupon-box">
                                                <div>
                                                   <div class="applied-coupon-box" style="
  background:#f0f7f2;
  border:1px dashed #2e7d32;
  padding:12px;
  border-radius:6px;
">
  <div style="color:#2e7d32; font-weight:600;">
    <i class="fas fa-check-circle"></i>
    Coupon Applied:
    <span class="coupon-code"><%= appliedCoupon %></span>
  </div>

                                                </div>
                                                <!-- <button id="removeCouponBtn" class="place-order-btn"
                                                    style="background:#dc3545; color:white; width:100%; margin-top:10px;"
                                                    onclick="removeCoupon()">
                                                    <i class="fas fa-times"></i> Remove Coupon
                                                </button> -->
                                            </div>
                                            <% } %>


                                                <button id="removeCouponBtn" class="place-order-btn"
                                                    style="display:none; background:#dc3545; color:white; width:100%; margin-top:10px;"
                                                    onclick="removeCoupon()">
                                                    <i class="fas fa-times"></i> Remove Coupon
                                                </button>
                                </div>

                                <!-- Coupon Discount -->
                                <% if (couponDiscount && couponDiscount> 0) { %>
                                    <div class="summary-row">
                                        <span class="summary-label">Coupon Discount</span>
                                        <span class="summary-value discount">
                                            -₹<%= couponDiscount.toFixed(2) %>
                                        </span>
                                    </div>
                                    <% } %>

                                        <!-- Delivery Fee -->
                                        <div class="summary-row">
                                            <span class="summary-label">Delivery Fee</span>
                                            <span class="summary-value">
                                                <% if (shipping===0) { %>
                                                    <span style="color:#28a745; font-weight:700;">FREE</span>
                                                    <% } else { %>
                                                        ₹<%= shipping.toFixed(2) %>
                                                            <% } %>
                                            </span>
                                        </div>

                                        <hr class="summary-divider">

                                        <!-- Total Amount -->
                                        <div class="summary-row total">
                                            <span>Total Amount</span>
                                            <span>₹<%= total.toFixed(2) %></span>
                                        </div>

                                        <!-- PAYMENT OPTIONS -->
                                        <div class="payment-section">
                                            <h4 class="payment-title">Choose Payment Method</h4>

                                            <div class="payment-method selected" onclick="selectPayment('cod')"
                                                data-payment="cod">
                                                <i class="fas fa-money-bill-wave"></i>
                                                <span>Cash on Delivery</span>
                                            </div>

                                            <div class="payment-method" onclick="selectPayment('razorpay')"
                                                data-payment="razorpay">
                                                <i class="fas fa-credit-card"></i>
                                                <span>Online Payment</span>
                                            </div>

                                            <div class="payment-method" onclick="selectPayment('wallet')"
                                                data-payment="wallet">
                                                <i class="fas fa-wallet"></i>
                                                <span>Wallet (₹<%= walletBalance.toFixed(2) %>)</span>
                                            </div>
                                        </div>

                                        <!-- PLACE ORDER BUTTON -->
                                        <button class="place-order-btn" id="placeOrderBtn">
                                            Place Order
                                        </button>

                                        <!-- Security Info -->
                                        <div class="security-info">
                                            <i class="fas fa-shield-alt"></i>
                                            <span>Your payment information is secure and encrypted</span>
                                        </div>
                    </div>
                </div>

                    <%- include('../partials/user/footer.ejs') %>

                        <script>
                            let selectedAddressId = '<%= addresses.find(addr => addr.isDefault)?._id || (addresses.length > 0 ? addresses[0]._id : "") %>';
                            let selectedPaymentMethod = 'cod';

                            function selectAddress(addressId) {
                                document.querySelectorAll('.address-card').forEach(card => card.classList.remove('selected'));
                                const selectedCard = document.querySelector(`[data-address-id="${addressId}"]`);
                                if (selectedCard) selectedCard.classList.add('selected');
                                selectedAddressId = addressId;
                            }
function selectPayment(paymentMethod) {
  document.querySelectorAll('.payment-method')
    .forEach(method => method.classList.remove('selected'));

  const selected = document.querySelector(`[data-payment="${paymentMethod}"]`);
  if (selected) selected.classList.add('selected');

  selectedPaymentMethod = paymentMethod;

  const btn = document.getElementById('placeOrderBtn');
  if (!btn) return;

  switch (paymentMethod) {
    case 'cod':
      btn.innerText = 'Place Order (COD)';
      break;
    case 'razorpay':
      btn.innerText = 'Pay Securely';
      break;
    case 'wallet':
      btn.innerText = 'Pay with Wallet';
      break;
    default:
      btn.innerText = 'Place Order';
  }
}



async function placeOrderHandler() {
  if (!selectedAddressId) {
    return swal("Error!", "Please select a shipping address", "error");
  }

  if (selectedPaymentMethod === "cod") {
    placeCODOrder();
  } 
  else if (selectedPaymentMethod === "razorpay") {
    initiateRazorpayPayment();
  } 
  else if (selectedPaymentMethod === "wallet") {
    initiateWalletPayment();
  }
}


                            function openAddressModal() {
                                window.location.href = "/addAddress?redirect=checkout";
                            }

                            async function editAddress(addressId, event) {
                                event.stopPropagation();
                                window.location.href = `/editAddress/${addressId}?redirect=checkout`;
                            }

                            async function deleteAddress(addressId, event) {
                                event.stopPropagation();
                                const result = await swal({
                                    title: "Delete Address?",
                                    text: "This address will be permanently deleted.",
                                    icon: "warning",
                                    buttons: { cancel: "Cancel", confirm: { text: "Delete", value: true } },
                                    dangerMode: true
                                });

                                if (result) {
                                    const response = await fetch(`/deleteAddress/${addressId}`, { method: 'DELETE' });
                                    const data = await response.json();

                                    if (data.success) {
                                        swal("Deleted!", "Address deleted successfully.", "success").then(() => location.reload());
                                    } else {
                                        swal("Error!", data.message, "error");
                                    }
                                }
                            }

                            /* ========== COD Place Order ========== */
                            async function placeCODOrder() {
                                if (!selectedAddressId) {
                                    return swal("Error!", "Please select a shipping address", "error");
                                }

                                const btn = document.getElementById('placeOrderBtn');
                                const originalHTML = btn.innerHTML;
                                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
                                btn.disabled = true;

                                try {
                                    // For COD, directly place order (payment on delivery)
                                    const response = await fetch('/placeOrder', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                            addressId: selectedAddressId,
                                            paymentMethod: 'cod'
                                        })
                                    });

                                    const data = await response.json();

                                    if (data.success) {
                                        window.location.href = `/ordersuccess?orderId=${data.orderId}`;
                                    }
                                    else {
                                        swal("Error!", data.message, "error");
                                        btn.innerHTML = originalHTML;
                                        btn.disabled = false;
                                    }
                                } catch (error) {
                                    console.error("COD Order Error:", error);
                                    swal("Error!", "Something went wrong. Please try again.", "error");
                                    btn.innerHTML = originalHTML;
                                    btn.disabled = false;
                                }
                            }

                            /* ========== Razorpay Payment Flow ========== */
                            async function initiateRazorpayPayment() {
                                if (!selectedAddressId) {
                                    return swal("Error!", "Please select a shipping address", "error");
                                }

                                const btn = document.getElementById('placeOrderBtn');

                                const originalHTML = btn.innerHTML;
                                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
                                btn.disabled = true;

                                try {
                                    // Step 1: Create order in DB + Razorpay order
                                    const orderResponse = await fetch("/create-order", {
                                        method: "POST",
                                        headers: { "Content-Type": "application/json" },
                                        body: JSON.stringify({ addressId: selectedAddressId })
                                    });

                                    if (!orderResponse.ok) {
                                        throw new Error(`Server error: ${orderResponse.status}`);
                                    }

                                    const orderData = await orderResponse.json();

                                    if (!orderData.success) {
                                        swal("Error!", orderData.message || "Failed to create order", "error");
                                        btn.innerHTML = originalHTML;
                                        btn.disabled = false;
                                        return;
                                    }

                                    console.log("✅ Order Created:", orderData.orderId);
                                    console.log("✅ Razorpay Order:", orderData.order.id);

                                    // Step 2: Configure Razorpay options
                                    const options = {
                                        key: orderData.key,
                                        amount: orderData.order.amount,
                                        currency: "INR",
                                        name: "Milli Millet Ecommerce",
                                        description: "Complete your purchase",
                                        order_id: orderData.order.id,

                                        // ✅ SUCCESS HANDLER - Payment succeeded
                                        handler: async function (response) {
                                            console.log("🔥 Razorpay handler called");
                                            console.log("Payment response:", response);

                                            try {
                                                console.log("✅ Payment Success Response:", response);

                                                // Verify payment on backend
                                                let verifyRes = await fetch("/verify-payment", {
                                                    method: "POST",
                                                    headers: { "Content-Type": "application/json" },
                                                    credentials: "include",
                                                    body: JSON.stringify({
                                                        paymentResponse: response,
                                                        addressId: selectedAddressId,
                                                        orderId: orderData.orderId,
                                                    })
                                                });

                                                if (!verifyRes.ok) {
                                                    throw new Error(`Verification error: ${verifyRes.status}`);
                                                }

                                                const verifyData = await verifyRes.json();

                                                if (verifyData.success) {
                                                    // ✅ Payment verified successfully
                                                    swal("Success!", "Payment successful!", "success");
                                                    setTimeout(() => {
                                                        window.location.href = `/ordersuccess?orderId=${verifyData.orderId}`;
                                                    }, 1000);
                                                } else {
                                                    // ❌ Payment succeeded but verification failed
                                                    swal("Payment Verification Failed", verifyData.message || "Please contact support", "error");
                                                    setTimeout(() => {
                                                        window.location.href = `/orderFailure?orderId=${verifyData.orderId || orderData.orderId}`;
                                                    }, 1500);
                                                }

                                            } catch (error) {
                                                console.error("Verification error:", error);
                                                swal("Error!", "Payment verification failed. Please contact support.", "error");
                                                setTimeout(() => {
                                                    window.location.href = `/orderFailure?orderId=${orderData.orderId}`;
                                                }, 1500);
                                            }
                                        },

                                        // ✅ PAYMENT FAILED - Red box clicked in Razorpay
                                        // Order already exists in DB, just redirect to failure page
                                        modal: {
                                            ondismiss: function () {
                                                swal("Payment Cancelled", "Order placed but payment was cancelled", "warning");
                                                setTimeout(() => {
                                                    // ✅ Order already exists, redirect to failure page
                                                    window.location.href = `/orderFailure?orderId=${orderData.orderId}`;
                                                }, 1000);
                                            }
                                        },

                                        theme: { color: "#3399cc" }
                                    };

                                    // Create Razorpay instance
                                    const rzp = new Razorpay(options);

                                    // ✅ PAYMENT FAILED EVENT - Red box in Razorpay
                                    rzp.on("payment.failed", function (response) {
                                        console.error("❌ Payment failed:", response.error);

                                        swal("Payment Failed", response.error.description || "Payment could not be processed", "error");
                                        setTimeout(() => {
                                            // ✅ Order already exists in DB, just redirect
                                            window.location.href = `/orderFailure?orderId=${orderData.orderId}`;
                                        }, 1500);
                                    });

                                    // Open Razorpay modal
                                    rzp.open();

                                    // Re-enable button
                                    btn.innerHTML = originalHTML;
                                    btn.disabled = false;

                                } catch (error) {
                                    console.error("Razorpay initiation error:", error);
                                    swal("Error!", error.message || "Something went wrong. Please try again.", "error");
                                    btn.innerHTML = originalHTML;
                                    btn.disabled = false;
                                }
                            }




                            /* ========== Wallet Payment Flow ========== */
                            async function initiateWalletPayment() {
                                if (!selectedAddressId) {
                                    return swal("Error!", "Please select a shipping address", "error");
                                }

                                // ✅ Get values from EJS
                                const walletBalance = parseFloat('<%= walletBalance %>') || 0;
                                const totalAmount = parseFloat('<%= total %>') || 0;

                                // Check sufficient balance
                                if (walletBalance < totalAmount) {
                                    return swal({
                                        title: "Insufficient Balance!",
                                        text: `Your wallet balance: ₹${walletBalance.toFixed(2)}\nOrder total: ₹${totalAmount.toFixed(2)}\nShortfall: ₹${(totalAmount - walletBalance).toFixed(2)}`,
                                        icon: "error",
                                        buttons: {
                                            cancel: "Cancel",
                                            addMoney: {
                                                text: "Add Money to Wallet",
                                                value: "add"
                                            }
                                        }
                                    }).then((value) => {
                                        if (value === "add") {
                                            window.location.href = '/wallet';
                                        }
                                    });
                                }

                                const btn = document.getElementById('placeOrderBtn');

                                const originalHTML = btn.innerHTML;
                                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
                                btn.disabled = true;

                                try {
                                    const response = await fetch('/walletPayment', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({
                                            addressId: selectedAddressId,
                                            paymentMethod: 'wallet'
                                        })
                                    });

                                    const data = await response.json();

                                    if (data.success) {
                                        swal({
                                            title: "Success!",
                                            text: `Order placed successfully!\nAmount paid: ₹${data.walletUsed}\nNew wallet balance: ₹${data.newWalletBalance}`,
                                            icon: "success",
                                            button: "View Order"
                                        }).then(() => {
                                            window.location.href = `/ordersuccess?orderId=${data.orderId}`;
                                        });
                                    } else {
                                        swal("Error!", data.message, "error");
                                        btn.innerHTML = originalHTML;
                                        btn.disabled = false;
                                    }
                                } catch (error) {
                                    console.error("Wallet Payment Error:", error);
                                    swal("Error!", "Something went wrong. Please try again.", "error");
                                    btn.innerHTML = originalHTML;
                                    btn.disabled = false;
                                }
                            }
                            /* ========== Coupon Functions ========== */
                            function openCouponModal() {
                                swal({
                                    title: "Apply Coupon",
                                    content: {
                                        element: "input",
                                        attributes: { placeholder: "Enter coupon code", type: "text" }
                                    },
                                    buttons: { cancel: "Cancel", confirm: { text: "Apply", value: "apply" } }
                                }).then(value => {
                                    if (value) applyCoupon(value);
                                });
                            }

                       async function applyCoupon(couponCode) {
  const response = await fetch('/applyCoupon', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'include',
    body: JSON.stringify({ couponCode })
  });

  const data = await response.json();

  if (!data.success) {
        if (data.reason === "MIN_PURCHASE") {
      return swal({
        title: "Coupon Not Applied",
        text: `${data.message}\n\nYour cart total: ₹${data.currentAmount}`,
        icon: "warning",
        button: "OK"
      });

    return swal("Invalid!", data.message, "error");
  }

  swal("Success!", "Coupon applied successfully!", "success")
    .then(() => location.reload());
}

                           async function removeCoupon() {
  const response = await fetch('/removeCoupon', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    credentials: 'include'
  });

  const data = await response.json();

  if (!data.success) {
    return swal("Error!", data.message, "error");
  }

  swal("Removed!", "Coupon removed", "success")
    .then(() => location.reload());
}


                            /* ========== Event Listeners ========== */
                           document.addEventListener('DOMContentLoaded', function () {
  const placeOrderBtn = document.getElementById('placeOrderBtn');

  if (placeOrderBtn) {
    placeOrderBtn.addEventListener('click', placeOrderHandler);
  }
});

                                




                        </script>


