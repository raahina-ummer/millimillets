<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification - MilliMillet</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary-brown: #8B6F47;
            --bg-beige: #E8DCC4;
            --text-dark: #3C3C3C;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #ffffff;
        }

        /* Top Banner */
        .top-banner {
            background-color: var(--bg-beige);
            padding: 12px 0;
            text-align: center;
            font-size: 14px;
            color: var(--text-dark);
            position: relative;
        }

        .top-banner a {
            color: var(--text-dark);
            text-decoration: underline;
            font-weight: 600;
        }

        .close-banner {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            font-size: 20px;
            cursor: pointer;
            color: var(--text-dark);
        }

        /* OTP Container */
        .otp-container {
            max-width: 600px;
            margin: 80px auto;
            background-color: var(--bg-beige);
            border-radius: 8px;
            padding: 60px 40px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        /* Logo */
        .logo-section {
            text-align: center;
            margin-bottom: 40px;
        }

        .logo-icon {
            width: 60px;
            height: 60px;
            margin-bottom: 15px;
        }

        .logo-icon svg {
            width: 100%;
            height: 100%;
        }

        .brand-name {
            font-size: 32px;
            font-weight: 700;
            color: var(--primary-brown);
            letter-spacing: 2px;
        }

        /* OTP Form */
        .otp-title {
            font-size: 20px;
            font-weight: 600;
            color: var(--text-dark);
            text-align: center;
            margin-bottom: 15px;
            letter-spacing: 3px;
        }

        .otp-subtitle {
            font-size: 14px;
            color: var(--text-dark);
            text-align: center;
            margin-bottom: 30px;
        }

        .otp-inputs {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 30px;
        }

        .otp-input {
            width: 60px;
            height: 60px;
            text-align: center;
            font-size: 24px;
            font-weight: 600;
            border: 2px solid #ffffff;
            border-radius: 8px;
            background-color: #ffffff;
            color: var(--text-dark);
            transition: all 0.3s ease;
        }

        .otp-input:focus {
            outline: none;
            border-color: var(--primary-brown);
            box-shadow: 0 0 0 3px rgba(139, 111, 71, 0.1);
        }

        .otp-buttons {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 25px;
        }

        .btn-verify, .btn-resend {
            padding: 12px 35px;
            border-radius: 25px;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-verify {
            background-color: var(--primary-brown);
            color: #ffffff;
        }

        .btn-verify:hover {
            background-color: #6f5838;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(139, 111, 71, 0.3);
        }

        .btn-resend {
            background-color: transparent;
            color: var(--primary-brown);
            border: 2px solid var(--primary-brown);
        }

        .btn-resend:hover {
            background-color: var(--primary-brown);
            color: #ffffff;
        }

        .timer {
            text-align: center;
            font-size: 13px;
            color: var(--text-dark);
            margin-bottom: 15px;
        }

        .back-link {
            text-align: center;
            font-size: 13px;
        }

        .back-link a {
            color: var(--text-dark);
            text-decoration: underline;
            font-weight: 500;
        }

        /* Footer */
        .footer {
            background-color: #f8f9fa;
            padding: 60px 0 30px;
            margin-top: 100px;
        }

        .footer-logo {
            text-align: center;
            margin-bottom: 20px;
        }

        .footer-logo-icon {
            width: 40px;
            height: 40px;
            margin-bottom: 10px;
        }

        .footer-brand {
            font-size: 18px;
            font-weight: 700;
            color: var(--primary-brown);
        }

        .footer-tagline {
            font-size: 12px;
            color: #666;
            text-align: center;
            margin-bottom: 30px;
            max-width: 400px;
            margin-left: auto;
            margin-right: auto;
        }

        .footer-sections {
            display: flex;
            justify-content: space-around;
            margin-bottom: 40px;
        }

        .footer-section h6 {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .footer-section ul {
            list-style: none;
            padding: 0;
        }

        .footer-section ul li {
            margin-bottom: 8px;
        }

        .footer-section ul li a {
            color: #666;
            text-decoration: none;
            font-size: 13px;
            transition: color 0.3s;
        }

        .footer-section ul li a:hover {
            color: var(--primary-brown);
        }

        .social-icons {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 30px;
        }

        .social-icon {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background-color: #e0e0e0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-dark);
            text-decoration: none;
            transition: all 0.3s;
        }

        .social-icon:hover {
            background-color: var(--primary-brown);
            color: #ffffff;
        }

        .payment-methods {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
        }

        .payment-methods img {
            height: 25px;
        }

        .footer-copyright {
            text-align: center;
            font-size: 12px;
            color: #999;
            padding-top: 20px;
            border-top: 1px solid #e0e0e0;
        }

        @media (max-width: 768px) {
            .otp-container {
                margin: 40px 20px;
                padding: 40px 20px;
            }

            .otp-inputs {
                gap: 10px;
            }

            .otp-input {
                width: 50px;
                height: 50px;
                font-size: 20px;
            }

            .footer-sections {
                flex-direction: column;
                gap: 30px;
            }

            .footer-section {
                text-align: center;
            }
        }
    </style>
