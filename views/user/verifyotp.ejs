<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification - MilliMillet</title>

    <style>
        *{margin:0;padding:0;box-sizing:border-box;}
        body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;background-color:#f5f5f5;}
        .promo-banner{background-color:#e8dcc4;text-align:center;padding:12px;font-size:13px;color:#333;position:relative;}
        .promo-banner a{color:#333;text-decoration:underline;font-weight:600;}
        .close-banner{position:absolute;right:20px;top:50%;transform:translateY(-50%);background:none;border:none;font-size:22px;cursor:pointer;color:#666;line-height:1;}
        .main-container{max-width:1440px;margin:0 auto;background:white;}
        .header-section{background:white;padding:40px 20px 30px;text-align:center;}
        .brand-logo{width:60px;height:auto;margin-bottom:15px;}
        .brand-name{color:#8b6f47;font-size:32px;font-weight:700;letter-spacing:4px;}
        .otp-section{background:linear-gradient(180deg,#e8dcc4 0%,#d4c4a8 100%);padding:60px 40px;text-align:center;}
        .otp-title{font-size:24px;color:#333;letter-spacing:4px;margin-bottom:15px;font-weight:700;}
        .otp-subtitle{font-size:14px;color:#666;margin-bottom:40px;}
        .otp-inputs{display:flex;justify-content:center;gap:20px;margin-bottom:40px;}
        .otp-input{width:70px;height:70px;border:none;border-radius:10px;text-align:center;font-size:28px;font-weight:700;background:white;outline:none;transition:all .3s;box-shadow:0 2px 8px rgba(0,0,0,.1);}
        .otp-input:focus{box-shadow:0 4px 12px rgba(139,111,71,.3);transform:scale(1.05);}
        .button-group{display:flex;justify-content:center;gap:20px;margin-bottom:30px;}
        .btn-custom{padding:14px 50px;border:none;border-radius:30px;font-size:13px;font-weight:700;cursor:pointer;letter-spacing:2px;text-transform:uppercase;transition:all .3s;}
        .btn-verify{background-color:#6d5438;color:white;}
        .btn-verify:hover{background-color:#5a4530;transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.2);}
        .btn-resend{background-color:#8b7355;color:white;}
        .btn-resend:hover{background-color:#75614a;transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.2);}
        .timer{font-size:14px;color:#666;margin-bottom:20px;display:block;font-weight:600;}
        .timer.expired{color:#dc3545;}
        .signup-link{font-size:13px;color:#666;}
        .signup-link a{color:#333;text-decoration:underline;font-weight:600;}
        .footer-section{background:#d4c4a8;color:#fff;padding:50px 40px 30px;}
        .footer-content{display:grid;grid-template-columns:2fr 1fr 1fr 1fr 1fr;gap:40px;max-width:1200px;margin:0 auto 40px;}
        .footer-brand-logo{width:40px;margin-bottom:15px;}
        .brand-tagline{font-size:13px;color:#aaa;line-height:1.8;margin-bottom:25px;}
        .social-links{display:flex;gap:12px;}
        .social-links a{width:35px;height:35px;border-radius:50%;background-color:#4a4a4a;display:flex;align-items:center;justify-content:center;color:white;text-decoration:none;font-size:14px;transition:all .3s;}
        .social-links a:hover{background-color:#8b6f47;transform:translateY(-3px);}
        .footer-column h4{font-size:13px;font-weight:700;margin-bottom:20px;color:#fff;letter-spacing:1px;text-transform:uppercase;}
        .footer-column ul{list-style:none;padding:0;}
        .footer-column ul li{margin-bottom:12px;}
        .footer-column ul li a{color:#aaa;text-decoration:none;font-size:13px;transition:color .3s;}
        .footer-column ul li a:hover{color:#8b6f47;}
        .footer-bottom{padding-top:30px;border-top:1px solid #4a4a4a;display:flex;justify-content:space-between;align-items:center;max-width:1200px;margin:0 auto;}
        .copyright{font-size:12px;color:#999;}
        .payment-methods{display:flex;gap:15px;align-items:center;}
        @media (max-width:768px){.footer-content{grid-template-columns:1fr}.otp-inputs{gap:12px}.otp-input{width:55px;height:55px;font-size:22px}.button-group{flex-direction:column;align-items:center}.btn-custom{width:100%;max-width:300px}.footer-bottom{flex-direction:column;gap:20px;text-align:center}}
    </style>
</head>
<body>
    <div class="promo-banner">
        Sign up and get 20% off to your first order. <a href="#">Start Up Now</a>
        <button class="close-banner" onclick="this.parentElement.style.display='none'">&times;</button>
    </div>

    <div class="main-container">
        <div class="header-section">
            <img src="/milli millets img/logo.jpg" alt="Logo" class="brand-logo" />
            <h1 class="brand-name">MILLIMILLET</h1>
        </div>

        <div class="otp-section">
            <h2 class="otp-title">ENTER YOUR OTP</h2>
            <p class="otp-subtitle">Please check your mail address for OTP</p>
            
            <form id="otpForm" novalidate>
                <div class="otp-inputs">
                    <input type="text" class="otp-input" maxlength="1" required onkeyup="moveToNext(this, 'otp2')" id="otp1"/>
                    <input type="text" class="otp-input" maxlength="1" required onkeyup="moveToNext(this, 'otp3')" id="otp2"/>
                    <input type="text" class="otp-input" maxlength="1" required onkeyup="moveToNext(this, 'otp4')" id="otp3"/>
                    <input type="text" class="otp-input" maxlength="1" required id="otp4"/>
                </div>

                <input type="hidden" id="otp" name="otp"/>

                <div class="button-group" > 
                    <button type="submit" class="btn-custom btn-verify">Verify</button>
                    <button type="button" class="btn-custom btn-resend" onclick="resendOTP()" id="resent-otp" disabled>Resend</button>
                </div>

                <span id="timerValue" class="timer">00:60</span>
                <div class="signup-link">Go back to <a href="/signup">Signup page</a></div>
            </form>
        </div>

        <div class="footer-section">
            <!-- (footer code same as yours) -->
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let timer = 60;
        let timerInterval;

        function startTimer(){
            clearInterval(timerInterval);
            timerInterval = setInterval(()=>{
                timer--;
                const minutes = Math.floor(timer/60);
                const seconds = timer % 60;
                document.getElementById("timerValue").textContent =
                    `${minutes.toString().padStart(2,'0')}:${seconds.toString().padStart(2,'0')}`;
                if(timer <= 0){
                    clearInterval(timerInterval);
                      document.getElementById("resent-otp").disabled = false;
                    document.getElementById("timerValue").classList.add("expired");
                    document.getElementById("timerValue").textContent="Expired";
                    document.querySelectorAll(".otp-input").forEach(input=>input.disabled=true);
                }
            },1000);
        }
        startTimer();

        function moveToNext(current,nextFieldID){
            if(current.value.length >= 1 && nextFieldID){
                document.getElementById(nextFieldID).focus();
            }
        }

        document.getElementById("otpForm").addEventListener("submit", validateOTPForm);

        async function validateOTPForm(e){
            e.preventDefault();
            const otp1 = document.getElementById("otp1").value;
            const otp2 = document.getElementById("otp2").value;
            const otp3 = document.getElementById("otp3").value;
            const otp4 = document.getElementById("otp4").value;
            const otpInput = otp1 + otp2 + otp3 + otp4;
            document.getElementById("otp").value = otpInput;

            try {
                
                let PATH 

                 const OTPTYPE = "<%= otpType %>";  // EJS injects value into JS variable

  switch (OTPTYPE) {
    case "CHANGE_EMAIL":
        PATH = "/verifyEmailOtp"
      break;
    case "SIGNUP_OTP":
      PATH = "/verifyOtp"
      break;
    case "FORGET_PASSWORD":
        console.log("ha hello from frontend")
     PATH = "/verifyForgotOtp"
      break;
    default:
      
  }



    
                const response = await fetch(PATH, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ otp: otpInput })
                });
                const data = await response.json();
                console.log(data)

                if (data.success) {
                    Swal.fire({
                        icon: "success",
                        title: "OTP verified successfully",
                        showConfirmButton: false,
                        timer: 1500,
                        position: "center",
                        toast: true,
                    }).then(() => {
                        console.log("verfy otp pafe",data)
                        window.location.href = data.redirectUrl || "/userprofile";
                    });
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Invalid OTP",
                        text: data.message || "Please try again",
                        position: "center",
                        toast: true,
                    });
                }
            } catch (error) {
                console.log(error)
                Swal.fire({
                    icon: "error",
                    title: "Invalid OTP",
                    text: "Please try again"
                });
            }
            return false;
        }

        async function resendOTP(){
            timer = 60;
            document.getElementById("resent-otp").disabled = true;
            document.getElementById("timerValue").classList.remove("expired");
            document.querySelectorAll(".otp-input").forEach(input=>{
                input.disabled = false;
                input.value = '';
            });
            document.getElementById("otp1").focus();
            startTimer();

            try {
                const response = await fetch("/resendOtp", { method: "POST" });
                const data = await response.json();
                console.log("Response Data is :",data)

                if (data.success) {
                    Swal.fire({
                        icon: "success",
                        title: "OTP Resent",
                        text: "Please check your email",
                        showConfirmButton: false,
                        timer: 2000,
                        position: "center",
                        toast: true
                    });
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "An error occurred while resending OTP. Please try again."
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: "error",
                    title: "Network Error",
                    text: "Failed to resend OTP. Please try again later."
                });
            }
            return false;
        }
    </script>
</body>
</html>
