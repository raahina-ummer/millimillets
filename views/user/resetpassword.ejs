            <div class="text-center">
                <svg class="logo" viewBox="0 0 300 80" xmlns="http://www.w3.org/2000/svg">
                    <!-- Leaf Icon -->
                    <g transform="translate(130, 10)">
                        <path class="leaf-icon" d="M15,0 C20,5 25,15 25,25 C25,35 20,40 15,40 C10,40 5,35 5,25 C5,15 10,5 15,0 Z"/>
                        <path class="leaf-icon" d="M25,0 C30,5 35,15 35,25 C35,35 30,40 25,40 C20,40 15,35 15,25 C15,15 20,5 25,0 Z"/>
                    </g>
                    <!-- Text -->
                    <text x="150" y="60" font-family="Georgia, serif" font-size="24" font-weight="bold" text-anchor="middle" fill="#6B4423" letter-spacing="2">MILLIMILLET</text>
                </svg>
