<%- include('../partials/user/header.ejs') %>
<%- include('../partials/chatbot.ejs') %>

<!-- Theme Colors: #d6c59a (light beige), #b38b4a (mid brown), #6b4f39 (dark brown), #ffffff -->
<style>
  :root{
    --beige: #d6c59a;
    --brown: #b38b4a;
    --dark: #6b4f39;
    --white: #ffffff;
  }
  body { background: #222; }
  .shop-wrapper{ background: var(--beige); padding: 40px 0; }
  .container{ max-width:1180px; margin:0 auto; }

  /* Breadcrumb */
  .shp_breadcrumb_option{ background:var(--white); padding:18px 0; }
  .shp_breadcrumb_text h4{ color:var(--dark); font-weight:700; }

  /* Sidebar */
  .sidebar{ background:transparent; }
  .shp_search .input-group{ display:flex; gap:8px; }
  .shp_search input{ padding:10px 14px; border-radius:18px; border:1px solid rgba(107,79,57,0.15); width:100%; }
  .btn-search{ background:var(--dark); color:var(--white); border:none; padding:8px 12px; border-radius:14px; }
  .btn-clear{ background:transparent; border:1px solid rgba(107,79,57,0.15); padding:8px 12px; border-radius:14px; }

  .shp_filters{ margin-top:18px; background:transparent; }
  .shp_filter_heading a{ color:var(--dark); font-weight:700; text-decoration:none; }
  .shp_filter_body{ padding:8px 0 16px; }
  .shp_filter_body ul li{ margin-bottom:8px; }
  .shp_filter_apply{ display:flex; gap:10px; }
  .shp_btn_apply, .shp_btn_reset{ padding:8px 12px; border-radius:10px; border:none; }
  .shp_btn_apply{ background:var(--dark); color:var(--white); }
  .shp_btn_reset{ background:transparent; border:1px solid rgba(107,79,57,0.15); }

  /* Product Grid */
  .shp_product_options{ background:transparent; margin-bottom:12px; }
  .shp_product_results p{ color:var(--dark); font-weight:600; }
  .shp_product_sort select{ padding:8px 12px; border-radius:12px; }

  .shp_product_cart_wrap{ background:var(--white); border-radius:12px; padding:12px; margin-bottom:18px; box-shadow:0 4px 10px rgba(0,0,0,0.05); }
  .shp_product_img img{ width:100%; height:180px; object-fit:cover; border-radius:8px; }
  .shp_label{ position:absolute; left:12px; top:12px; background:var(--brown); color:var(--white); padding:4px 8px; border-radius:8px; font-weight:700; }
  .shp_action_btn{ background:transparent; border:none; }
  .whishlist.active{ background:var(--brown); color:#fff; transform:scale(1.05); }

  .shp_product_details h6{ margin:8px 0; color:var(--dark); }
  .shp_rating i{ color:goldenrod; }
  .shp_price .regular-price{ text-decoration:line-through; color:#999; margin-right:8px; }
  .shp_price h5{ color:var(--dark); display:inline-block; }
  .shp_add_cart{ background:var(--dark); color:var(--white); padding:8px 12px; border-radius:10px; border:none; width:100%; margin-top:10px; }

  /* Pagination */
  .pagination{ display:flex; gap:8px; justify-content:center; margin:18px 0; }
  .pagination button{ padding:8px 12px; border-radius:6px; border:1px solid rgba(0,0,0,0.08); background:var(--white); }
  .pagination button.active{ background:var(--brown); color:var(--white); }

  /* disabled buttons */
  button:disabled{ background-color:#bbb; color:white; cursor:not-allowed; opacity:0.6; }

  /* Responsive tweaks */
  @media (max-width: 768px){ .shp_product_img img{ height:140px; } }
</style>

<link rel="stylesheet" href="/css/shop.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Breadcrumb -->
<section class="shp_breadcrumb_option">
  <div class="container">
    <div class="shp_breadcrumb_text">
      <h4>MILLIMILLET</h4>
      <div class="shp_breadcrumb_links"><a href="/">Home</a> &gt; <a href="/shop">Shop</a></div>
    </div>
  </div>
</section>

<!-- Shop Main -->
<section class="shop-wrapper">
  <div class="container">
    <div class="row">
      <!-- Sidebar -->
      <div class="col-lg-3 col-md-4">
        <aside class="sidebar">
          <!-- Search form (backend-driven search & clear) -->
          <div class="shp_search">
            <form action="/shop" method="GET" id="searchForm">
              <div class="input-group">
                <input type="text" name="search" id="searchInput" placeholder="Search products..." value="<%= req.query.search || '' %>" autocomplete="off" />
                <button type="submit" class="btn-search"><i class="fa fa-search"></i></button>
                <button type="button" class="btn-clear" onclick="window.location.href='/shop?page=1'">Clear</button>
              </div>

              <!-- preserve other query params when searching -->
              <% if (req.query.category) { %>
                <input type="hidden" name="category" value="<%= req.query.category %>">
              <% } %>
              <% if (req.query.brand) { %>
                <input type="hidden" name="brand" value="<%= req.query.brand %>">
              <% } %>
              <% if (req.query.price) { %>
                <input type="hidden" name="price" value="<%= req.query.price %>">
              <% } %>
              <% if (req.query.sort) { %>
                <input type="hidden" name="sort" value="<%= req.query.sort %>">
              <% } %>
              <% if (currentPage) { %>
                <input type="hidden" name="page" value="<%= currentPage %>">
              <% } %>
            </form>
          </div>

          <!-- Filters (all filters are applied server-side) -->
          <div class="shp_filters">
            <form action="/shop" method="GET" id="filterForm">
              <div class="shp_filter">
                <h5>Category</h5>
                <div class="shp_filter_body">
                  <ul>
                    <% categories.forEach(category => { %>
                      <li>
                        <label>
                          <input type="checkbox" name="category" value="<%= category._id %>" <%= req.query.category === category._id.toString() ? 'checked' : '' %> onchange="submitFilter()"> <%= category.name %>
                        </label>
                      </li>
                    <% }) %>
                  </ul>
                </div>
              </div>

              <div class="shp_filter">
                <h5>Brand</h5>
                <div class="shp_filter_body">
                  <ul>
                    <% brands.forEach(brand => { %>
                      <li>
                        <label>
                          <input type="checkbox" name="brand" value="<%= brand._id %>" <%= req.query.brand === brand._id.toString() ? 'checked' : '' %> onchange="submitFilter()"> <%= brand.brandName %>
                        </label>
                      </li>
                    <% }) %>
                  </ul>
                </div>
              </div>

              <div class="shp_filter">
                <h5>Price</h5>
                <div class="shp_filter_body">
                  <ul>
                    <% priceRanges.forEach(range => { %>
                      <li>
                        <label>
                          <input type="checkbox" name="price" value="<%= range.value %>" <%= req.query.price === range.value ? 'checked' : '' %> onchange="submitFilter()"> <%= range.label %>
                        </label>
                      </li>
                    <% }) %>
                  </ul>
                </div>
              </div>

              <!-- Hidden preserves -->
              <% if (req.query.search) { %><input type="hidden" name="search" value="<%= req.query.search %>"><% } %>
              <% if (req.query.sort) { %><input type="hidden" name="sort" value="<%= req.query.sort %>"><% } %>
              <% if (currentPage) { %><input type="hidden" name="page" value="<%= currentPage %>"><% } %>

              <div class="shp_filter_apply">
                <button type="submit" class="shp_btn_apply">Apply Filters</button>
                <button type="button" class="shp_btn_reset" onclick="window.location.href='/shop?page=1'">Reset All</button>
              </div>
            </form>
          </div>
        </aside>
      </div>

      <!-- Products -->
      <div class="col-lg-9 col-md-8">
        <div class="shp_product_options">
          <div class="row align-items-center">
            <div class="col-6">
              <div class="shp_product_results">
                <p>Showing <%= products.length > 0 ? `${(currentPage - 1) * limit + 1}–${Math.min(currentPage * limit, totalProducts)}` : '0' %> of <%= totalProducts %> results</p>
              </div>
            </div>
            <div class="col-6 text-right">
              <form action="/shop" method="GET">
                <label for="shp_sort">Sort by:</label>
                <select id="shp_sort" name="sort" onchange="this.form.submit()">
                  <option value="price-asc" <%= req.query.sort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
                  <option value="price-desc" <%= req.query.sort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
                  <option value="name-asc" <%= req.query.sort === 'name-asc' ? 'selected' : '' %>>Name: A to Z</option>
                  <option value="name-desc" <%= req.query.sort === 'name-desc' ? 'selected' : '' %>>Name: Z to A</option>
                  <option value="newest" <%= req.query.sort === 'newest' ? 'selected' : '' %>>New Arrivals</option>
                </select>

                <% if (req.query.search) { %><input type="hidden" name="search" value="<%= req.query.search %>"><% } %>
                <% if (req.query.category) { %><input type="hidden" name="category" value="<%= req.query.category %>"><% } %>
                <% if (req.query.brand) { %><input type="hidden" name="brand" value="<%= req.query.brand %>"><% } %>
                <% if (req.query.price) { %><input type="hidden" name="price" value="<%= req.query.price %>"><% } %>
                <% if (currentPage) { %><input type="hidden" name="page" value="<%= currentPage %>"><% } %>
              </form>
            </div>
          </div>
        </div>

        <!-- Product Grid -->
        <div class="row shp_product_filter">
          <% products.forEach(product => { %>
            <% if (product.isBlocked || product.status === 'unlisted') return; /* ensure blocked/unlisted hidden */ %>
            <div class="col-lg-4 col-md-6 col-sm-6">
              <div class="shp_product_cart_wrap">
                <div class="shp_product_img_action_wrap" style="position:relative;">
                  <div class="shp_product_img">
                    <a href="/product/details/<%= product._id %>" class="shp_product_img_zoom">
                      <img src="<%= product.productImage && product.productImage.length ? product.productImage[0].path : '/images/placeholder.png' %>" alt="<%= product.productName %>" class="default-img">
                    </a>
                  </div>

                  <% if (product.productOffer > 0) { %>
                    <span class="shp_label"><%= product.productOffer %>% Off</span>
                  <% } %>

                  <div class="shp_product_action_1" style="position:absolute; right:12px; top:12px; display:flex; gap:8px;">
                    <button onclick="toggleWishlist('<%= product._id %>', this)" data-product="<%= product._id %>" class="whishlist shp_action_btn" title="Add to Wishlist"><i class="fa fa-heart"></i></button>
                  </div>
                </div>

                <div class="shp_product_details">
                  <h6><a href="/product/<%= product._id %>" style="color:inherit; text-decoration:none;"><%= product.productName %></a></h6>
                  <div class="shp_rating">
                    <% for(let i = 0; i < 5; i++) { %>
                      <i class="fa fa-star<%= i < (product.rating || 0) ? '' : '-o' %>"></i>
                    <% } %>
                  </div>

                  <div class="shp_price">
                    <% if (product.regularPrice && product.salePrice && product.regularPrice > product.salePrice) { %>
                      <span class="regular-price">₹<%= product.regularPrice.toFixed(2) %></span>
                    <% } %>
                    <h5>₹<%= (product.salePrice || product.regularPrice || 0).toFixed(2) %></h5>
                  </div>

                  <div class="shp_color_select" style="margin-top:8px;">
                    <% (product.colors || []).forEach((color, index) => { %>
                      <label class="<%= color.isActive ? 'active ' + (color.class||'') : (color.class||'') %>" for="shp_color_<%= product._id %>_<%= index %>">
                        <input type="radio" id="shp_color_<%= product._id %>_<%= index %>" name="color_<%= product._id %>" value="<%= color.value %>">
                      </label>
                    <% }) %>
                  </div>

                  <button onclick="addToCart('<%= product._id %>', this)" class="shp_add_cart">Add To Cart</button>
                </div>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div class="pagination">
            <% let queryParams = []; %>
            <% if (req.query.search) { queryParams.push('search=' + encodeURIComponent(req.query.search)); } %>
            <% if (req.query.category) { queryParams.push('category=' + req.query.category); } %>
            <% if (req.query.brand) { queryParams.push('brand=' + req.query.brand); } %>
            <% if (req.query.price) { queryParams.push('price=' + req.query.price); } %>
            <% if (req.query.sort) { queryParams.push('sort=' + req.query.sort); } %>
            <% let queryString = queryParams.length > 0 ? '&' + queryParams.join('&') : ''; %>
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a href="/shop?page=<%= i %><%= queryString %>"><button class="<%= i === currentPage ? 'active' : '' %>"><%= i %></button></a>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<script>
  // submit filters (keeps other params)
  function submitFilter(){
    const form = document.getElementById('filterForm');
    form.submit();
  }

  // Wishlist toggle
  async function toggleWishlist(productId, btn){
    try{
      btn.disabled = true;
      const res = await fetch(`/wishlist/add/${productId}`, { method: 'POST', headers: {'Content-Type':'application/json'} });
      const result = await res.json();
      if(res.ok && result.success){
        btn.classList.add('active');
        Swal.fire({ icon: 'success', title: 'Wishlist', text: result.message || 'Added to wishlist', timer:1200, showConfirmButton:false });
      } else {
        Swal.fire({ icon: 'error', title: 'Oops', text: result.message || 'Could not add', confirmButtonText:'OK' });
      }
    }catch(err){ console.error(err); Swal.fire({ icon:'error', title:'Error', text:'Something went wrong' }); }
    finally{ btn.disabled = false; }
  }

  // Update cart UI
  function updateCart(newCount){ const cartCount = document.getElementById('cartCount'); if(cartCount) cartCount.textContent = newCount; }

  // Add to cart
  async function addToCart(productId, btn){
    try{
      btn.disabled = true; btn.textContent = 'Adding...';
      const res = await fetch(`/cart/add/${productId}`, { method:'POST', headers:{'Content-Type':'application/json'} });
      const result = await res.json();
      if(res.ok && result.success){ updateCart(result.cartCount); Swal.fire({ icon:'success', title:'Added', text: result.message || 'Product added to cart', timer:1200, showConfirmButton:false }).then(()=>{ btn.disabled=false; btn.textContent='Add To Cart'; }); }
      else{ Swal.fire({ icon:'error', title:'Error', text: result.message || 'Failed to add to cart' }).then(()=>{ btn.disabled=false; btn.textContent='Add To Cart'; }); }
    }catch(err){ console.error(err); Swal.fire({ icon:'error', title:'Error', text:'Something went wrong' }).then(()=>{ btn.disabled=false; btn.textContent='Add To Cart'; }); }
  }
</script>

<%- include('../partials/user/footer.ejs') %>