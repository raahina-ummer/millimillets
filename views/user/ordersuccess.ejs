<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Successful | Irowz Elite</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <%- include("../partials/user/header.ejs") %>
    
    <style>
        :root {
            --primary-gold: #b4883e;
            --dark-gold: #8e6b2f;
            --success-green: #28a745;
            --light-green: #20c997;
            --warning-orange: #ffc107;
            --light-bg: #f8f9fa;
            --text-dark: #333;
            --text-muted: #666;
        }
        
        body {
            font-family: 'Nunito Sans', sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 0;
        }
        
        /* Success Container */
        .success-wrapper {
            min-height: 100vh;
            padding: 60px 0;
            background: linear-gradient(135deg, #fef9f0 0%, #f5f0e8 100%);
        }
        
        .success-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Header Card */
        .brand-header {
            background: linear-gradient(135deg, var(--primary-gold), var(--dark-gold));
            padding: 25px 30px;
            border-radius: 12px 12px 0 0;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        .brand-logo {
            color: white;
            font-size: 1.5rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        
        .view-order-btn {
            background: rgba(255,255,255,0.2);
            color: white;
            border: 2px solid white;
            padding: 10px 25px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            margin-top: 15px;
            transition: all 0.3s ease;
        }
        
        .view-order-btn:hover {
            background: white;
            color: var(--primary-gold);
            text-decoration: none;
        }
        
        /* Success Content Card */
        .success-content {
            background: white;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            padding: 50px 40px;
            text-align: center;
            margin-bottom: 30px;
        }
        
        /* Success Animation */
        .success-icon-wrapper {
            margin-bottom: 30px;
            animation: successSlideIn 0.6s ease-out;
        }
        
        @keyframes successSlideIn {
            from {
                opacity: 0;
                transform: translateY(-30px) scale(0.8);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        
        .success-checkmark {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, var(--success-green), var(--light-green));
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 30px rgba(40, 167, 69, 0.3);
            animation: checkPulse 2s ease-in-out infinite;
        }
        
        .success-checkmark i {
            font-size: 55px;
            color: white;
            animation: checkmark 0.8s ease-in-out;
        }
        
        @keyframes checkPulse {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 10px 30px rgba(40, 167, 69, 0.3);
            }
            50% {
                transform: scale(1.05);
                box-shadow: 0 15px 40px rgba(40, 167, 69, 0.4);
            }
        }
        
        @keyframes checkmark {
            0% {
                transform: scale(0) rotate(-45deg);
                opacity: 0;
            }
            50% {
                transform: scale(1.2) rotate(0deg);
            }
            100% {
                transform: scale(1) rotate(0deg);
                opacity: 1;
            }
        }
        
        /* Success Text */
        .success-title {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 15px;
            animation: fadeInUp 0.6s ease-out 0.2s both;
        }
        
        .success-subtitle {
            font-size: 1.1rem;
            color: var(--primary-gold);
            font-weight: 600;
            margin-bottom: 10px;
            animation: fadeInUp 0.6s ease-out 0.3s both;
        }
        
        .success-message {
            font-size: 1rem;
            color: var(--text-muted);
            line-height: 1.6;
            max-width: 600px;
            margin: 0 auto 30px;
            animation: fadeInUp 0.6s ease-out 0.4s both;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        /* Continue Shopping Button */
        .continue-shopping-btn {
            background: linear-gradient(135deg, var(--primary-gold), var(--dark-gold));
            color: white;
            border: none;
            padding: 15px 40px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 4px 15px rgba(180, 136, 62, 0.3);
            transition: all 0.3s ease;
            animation: fadeInUp 0.6s ease-out 0.5s both;
        }
        
        .continue-shopping-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(180, 136, 62, 0.4);
            color: white;
            text-decoration: none;
        }
        
        /* Order Summary Card */
        .order-summary-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 35px;
            margin-bottom: 30px;
            animation: fadeInUp 0.6s ease-out 0.6s both;
        }
        
        .order-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 2px solid var(--light-bg);
        }
        
        .order-id {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-dark);
        }
        
        .order-date {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-top: 5px;
        }
        
        .order-status {
            background: linear-gradient(135deg, var(--warning-orange), #fd7e14);
            color: white;
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 10px rgba(255, 193, 7, 0.3);
        }
        
        /* Order Items */
        .order-items-section {
            margin-bottom: 25px;
        }
        
        .section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 20px;
        }
        
        .section-title i {
            color: var(--primary-gold);
        }
        
        .order-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            background: var(--light-bg);
            border-radius: 8px;
            margin-bottom: 12px;
            transition: transform 0.2s ease;
        }
        
        .order-item:hover {
            transform: translateX(5px);
        }
        
        .item-image {
            width: 70px;
            height: 70px;
            border-radius: 8px;
            overflow: hidden;
            flex-shrink: 0;
            background: white;
            padding: 5px;
        }
        
        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 4px;
        }
        
        .item-details {
            flex: 1;
        }
        
        .item-name {
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 5px;
            font-size: 1rem;
        }
        
        .item-quantity {
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        
        .item-price {
            color: var(--primary-gold);
            font-weight: 700;
            font-size: 1.1rem;
        }
        .item-image {
    width: 70px;
    height: 70px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    background: white;
    padding: 5px;
}

.item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
}

        
        /* Order Total */
        .order-total {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            padding: 25px;
            border-radius: 10px;
            margin-top: 20px;
        }
        
        .total-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            color: var(--text-muted);
            font-size: 1rem;
        }
        
        .total-row.discount {
            color: var(--success-green);
        }
        
        .total-row.final {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--text-dark);
            border-top: 2px solid #dee2e6;
            padding-top: 15px;
            margin-top: 15px;
            margin-bottom: 0;
        }
        
        /* Delivery Information */
        .delivery-info-card {
            background: linear-gradient(135deg, #e3f2fd, #f3e5f5);
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 30px;
            animation: fadeInUp 0.6s ease-out 0.7s both;
        }
        
        .delivery-items {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        
        .delivery-item {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .delivery-icon {
            width: 50px;
            height: 50px;
            background: rgba(180, 136, 62, 0.15);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-gold);
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        
        .delivery-text {
            flex: 1;
        }
        
        .delivery-label {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 3px;
        }
        
        .delivery-value {
            font-weight: 700;
            color: var(--text-dark);
            font-size: 0.95rem;
        }
        
        /* What's Next Section */
        .whats-next-card {
            background: white;
            border-radius: 12px;
            padding: 35px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            animation: fadeInUp 0.6s ease-out 0.8s both;
        }
        
        .next-steps {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-top: 25px;
        }
        
        .next-step-item {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            padding: 20px;
            background: var(--light-bg);
            border-radius: 10px;
            transition: all 0.3s ease;
        }
        
        .next-step-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }
        
        .next-step-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 1.2rem;
        }
        
        .next-step-icon.email {
            background: rgba(40, 167, 69, 0.1);
            color: var(--success-green);
        }
        
        .next-step-icon.processing {
            background: rgba(255, 193, 7, 0.1);
            color: var(--warning-orange);
        }
        
        .next-step-icon.delivery {
            background: rgba(180, 136, 62, 0.1);
            color: var(--primary-gold);
        }
        
        .next-step-content h4 {
            margin: 0 0 8px;
            color: var(--text-dark);
            font-size: 1.05rem;
            font-weight: 700;
        }
        
        .next-step-content p {
            margin: 0;
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.5;
        }
        
        /* Action Buttons Section */
        .action-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
            margin: 40px 0;
            flex-wrap: wrap;
        }
        
        .btn-primary-custom {
            background: linear-gradient(135deg, var(--primary-gold), var(--dark-gold));
            color: white;
            border: none;
            padding: 15px 35px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 15px rgba(180, 136, 62, 0.3);
            transition: all 0.3s ease;
        }
        
        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(180, 136, 62, 0.4);
            color: white;
            text-decoration: none;
        }
        
        .btn-outline-custom {
            background: transparent;
            color: var(--primary-gold);
            border: 2px solid var(--primary-gold);
            padding: 13px 33px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s ease;
        }
        
        .btn-outline-custom:hover {
            background: var(--primary-gold);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }
        
        /* Confetti */
        .confetti {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9999;
            overflow: hidden;
        }
        
        .confetti-piece {
            position: absolute;
            width: 10px;
            height: 10px;
            background: var(--primary-gold);
            animation: confetti-fall 3s linear forwards;
        }
        
        @keyframes confetti-fall {
            0% {
                transform: translateY(-100vh) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(100vh) rotate(720deg);
                opacity: 0;
            }
        }
        
        /* Responsive Design */
        @media (max-width: 768px) {
            .success-wrapper {
                padding: 30px 0;
            }
            
            .success-content {
                padding: 40px 25px;
            }
            
            .success-title {
                font-size: 2rem;
            }
            
            .order-summary-card,
            .delivery-info-card,
            .whats-next-card {
                padding: 25px 20px;
            }
            
            .order-header {
                flex-direction: column;
                text-align: center;
            }
            
            .action-buttons {
                flex-direction: column;
                align-items: stretch;
            }
            
            .btn-primary-custom,
            .btn-outline-custom {
                width: 100%;
                justify-content: center;
            }
            
            .delivery-items,
            .next-steps {
                grid-template-columns: 1fr;
            }
            
            .order-item {
                flex-direction: column;
                text-align: center;
            }
            
            .item-details {
                text-align: center;
            }
        }
        
        @media (max-width: 480px) {
            .success-checkmark {
                width: 100px;
                height: 100px;
            }
            
            .success-checkmark i {
                font-size: 45px;
            }
            
            .success-title {
                font-size: 1.75rem;
            }
            
            .brand-logo {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body>
   
    
    <!-- Confetti Container -->
    <div class="confetti" id="confetti"></div>
    
    <div class="success-wrapper">
        <div class="success-container">
            
            <!-- Brand Header -->
            <div class="brand-header">
                <h1 class="brand-logo">
                    <i class="fas fa-crown"></i>
                    MILLIMILLET
                </h1>
                <a href="/orders/<%= order.orderId %>" class="view-order-btn">
                    View Order
                </a>
            </div>
            
            <!-- Success Content -->
            <div class="success-content">
                <!-- Success Icon -->
                <div class="success-icon-wrapper">
                    <div class="success-checkmark">
                        <i class="fas fa-check"></i>
                    </div>
                </div>
                
                <!-- Success Text -->
                <h2 class="success-title">Your order is Completed</h2>
                <p class="success-subtitle">Order Completed</p>
                <p class="success-subtitle">Arriving By Mon, Oct 2024</p>
                <p class="success-message">
                    Thank You for your order. Sit tight we are processing your order<br>
                    we will update you with your order in email
                </p>
                
                <!-- Continue Shopping Button -->
                <a href="/shop" class="continue-shopping-btn">
                    <i class="fas fa-shopping-cart"></i>
                    Continue Shopping
                </a>
            </div>
            
            <!-- Order Summary -->
            <div class="order-summary-card">
                <div class="order-header">
                    <div>
                        <div class="order-id">Order ID: #<%= order.orderId %></div>
                        <div class="order-date">
                            Placed on <%= new Date(order.createdOn).toLocaleDateString('en-US', { 
                                weekday: 'long', 
                                year: 'numeric', 
                                month: 'long', 
                                day: 'numeric',
                                hour: '2-digit',
                                minute: '2-digit'
                            }) %>
                        </div>
                    </div>
                    <div class="order-status"><%= order.status %></div>
                </div>
                
                <!-- Order Items -->
                <div class="order-items-section">
                   <h3 class="section-title">
  <i class="fas fa-shopping-bag"></i>
  Order Items (<%= order.orderedProducts.length %> items)
</h3>

                    
                    <% order.orderedProducts.forEach((item) => { %>
 <div class="order-item">
  <div class="item-image">
    <img src="/uploads/images/<%= item.product.productImage[0] %>" alt="<%= item.product.productName %>">
  </div>
  <div class="item-details">
    <h4 class="item-name"><%= item.product.productName %></h4>
    <p class="item-quantity">Quantity: <%= item.quantity %></p>
    <p class="item-price">₹<%= item.price %></p>
  </div>
</div>


                    <% }); %>
                </div>
                
                <!-- Order Total -->
                <div class="order-total">
                    <div class="total-row">
  <span>Subtotal:</span>
  <span>₹<%= order.totalPrice ? order.totalPrice.toFixed(2) : "0.00" %></span>
</div>

<% if (order.discount > 0) { %>
<div class="total-row discount">
  <span>Discount:</span>
  <span>-₹<%= order.discount.toFixed(2) %></span>
</div>
<% } %>

<div class="total-row">
  <span>Tax:</span>
  <span>₹<%= order.tax ? order.tax.toFixed(2) : "0.00" %></span>
</div>

<div class="total-row final">
  <span>Total Amount:</span>
  <span>₹<%= order.finalAmount ? order.finalAmount.toFixed(2) : "0.00" %></span>
</div>

            </div>
            
            <!-- Delivery Information -->
            <div class="delivery-info-card">
                <h3 class="section-title">
                    <i class="fas fa-truck"></i>
                    Delivery Information
                </h3>
                <div class="delivery-items">
                    <div class="delivery-item">
                        <div class="delivery-icon">
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <div class="delivery-text">
                            <div class="delivery-label">Expected Delivery</div>
                            <div class="delivery-value">
                                <%= new Date(Date.now() + 5 * 24 * 60 * 60 * 1000).toLocaleDateString('en-US', { 
                                    weekday: 'long', 
                                    month: 'long', 
                                    day: 'numeric' 
                                }) %>
                            </div>
                        </div>
                    </div>
                    
                    <div class="delivery-item">
                        <div class="delivery-icon">
                            <i class="fas fa-shipping-fast"></i>
                        </div>
                        <div class="delivery-text">
                            <div class="delivery-label">Shipping Method</div>
                            <div class="delivery-value">Standard Delivery</div>
                        </div>
                    </div>
                    
                    <div class="delivery-item">
                        <div class="delivery-icon">
                            <i class="fas fa-bell"></i>
                        </div>
                        <div class="delivery-text">
                            <div class="delivery-label">Tracking Updates</div>
                            <div class="delivery-value">Via Email & SMS</div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Action Buttons -->
            <div class="action-buttons">
                <a href="/orders/<%= order.orderId %>" class="btn-primary-custom">
                    <i class="fas fa-receipt"></i>
                    View Order Details
                </a>
                <a href="/shop" class="btn-outline-custom">
                    <i class="fas fa-store"></i>
                    Continue Shopping
                </a>
            </div>
            
            <!-- What's Next -->
            <div class="whats-next-card">
                <h3 class="section-title">
                    <i class="fas fa-info-circle"></i>
                    What's Next?
                </h3>
                <div class="next-steps">
                    <div class="next-step-item">
                        <div class="next-step-icon email">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="next-step-content">
                            <h4>Order Confirmation</h4>
                            <p>You'll receive an email confirmation with your order details shortly.</p>
                        </div>
                    </div>
                    
                    <div class="next-step-item">
                        <div class="next-step-icon processing">
                            <i class="fas fa-cogs"></i>
                        </div>
                        <div class="next-step-content">
                            <h4>Order Processing</h4>
                            <p>We'll prepare your items and get them ready for shipment.</p>
                        </div>
                    </div>
                    
                    <div class="next-step-item">
                        <div class="next-step-icon delivery">
                            <i class="fas fa-truck"></i>
                        </div>
                        <div class="next-step-content">
                            <h4>Shipment & Delivery</h4>
                            <p>Track your package and receive it at your doorstep.</p>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
    
   
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Confetti Animation
        function createConfetti() {
            const confettiContainer = document.getElementById('confetti');
            const colors = ['#b4883e', '#28a745', '#ffc107', '#dc3545', '#6f42c1', '#20c997'];
            
            for (let i = 0; i < 60; i++) {
                const confettiPiece = document.createElement('div');
                confettiPiece.className = 'confetti-piece';
                confettiPiece.style.left = Math.random() * 100 + '%';
                confettiPiece.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                confettiPiece.style.animationDelay = Math.random() * 3 + 's';
                confettiPiece.style.animationDuration = (Math.random() * 2 + 2) + 's';
                confettiContainer.appendChild(confettiPiece);
            }
            
            // Remove confetti after animation
            setTimeout(() => {
                confettiContainer.innerHTML = '';
            }, 6000);
        }
        
        // Start confetti on page load
        window.addEventListener('load', () => {
            setTimeout(createConfetti, 300);
        });
        
        // Button click animations
        document.querySelectorAll('.btn-primary-custom, .btn-outline-custom, .continue-shopping-btn, .view-order-btn').forEach(button => {
            button.addEventListener('click', function(e) {
                this.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    this.style.transform = '';
                }, 150);
            });
        });
        
        // Smooth scroll to center
        window.addEventListener('load', () => {
            setTimeout(() => {
                document.querySelector('.success-content').scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
            }, 100);
        });
        
        // Add entrance animations on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);
        
        // Observe animated elements
        document.querySelectorAll('.order-item, .next-step-item').forEach(el => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = 'all 0.5s ease-out';
            observer.observe(el);
        });
    </script>
</body>
</html>