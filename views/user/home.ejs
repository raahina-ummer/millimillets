<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MilliMillet - Premium Ancient Grains</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #8B7355;
            --primary-dark: #6D5A43;
            --primary-light: #A0826D;
            --accent: #C4A57B;
            --text-dark: #2d2d2d;
            --text-muted: #666;
            --bg-light: #F9F5F0;
            --success: #2D5016;
            --danger: #dc3545;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: #fff;
            color: var(--text-dark);
            line-height: 1.6;
        }

        /* Hero Section - Premium & Clean */
        .hero {
            position: relative;
            height: 80vh;
            min-height: 600px;
            background: linear-gradient(135deg, rgba(109, 90, 67, 0.95), rgba(139, 115, 85, 0.9)),
                url('https://images.unsplash.com/photo-1574323347407-f5e1ad6d020b?w=1920&q=80');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            display: flex;
            align-items: center;
            margin-bottom: 0;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at center, transparent 0%, rgba(0, 0, 0, 0.2) 100%);
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 5%;
            color: white;
        }

        .hero-content h1 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 1.5rem;
            letter-spacing: -0.02em;
        }

        .hero-content p {
            font-size: clamp(1rem, 2vw, 1.25rem);
            max-width: 600px;
            margin-bottom: 2.5rem;
            opacity: 0.95;
            font-weight: 400;
        }

        .hero-cta {
            display: inline-flex;
            align-items: center;
            gap: 1rem;
            background: white;
            color: var(--primary-dark);
            padding: 1rem 2.5rem;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        }

        .hero-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.3);
            color: var(--primary);
        }

        /* Section Styling */
        .section {
            padding: 5rem 5%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-tag {
            display: inline-block;
            color: var(--primary);
            font-size: 0.875rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .section-title {
            font-size: clamp(2rem, 4vw, 2.75rem);
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 1rem;
            letter-spacing: -0.02em;
        }

        .section-subtitle {
            font-size: 1.125rem;
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Product Cards - Modern & Premium */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 2rem;
        }

        .product-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(0, 0, 0, 0.06);
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
            border-color: transparent;
        }

        .product-image-wrapper {
            position: relative;
            width: 100%;
            padding-top: 100%;
            background: var(--bg-light);
            overflow: hidden;
        }

        .product-image-wrapper img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .product-card:hover .product-image-wrapper img {
            transform: scale(1.08);
        }

        .product-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: var(--danger);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-size: 0.875rem;
            font-weight: 700;
            z-index: 2;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
        }

        .product-info {
            padding: 1.5rem;
        }

        .product-name {
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 0.75rem;
            min-height: 3rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .product-price-row {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .product-price {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--success);
        }

        .product-price-old {
            font-size: 1rem;
            color: var(--text-muted);
            text-decoration: line-through;
        }

        .product-discount {
            background: rgba(220, 53, 69, 0.1);
            color: var(--danger);
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
            font-size: 0.875rem;
            font-weight: 600;
        }

        .btn-shop {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
            background: var(--primary);
            color: white;
            border: none;
            padding: 0.875rem;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .btn-shop:hover {
            background: var(--primary-dark);
            color: white;
            transform: translateY(-2px);
        }

        /* Offer Section - Premium Design */
        .offer-section {
            background: linear-gradient(135deg, #F9F5F0 0%, #F5E6D3 100%);
            padding: 5rem 5%;
        }

        .offer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .offer-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(0, 0, 0, 0.06);
        }

        .offer-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
        }

        .offer-image {
            position: relative;
            width: 100%;
            padding-top: 75%;
            background: var(--bg-light);
            overflow: hidden;
        }

        .offer-image img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .offer-card:hover .offer-image img {
            transform: scale(1.08);
        }

        .offer-content {
            padding: 1.5rem;
        }

        .offer-title {
            font-size: 1.125rem;
            font-weight: 600;
            margin-bottom: 1rem;
            min-height: 2.5rem;
        }

        .offer-description {
            font-size: 0.875rem;
            color: var(--text-muted);
            margin-bottom: 1rem;
            line-height: 1.6;
        }

        /* Testimonials - Clean & Professional */
        .testimonials-section {
            background: white;
            padding: 5rem 5%;
        }

        .testimonials-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 2rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .testimonial-card {
            background: var(--bg-light);
            padding: 2rem;
            border-radius: 20px;
            border: 1px solid rgba(0, 0, 0, 0.06);
            transition: all 0.3s ease;
        }

        .testimonial-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
        }

        .testimonial-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .testimonial-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1.125rem;
        }

        .testimonial-name {
            font-weight: 600;
            color: var(--text-dark);
        }

        .testimonial-stars {
            color: #FFB800;
            margin-bottom: 1rem;
        }

        .testimonial-text {
            color: var(--text-muted);
            line-height: 1.8;
            font-size: 0.9375rem;
        }

        /* Newsletter - Modern */
        .newsletter-section {
            background: var(--primary-dark);
            color: white;
            padding: 4rem 5%;
            text-align: center;
        }

        .newsletter-content {
            max-width: 600px;
            margin: 0 auto;
        }

        .newsletter-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .newsletter-subtitle {
            opacity: 0.9;
            margin-bottom: 2rem;
        }

        .newsletter-form {
            display: flex;
            gap: 1rem;
            max-width: 500px;
            margin: 0 auto;
        }

        .newsletter-input {
            flex: 1;
            padding: 1rem 1.5rem;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.1);
            color: white;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .newsletter-input::placeholder {
            color: rgba(255, 255, 255, 0.6);
        }

        .newsletter-input:focus {
            outline: none;
            border-color: white;
            background: rgba(255, 255, 255, 0.15);
        }

        .btn-newsletter {
            padding: 1rem 2rem;
            background: white;
            color: var(--primary-dark);
            border: none;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .btn-newsletter:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(255, 255, 255, 0.3);
        }
/* Logged-in primary button */
.btn-primary {
    background-color: #8B7355;
    border-color: #8B7355;
    color: #fff;
}

.btn-primary:hover {
    background-color: #755f46;
}
/* Guest button */
.btn-guest {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    background-color: #E6DED4;
    color: #6D5A43 !important;
    padding: 0.875rem;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none !important;
}

.btn-guest:hover {
    background-color: #D8CFC3;
    color: #6D5A43 !important;
}




        /* Responsive */
        @media (max-width: 768px) {
            .section {
                padding: 3rem 1.5rem;
            }

            .products-grid,
            .offer-grid,
            .testimonials-grid {
                grid-template-columns: 1fr;
            }

            .newsletter-form {
                flex-direction: column;
            }

            .hero {
                height: 70vh;
                min-height: 500px;
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/user/header.ejs') %>

        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h1>Nature's Ancient Superfood<br>for Modern Living</h1>
                <p>Discover the nutritional power of organic millets, sustainably sourced and delivered fresh to your
                    doorstep.</p>
                <a href="/shop" class="hero-cta">
                    Explore Products
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </section>

        <!-- Best Selling Products -->
        <section class="section">
            <div class="section-header">
                <span class="section-tag">Trending Now</span>
                <h2 class="section-title">Best Selling Products</h2>
                <p class="section-subtitle">Handpicked selections loved by our community</p>
            </div>
            <div class="products-grid">
                <% if (products && products.length> 0) { %>
                    <% products.slice(0, 4).forEach(product=> { %>
                        <div class="product-card">
                            <div class="product-image-wrapper">
                                <% if (product.productOffer?.offerActive && product.productOffer?.discountPercentage> 0)
                                    { %>
                                    <span class="product-badge">
                                        <%= product.productOffer.discountPercentage %>% OFF
                                    </span>
                                    <% } %>
                                        <a href="/product/details/<%= product._id %>">
                                            <img src="/uploads/images/<%= product.productImage[0] %>"
                                                alt="<%= product.productName %>">
                                        </a>
                            </div>
                            <div class="product-info">
                                <h3 class="product-name">
                                    <%= product.productName %>
                                </h3>
                                <div class="product-price-row">
                                    <span class="product-price">₹<%= product.variant[0].salePrice.toFixed(2) %></span>
                                    <% if (product.variant[0].regularPrice> product.variant[0].salePrice) { %>
                                        <span class="product-price-old">₹<%= product.variant[0].regularPrice.toFixed(2)
                                                %></span>
                                        <% } %>
                                </div>
     <% if (user) { %>
    <a href="/product/details/<%= product._id %>" class="btn-shop">
        <i class="fas fa-shopping-bag"></i>
        View Product
    </a>
<% } else { %>
    <a href="/login" class="btn-guest">
        <i class="fas fa-lock"></i>
        Login to View
    </a>
<% } %>






                            </div>
                        </div>
                        <% }) %>
                            <% } %>
            </div>
        </section>

        <!-- Special Offers -->
        <section class="offer-section">
            <div class="section-header">
                <span class="section-tag">Limited Time</span>
                <h2 class="section-title">Special Offers</h2>
                <p class="section-subtitle">Exclusive deals on premium millet products</p>
            </div>
            <div class="offer-grid">
                <% if (offerProducts && offerProducts.length> 0) { %>
                    <% offerProducts.forEach(product=> { %>
                        <div class="offer-card">
                            <div class="offer-image">
                                <a href="/product/details/<%= product._id %>">
                                    <img src="/uploads/images/<%= product.productImage[0] %>"
                                        alt="<%= product.productName %>">
                                </a>
                            </div>
                            <div class="offer-content">
                                <h3 class="offer-title">
                                    <%= product.productName %>
                                </h3>
                                <% if (product.productOffer?.offerDescription) { %>
                                    <p class="offer-description">
                                        <%= product.productOffer.offerDescription %>
                                    </p>
                                    <% } %>
                                        <div class="product-price-row">
                                            <span class="product-price">₹<%= product.finalPrice.toFixed(2) %>
                                                    </span>
                                            <% if (product.discountPercentage > 0) { %>
                                                <span class="product-price-old">₹<%=
                                                        product.variant[0].salePrice.toFixed(2) %></span>
                                                <span class="product-discount">
                                                    <%= product.basePrice %>% OFF
                                                </span>
                                                <% } %>
                                        </div>
                                        <a href="/product/details/<%= product._id %>" class="btn-shop">
                                            <i class="fas fa-shopping-bag"></i>
                                            Shop Now
                                        </a>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div class="offer-card">
                                    <div class="offer-image"></div>
                                    <div class="offer-content">
                                        <h3 class="offer-title">Coming Soon</h3>
                                        <p class="offer-description">Exciting offers are on the way. Check back soon!
                                        </p>
                                    </div>
                                </div>
                                <% } %>
            </div>
        </section>

        <!-- Testimonials -->
