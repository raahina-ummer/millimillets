<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Address Book - My Account | Your App</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"></script>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Nunito Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #E8DCC4;
            min-height: 100vh;
        }

        .main-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .page-header {
            background-color: #ffffff;
            padding: 30px 40px;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .page-title {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #2d2d2d;
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
        }

        .page-title i {
            color: #8b7355;
        }

        .btn {
            padding: 12px 24px;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border: none;
        }

        .btn-primary {
            background-color: #8b7355;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(139, 115, 85, 0.25);
        }

        .btn-primary:hover {
            background-color: #755e45;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(139, 115, 85, 0.35);
        }

        .btn-outline-primary {
            background-color: transparent;
            border: 2px solid #8b7355;
            color: #8b7355;
            padding: 8px 16px;
            font-size: 0.9rem;
        }

        .btn-outline-primary:hover {
            background-color: #8b7355;
            color: #ffffff;
            transform: translateY(-2px);
        }

        .btn-outline-danger {
            background-color: transparent;
            border: 2px solid #dc3545;
            color: #dc3545;
            padding: 8px 16px;
            font-size: 0.9rem;
        }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: #ffffff;
            transform: translateY(-2px);
        }

        /* Address Grid */
        .address-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 25px;
        }

        .address-card {
            background-color: #ffffff;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            border: 2px solid transparent;
            position: relative;
        }

        .address-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
            border-color: #8b7355;
        }

        .address-card.default {
            border-color: #8b7355;
            background: linear-gradient(135deg, #ffffff 0%, #f9f6f1 100%);
        }

        .default-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background-color: #8b7355;
            color: #ffffff;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .address-card h5 {
            margin: 0 0 15px;
            color: #2d2d2d;
            font-size: 1.15rem;
            font-weight: 700;
        }

        .address-card p {
            margin: 8px 0;
            color: #666;
            line-height: 1.6;
        }

        .address-card p strong {
            color: #2d2d2d;
            font-weight: 600;
        }

        .address-info {
            margin: 15px 0 20px;
            padding: 12px;
            background-color: #f9f6f1;
            border-radius: 8px;
            color: #333;
            line-height: 1.6;
        }

        .address-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 2px solid #f5f0e8;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background-color: #ffffff;
            border-radius: 16px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        }

        .empty-state i {
            font-size: 64px;
            color: #d4c5b0;
            margin-bottom: 25px;
        }

        .empty-state h4 {
            color: #666;
            margin-bottom: 10px;
            font-size: 1.5rem;
            font-weight: 700;
        }

        .empty-state p {
            color: #999;
            margin-bottom: 30px;
            font-size: 1rem;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .main-container {
                padding: 20px 15px;
            }

            .page-header {
                padding: 20px 25px;
                flex-direction: column;
                text-align: center;
            }

            .page-title {
                font-size: 1.5rem;
            }

            .address-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 480px) {
            .main-container {
                padding: 15px 10px;
            }

            .page-header {
                padding: 15px 20px;
            }

            .page-title {
                font-size: 1.25rem;
            }

            .address-card {
                padding: 20px;
            }

            .btn {
                padding: 10px 18px;
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <div class="main-container">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-map-marker-alt"></i>
                Address Book
            </h1>
            <a href="/addAddres" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add New Address
            </a>
        </div>

        <!-- Address Cards -->
        <div class="address-grid">
            <% if (addresses && addresses.length > 0) { %>
                <% addresses.forEach(address => { %>
                    <div class="address-card <%= address.isDefault ? 'default' : '' %>">
                        <% if (address.isDefault) { %>
                            <div class="default-badge">Default</div>
                        <% } %>
                        
                        <h5>
                            <%= address.name %>
                            <% if (address.label) { %>
                                <span style="color: #8b7355; font-size: 0.9rem;">(<%= address.label %>)</span>
                            <% } %>
                        </h5>
                        
                        <p><strong>Type:</strong> <%= address.addressType %></p>
                        <p><strong>Phone:</strong> <%= address.mobile %></p>
                        
                        <div class="address-info">
                            <% if (address.addressLine1) { %><%= address.addressLine1 %><br><% } %>
                            <% if (address.addressLine2) { %><%= address.addressLine2 %><br><% } %>
                            <%= address.city %>, <%= address.state %> - <%= address.pincode %><br>
                            <%= address.country %>
                        </div>

                        <div class="address-actions">
                            <a href="/editAddress/<%= address._id %>" class="btn btn-outline-primary">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            
                            <% if (!address.isDefault) { %>
                                <button class="btn btn-outline-primary" onclick="setDefault('<%= address._id %>')">
                                    <i class="fas fa-star"></i> Set Default
                                </button>
                            <% } %>
                            
                            <button class="btn btn-outline-danger" onclick="deleteAddress('<%= address._id %>')">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <!-- Empty State -->
                <div class="empty-state">
                    <i class="fas fa-map-marker-alt"></i>
                    <h4>No addresses found</h4>
                    <p>Add your first address to get started with shipping</p>
                    <a href="/addAddress" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Add Address
                    </a>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        function deleteAddress(id) {
            swal({
                title: "Are you sure?",
                text: "This address will be permanently deleted.",
                icon: "warning",
                buttons: {
                    cancel: {
                        text: "Cancel",
                        visible: true,
                        closeModal: true
                    },
                    confirm: {
                        text: "Delete",
                        visible: true,
                        closeModal: true
                    }
                },
                dangerMode: true,
            }).then((willDelete) => {
                if (willDelete) {
                    fetch(`/deleteAddress/${id}`, {
                        method: 'DELETE'
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            swal({
                                title: "Deleted!",
                                text: "Address has been deleted successfully.",
                                icon: "success",
                                button: "OK"
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            swal("Failed to delete address!", { icon: "error" });
                        }
                    })
                    .catch(err => {
                        swal("Error!", "Something went wrong.", { icon: "error" });
                    });
                }
            });
        }

        function setDefault(id) {
            swal({
                title: "Set as default address?",
                text: "This will be used as your primary shipping address.",
                icon: "info",
                buttons: {
                    cancel: {
                        text: "Cancel",
                        visible: true,
                        closeModal: true
                    },
                    confirm: {
                        text: "Set Default",
                        visible: true,
                        closeModal: true
                    }
                },
            }).then((willSet) => {
                if (willSet) {
                    fetch(`/address/default/${id}`, {
                        method: 'PATCH'
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            swal({
                                title: "Success!",
                                text: "Default address has been updated.",
                                icon: "success",
                                button: "OK"
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            swal("Failed to set default!", { icon: "error" });
                        }
                    })
                    .catch(err => {
                        swal("Error!", "Something went wrong.", { icon: "error" });
                    });
                }
            });
        }
    </script>
</body>
</html>