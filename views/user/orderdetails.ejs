<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details | MilliMillet</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"></script>
    <style>
        * {
            font-family: 'Nunito Sans', sans-serif;
        }

        body {
            background-color: #E8DCC4;
            margin: 0;
            padding: 0;
        }

        .order-detail-wrapper {
            background-color: #E8DCC4;
            min-height: 100vh;
            padding: 40px 0;
        }

        .order-detail-container {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 30px;
            margin-top: 20px;
        }

        /* Section Cards */
        .detail-section {
            background: white;
            border-radius: 15px;
            box-shadow: 0 3px 20px rgba(139, 115, 85, 0.12);
            margin-bottom: 25px;
            overflow: hidden;
            transition: all 0.3s;
        }

        .section-header {
            background: linear-gradient(135deg, #f9f6f1 0%, #E8DCC4 100%);
            padding: 20px 25px;
            border-bottom: 2px solid #d4c5b0;
        }

        .section-header h3 {
            margin: 0;
            color: #8B7355;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.3rem;
        }

        .section-content {
            padding: 25px;
        }

        /* Order Header Info */
        .order-header-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }

        .info-item {
            text-align: center;
            padding: 20px;
            background: #f9f6f1;
            border-radius: 12px;
            border: 2px solid #E8DCC4;
            transition: all 0.3s;
        }

        .info-item:hover {
            border-color: #8B7355;
            transform: translateY(-3px);
        }

        .info-label {
            font-size: 0.85rem;
            color: #755e45;
            margin-bottom: 8px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-value {
            font-size: 1.2rem;
            color: #333;
            font-weight: 700;
        }

        /* Status Badges */
        .order-status {
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 700;
            text-transform: uppercase;
            display: inline-block;
            letter-spacing: 0.5px;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-processing {
            background: #cfe2ff;
            color: #084298;
        }

        .status-shipped {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-delivered {
            background: #d1e7dd;
            color: #0a3622;
        }

        .status-canceled {
            background: #f8d7da;
            color: #842029;
        }

        .status-return-request {
            background: #fff3cd;
            color: #664d03;
        }

        .status-returned {
            background: #e2e3e5;
            color: #41464b;
        }

        /* Timeline */
        .timeline {
            position: relative;
            padding: 30px 0;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 25px;
            top: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient(180deg, #8B7355 0%, #d4c5b0 100%);
        }

        .timeline-item {
            position: relative;
            padding-left: 70px;
            margin-bottom: 35px;
        }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

        .timeline-icon {
            position: absolute;
            left: 10px;
            top: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #8B7355;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            box-shadow: 0 2px 10px rgba(139, 115, 85, 0.3);
            z-index: 1;
        }

        .timeline-icon.pending {
            background: #d4c5b0;
            color: #8B7355;
        }

        .timeline-content h4 {
            margin: 0 0 8px;
            color: #333;
            font-weight: 700;
            font-size: 1.1rem;
        }

        .timeline-content p {
            margin: 0;
            color: #755e45;
            font-size: 0.95rem;
            line-height: 1.5;
        }

        .timeline-date {
            font-size: 0.85rem;
            color: #999;
            margin-top: 8px;
            font-weight: 600;
        }

        /* Product Items */
        .product-item {
            display: flex;
            gap: 20px;
            padding: 20px;
            background: #f9f6f1;
            border-radius: 12px;
            margin-bottom: 15px;
            transition: all 0.3s;
            border: 2px solid transparent;
        }

        .product-item:hover {
            background: #f0eae0;
            border-color: #d4c5b0;
        }

        .product-item:last-child {
            margin-bottom: 0;
        }

        .product-image {
            width: 90px;
            height: 90px;
            border-radius: 12px;
            overflow: hidden;
            flex-shrink: 0;
            border: 2px solid #d4c5b0;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-details {
            flex: 1;
        }

        .product-name {
            font-weight: 700;
            color: #333;
            margin: 0 0 8px;
            font-size: 1.1rem;
        }

        .product-price {
            color: #8B7355;
            font-weight: 700;
            margin-bottom: 8px;
            font-size: 1rem;
        }

        .product-quantity {
            color: #755e45;
            font-size: 0.95rem;
            font-weight: 600;
        }

        .product-actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
            align-items: flex-end;
            justify-content: space-between;
        }

        .product-total {
            font-weight: 700;
            color: #8B7355;
            font-size: 1.3rem;
        }

        .btn-product {
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85rem;
            border: 2px solid #8B7355;
            background: white;
            color: #8B7355;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-product:hover {
            background: #8B7355;
            color: white;
            transform: translateY(-2px);
        }

        .btn-product.return {
            border-color: #ffc107;
            color: #ffc107;
        }

        .btn-product.return:hover {
            background: #ffc107;
            color: #333;
        }

        .btn-product.cancel {
            border-color: #dc3545;
            color: #dc3545;
        }

        .btn-product.cancel:hover {
            background: #dc3545;
            color: white;
        }

        /* Address Section */
        .address-box {
            background: #f9f6f1;
            padding: 20px;
            border-radius: 12px;
            border-left: 4px solid #8B7355;
        }

        .address-box h4 {
            margin: 0 0 12px;
            color: #333;
            font-weight: 700;
            font-size: 1.1rem;
        }

        .address-box p {
            margin: 0 0 8px;
            color: #666;
            line-height: 1.6;
        }

        .address-box p:last-child {
            margin-bottom: 0;
        }

        /* Payment Info */
        .payment-box {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 20px;
            background: #f9f6f1;
            border-radius: 12px;
        }

        .payment-icon {
            width: 50px;
            height: 50px;
            background: #8B7355;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .payment-details h4 {
            margin: 0 0 8px;
            color: #333;
            font-weight: 700;
        }

        .payment-details p {
            margin: 0 0 5px;
            color: #666;
            font-size: 0.95rem;
        }

        /* Order Summary Sidebar */
        .order-summary {
            background: white;
            border-radius: 15px;
            box-shadow: 0 3px 20px rgba(139, 115, 85, 0.12);
            padding: 25px;
            height: fit-content;
            position: sticky;
            top: 20px;
        }

        .summary-title {
            margin: 0 0 25px;
            color: #8B7355;
            font-weight: 700;
            font-size: 1.4rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            padding-bottom: 12px;
            border-bottom: 1px solid #f0eae0;
        }

        .summary-row:last-of-type {
            border-bottom: none;
        }

        .summary-row.total {
            border-top: 3px solid #8B7355;
            padding-top: 20px;
            margin-top: 20px;
            font-size: 1.3rem;
            font-weight: 700;
            color: #8B7355;
        }

        .summary-label {
            color: #755e45;
            font-weight: 600;
        }

        .summary-value {
            color: #333;
            font-weight: 700;
        }

        .summary-value.discount {
            color: #28a745;
        }

        .summary-value.cancelled {
            color: #dc3545;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 25px;
        }

        .btn-action {
            width: 100%;
            padding: 14px 20px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.95rem;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            text-align: center;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-back {
            background: #f9f6f1;
            color: #8B7355;
            border: 2px solid #d4c5b0;
        }

        .btn-back:hover {
            background: #E8DCC4;
            border-color: #8B7355;
        }

        .btn-invoice {
            background: #8B7355;
            color: white;
        }

        .btn-invoice:hover {
            background: #755e45;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(139, 115, 85, 0.3);
        }

        .btn-return {
            background: #ffc107;
            color: #333;
        }

        .btn-return:hover {
            background: #e0a800;
            transform: translateY(-2px);
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(5px);
        }

        .modal-content {
            background-color: white;
            margin: 8% auto;
            padding: 0;
            border-radius: 15px;
            width: 90%;
            max-width: 550px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        }

        .modal-header {
            padding: 25px;
            border-bottom: 2px solid #E8DCC4;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(135deg, #f9f6f1 0%, #E8DCC4 100%);
            border-radius: 15px 15px 0 0;
        }

        .modal-header h3 {
            margin: 0;
            color: #8B7355;
            font-weight: 700;
            font-size: 1.3rem;
        }

        .close {
            font-size: 32px;
            font-weight: bold;
            color: #8B7355;
            cursor: pointer;
            transition: all 0.3s;
            line-height: 1;
        }

        .close:hover {
            color: #755e45;
            transform: rotate(90deg);
        }

        .modal-body {
            padding: 30px;
        }

        .modal-body p {
            color: #666;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .form-label {
            display: block;
            margin-bottom: 10px;
            color: #755e45;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .form-select,
        .reason-textarea {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #d4c5b0;
            border-radius: 10px;
            font-size: 0.95rem;
            transition: all 0.3s;
            font-family: 'Nunito Sans', sans-serif;
        }

        .form-select:focus,
        .reason-textarea:focus {
            border-color: #8B7355;
            outline: none;
            box-shadow: 0 0 0 3px rgba(139, 115, 85, 0.1);
        }

        .reason-textarea {
            min-height: 120px;
            resize: vertical;
            margin-top: 15px;
        }

        .modal-buttons {
            display: flex;
            gap: 15px;
            margin-top: 25px;
        }

        .btn-modal {
            flex: 1;
            padding: 12px 20px;
            border-radius: 10px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-modal-cancel {
            background: #f9f6f1;
            color: #8B7355;
            border: 2px solid #d4c5b0;
        }

        .btn-modal-cancel:hover {
            background: #E8DCC4;
        }

        .btn-modal-confirm {
            background: #dc3545;
            color: white;
        }

        .btn-modal-confirm:hover {
            background: #bb2d3b;
            transform: translateY(-2px);
        }

        .btn-modal-return {
            background: #ffc107;
            color: #333;
        }

        .btn-modal-return:hover {
            background: #e0a800;
            transform: translateY(-2px);
        }

        /* Warning Banner */
        .warning-banner {
            background: linear-gradient(135deg, #fff3cd 0%, #ffe69c 100%);
            padding: 15px 20px;
            border-radius: 10px;
            border-left: 4px solid #ffc107;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .warning-banner i {
            font-size: 1.5rem;
            color: #856404;
        }

        .warning-banner p {
            margin: 0;
            color: #856404;
            font-weight: 600;
            font-size: 0.95rem;
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .order-detail-container {
                grid-template-columns: 1fr;
            }

            .order-summary {
                position: static;
                order: -1;
            }
        }

        @media (max-width: 768px) {
            .order-header-info {
                grid-template-columns: 1fr;
            }

            .product-item {
                flex-direction: column;
                text-align: center;
            }

            .product-image {
                margin: 0 auto;
            }

            .product-actions {
                width: 100%;
                align-items: center;
            }

            .btn-product {
                width: 100%;
            }

            .timeline-item {
                padding-left: 60px;
            }

            .timeline::before {
                left: 20px;
            }

            .timeline-icon {
                left: 5px;
            }
        }
    </style>
</head>

<body>
    <%- include("../partials/user/header.ejs") %>

        <div class="order-detail-wrapper">
            <div class="container">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb" style="background: none; padding: 0;">
                        <li class="breadcrumb-item"><a href="/" style="color: #8B7355; text-decoration: none;">Home</a>
                        </li>
                        <li class="breadcrumb-item"><a href="/orders" style="color: #8B7355; text-decoration: none;">My
                                Orders</a></li>
                        <li class="breadcrumb-item active" style="color: #755e45;">Order #<%= order.orderId %>
                        </li>
                    </ol>
                </nav>

                <div class="order-detail-container">
                    <!-- Left Column -->
                    <div>
                        <!-- Order Details Header -->
                        <div class="detail-section">
                            <div class="section-header">
                                <h3><i class="fas fa-receipt"></i> Order Details</h3>
                            </div>
                            <div class="section-content">
                                <div class="order-header-info">
                                    <div class="info-item">
                                        <div class="info-label">Order ID</div>
                                        <div class="info-value">#<%= order.orderId %>
                                        </div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Order Date</div>
                                        <div class="info-value">
                                            <%= new Date(order.createdOn).toLocaleDateString('en-US', { month: 'short' ,
                                                day: 'numeric' , year: 'numeric' }) %>
                                        </div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Status</div>
                                        <div class="info-value">
                                            <span
                                                class="order-status status-<%= order.status.toLowerCase().replace(/\s+/g, '-') %>">
                                                <%= order.status %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Total Amount</div>
                                        <div class="info-value">₹<%= order.finalAmount.toFixed(2) %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Order Timeline -->
                        <div class="detail-section">
                            <div class="section-header">
                                <h3><i class="fas fa-clock"></i> Order Timeline</h3>
                            </div>
                            <div class="section-content">
                                <div class="timeline">
                                    <% const statusOrder=['Pending', 'Processing' , 'Shipped' , 'Delivered' ]; const
                                        currentStatusIndex=statusOrder.indexOf(order.status); const timelineEvents=[ {
                                        status: 'Delivered' , title: 'Order Delivered' ,
                                        desc: 'Your order has been successfully delivered' }, { status: 'Shipped' ,
                                        title: 'Order Shipped' , desc: 'Your order is on the way' }, {
                                        status: 'Processing' , title: 'Order Processing' ,
                                        desc: 'Your order is being prepared' }, { status: 'Pending' ,
                                        title: 'Order Confirmed' , desc: 'Your order has been placed successfully' } ];
                                        %>
                                        <% timelineEvents.forEach((event, index)=> {
                                            const eventIndex = statusOrder.indexOf(event.status);
                                            const isCompleted = currentStatusIndex >= eventIndex;
                                            %>
                                            <div class="timeline-item">
                                                <div class="timeline-icon <%= isCompleted ? '' : 'pending' %>">
                                                    <i class="fas fa-check"></i>
                                                </div>
                                                <div class="timeline-content">
                                                    <h4>
                                                        <%= event.title %>
                                                    </h4>
                                                    <p>
                                                        <%= event.desc %>
                                                    </p>
                                                    <% if (isCompleted) { %>
                                                        <div class="timeline-date">
                                                            <%= new Date(order.createdOn).toLocaleString('en-US', {
                                                                month: 'short' , day: 'numeric' , year: 'numeric' ,
                                                                hour: 'numeric' , minute: 'numeric' , hour12: true }) %>
                                                        </div>
                                                        <% } %>
                                                </div>
                                            </div>
                                            <% }); %>
                                </div>
                            </div>
                        </div>

                        <!-- Order Items -->
                        <div class="detail-section">
                            <div class="section-header">
                                <h3><i class="fas fa-shopping-bag"></i> Order Items (<%= order.orderedProducts.length %>
                                        items)</h3>
                            </div>
                            <% if (order.couponApplied && order.status==='Delivered' ) { %>
                                <div class="warning-banner" style="margin: 20px 25px 0;">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <p>Returning any item will cancel the entire coupon discount</p>
                                </div>
                                <% } %>
                                    <div class="section-content">
                                        <% order.orderedProducts.forEach(item=> { %>
                                            <div class="product-item">
                                                <div class="product-image">
                                                    <img src="<%= item.product && item.product.productImage && item.product.productImage[0] 
                                                             ? '/uploads/images/' + item.product.productImage[0] 
                                                                : '/placeholder.jpg' %>" alt="<%= item.product ? item.product.productName : 'Product Image' %>" />

                                                </div>
                                                <div class="product-details">
                                                    <h4 class="product-name">
                                                        <%= item.product.productName %>
                                                    </h4>
                                                    <div class="product-price">₹<%= item.price.toFixed(2) %>
                                                    </div>
                                                    <div class="product-quantity">Quantity: <%= item.quantity %>
                                                    </div>
                                                </div>
                                                <div class="product-actions">
                                                    <span
                                                        class="order-status status-<%= order.status.toLowerCase().replace(/\s+/g, '-') %>">
                                                        <%= order.status %>
                                                    </span>
                                                    <div class="product-total">₹<%= (item.price *
                                                            item.quantity).toFixed(2) %>
                                                    </div>
                                                    <% if (order.status==='Pending' || order.status==='Processing' ) {
                                                        %>
                                                        <button class="btn-product cancel"
                                                            onclick="cancelProduct('<%= order.orderId %>', '<%= item.product._id %>')">
                                                            <i class="fas fa-times-circle"></i> Cancel
                                                        </button>
                                                        <% } %>
                                                            <% if (order.status==='Delivered' ) { %>
                                                                <button class="btn-product return"
                                                                    onclick="returnProduct('<%= order.orderId %>', '<%= item.product._id %>')">
                                                                    <i class="fas fa-undo"></i> Return
                                                                </button>
                                                                <% } %>
                                                </div>
                                            </div>
                                            <% }); %>
                                    </div>
                        </div>

                        <!-- Shipping Address -->
                        <div class="detail-section">
                            <div class="section-header">
                                <h3><i class="fas fa-map-marker-alt"></i> Shipping Address</h3>
                            </div>
                            <div class="section-content">
                                <div class="address-box">
                                    <h4>
                                        <%= order.address.name %>
                                    </h4>
                                    <p><strong>Phone:</strong>
                                        <%= order.address.mobile %>
                                    </p>
                                    <p>
                                        <%= order.address.addressLine1 %>
                                    </p>
                                    <% if (order.address.addressLine2) { %>
                                        <p>
                                            <%= order.address.addressLine2 %>
                                        </p>
                                        <% } %>
                                            <p>
                                                <%= order.address.city %>, <%= order.address.state %> - <%=
                                                            order.address.pincode %>
                                            </p>
                                            <p>
                                                <%= order.address.country %>
                                            </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column - Order Summary -->
                    <div class="order-summary">
                        <h3 class="summary-title">Order Summary</h3>

                        <div class="summary-row">
                            <span class="summary-label">Subtotal (<%= order.orderedProducts.length %> items)</span>
                            <span class="summary-value">₹<%= order.totalPrice.toFixed(2) %></span>
                        </div>

                        <% if (order.discount> 0) { %>
                            <div class="summary-row">
                                <span class="summary-label">Discount</span>
                                <span class="summary-value discount">-₹<%= order.discount.toFixed(2) %></span>
                            </div>
                            <% } %>

                                <div class="summary-row total">
                                    <span>Total Amount</span>
                                    <span>₹<%= order.finalAmount.toFixed(2) %></span>
                                </div>

                                <!-- Action Buttons -->
                                <div class="action-buttons">
                                    <a href="/orders" class="btn-action btn-back">
                                        <i class="fas fa-arrow-left"></i> Back to Orders
                                    </a>

                                    <% if (order.status==='Delivered' ) { %>
                                        <button class="btn-action btn-invoice"
                                            onclick="downloadInvoice('<%= order.orderId %>')">
                                            <i class="fas fa-download"></i> Download Invoice
                                        </button>

                                        <button class="btn-action btn-return"
                                            onclick="returnOrder('<%= order.orderId %>')">
                                            <i class="fas fa-undo"></i> Return Order
                                        </button>
                                        <% } %>
                                </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cancel Product Modal -->
        <div id="cancelProductModal" class="modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h3><i class="fas fa-times-circle"></i> Cancel Product</h3>
                    <span class="close" onclick="closeCancelProductModal()">&times;</span>
                </div>
                <div class="modal-body">
                    <p>Please select a reason for canceling this product:</p>
                    <select id="cancelReason" class="form-select">
                        <option value="">-- Select Reason --</option>
                        <option value="Ordered by mistake">Ordered by mistake</option>
                        <option value="Found a better price">Found a better price</option>
                        <option value="Delivery taking too long">Delivery taking too long</option>
                        <option value="Product not needed anymore">Product not needed anymore</option>
                        <option value="Other">Other</option>
                    </select>
                    <textarea id="cancelOtherReason" class="reason-textarea" placeholder="Enter your reason..."
                        style="display: none;"></textarea>

                    <div class="modal-buttons">
                        <button class="btn-modal btn-modal-cancel" onclick="closeCancelProductModal()">Back</button>
                        <button class="btn-modal btn-modal-confirm" onclick="confirmCancelProduct()">Confirm
                            Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Return Product Modal -->
        <div id="returnProductModal" class="modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h3><i class="fas fa-undo"></i> Return Product</h3>
                    <span class="close" onclick="closeReturnProductModal()">&times;</span>
                </div>
                <div class="modal-body">
                    <p>Please select a reason for returning this product:</p>
                    <select id="returnReason" class="form-select">
                        <option value="">-- Select Reason --</option>
                        <option value="Received damaged product">Received damaged product</option>
                        <option value="Wrong item delivered">Wrong item delivered</option>
                        <option value="Product not as described">Product not as described</option>
                        <option value="Other">Other</option>
                    </select>
                    <textarea id="returnOtherReason" class="reason-textarea" placeholder="Enter your reason..."
                        style="display: none;"></textarea>

                    <div class="modal-buttons">
                        <button class="btn-modal btn-modal-cancel" onclick="closeReturnProductModal()">Back</button>
                        <button class="btn-modal btn-modal-return" onclick="confirmReturnProduct()">Confirm
                            Return</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            let selectedOrderId = null;
            let selectedProductId = null;

            // Cancel Product Modal Functions
            function cancelProduct(orderId, productId) {
                selectedOrderId = orderId;
                selectedProductId = productId;
                document.getElementById('cancelProductModal').style.display = 'block';
            }

            function closeCancelProductModal() {
                document.getElementById('cancelProductModal').style.display = 'none';
                document.getElementById('cancelReason').value = '';
                document.getElementById('cancelOtherReason').style.display = 'none';
            }

            document.getElementById('cancelReason').addEventListener('change', function () {
                document.getElementById('cancelOtherReason').style.display = this.value === 'Other' ? 'block' : 'none';
            });

            function confirmCancelProduct() {
                const reason = document.getElementById('cancelReason').value;
                const other = document.getElementById('cancelOtherReason').value;

                if (!reason && !other) {
                    swal("Please select or enter a reason!");
                    return;
                }

                const finalReason = reason === 'Other' ? other : reason;

                fetch(`/orders/${selectedOrderId}/items/${selectedProductId}/cancel`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason: finalReason })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            swal("Cancelled!", "Your product has been canceled successfully.", "success")
                                .then(() => location.reload());
                        } else {
                            swal("Error!", data.message || "Something went wrong.", "error");
                        }
                    });

                closeCancelProductModal();
            }

            // Return Product Modal Functions
            function returnProduct(orderId, productId) {
                selectedOrderId = orderId;
                selectedProductId = productId;
                document.getElementById('returnProductModal').style.display = 'block';
            }

            function closeReturnProductModal() {
                document.getElementById('returnProductModal').style.display = 'none';
                document.getElementById('returnReason').value = '';
                document.getElementById('returnOtherReason').style.display = 'none';
            }

            document.getElementById('returnReason').addEventListener('change', function () {
                document.getElementById('returnOtherReason').style.display = this.value === 'Other' ? 'block' : 'none';
            });

            function confirmReturnProduct() {
                const reason = document.getElementById('returnReason').value;
                const other = document.getElementById('returnOtherReason').value;

                if (!reason && !other) {
                    swal("Please select or enter a reason!");
                    return;
                }

                const finalReason = reason === 'Other' ? other : reason;

                fetch(`/returnProduct/${selectedOrderId}/${selectedProductId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason: finalReason })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            swal("Returned!", "Your return request has been submitted.", "success")
                                .then(() => location.reload());
                        } else {
                            swal("Error!", data.message || "Something went wrong.", "error");
                        }
                    });

                closeReturnProductModal();
            }

            // Close modal when clicking outside
            window.onclick = function (event) {
                const cancelModal = document.getElementById('cancelProductModal');
                const returnModal = document.getElementById('returnProductModal');
                if (event.target === cancelModal) cancelModal.style.display = 'none';
                if (event.target === returnModal) returnModal.style.display = 'none';
            };

            // Invoice download (optional)
            function downloadInvoice(orderId) {
                window.location.href = `/invoice/${orderId}`;
            }
        </script>

        <%- include('../partials/user/footer.ejs') %>
</body>

</html>