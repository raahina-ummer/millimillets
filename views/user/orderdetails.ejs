<div class="order-summary-wrapper">

<!-- ================= ORDER SUMMARY ================= -->
<div class="order-summary">
  <h3 class="summary-title">Order Summary</h3>

  <!-- Subtotal (MRP) -->
  <div class="summary-row">
    <span class="summary-label">
      Subtotal (<%= order.orderedProducts.length %> items)
    </span>
    <span class="summary-value">
      ₹<%= (order.totalPrice || 0).toFixed(2) %>
    </span>
  </div>

  <!-- Product Discount -->
  <% if (typeof order.discount === 'number' && order.discount > 0) { %>
    <div class="summary-row">
      <span class="summary-label">Product Discount</span>
      <span class="summary-value discount">
        -₹<%= order.discount.toFixed(2) %>
      </span>
    </div>
  <% } %>

  <!-- Sale Total -->
  <div class="summary-row">
    <span class="summary-label"><strong>Sale Total</strong></span>
    <span class="summary-value">
      ₹<%= ((order.totalPrice || 0) - (order.discount || 0)).toFixed(2) %>
    </span>
  </div>

  <!-- Coupon Discount -->
  <% if (typeof order.couponDiscount === 'number' && order.couponDiscount > 0) { %>
    <div class="summary-row">
      <span class="summary-label">
        Coupon Discount
        <% if (order.couponCode) { %>
          (<%= order.couponCode %>)
        <% } %>
      </span>
      <span class="summary-value discount">
        -₹<%= order.couponDiscount.toFixed(2) %>
      </span>
    </div>
  <% } %>

  <!-- Shipping Cost -->
  <div class="summary-row">
    <span class="summary-label">Shipping Cost</span>
    <span class="summary-value">
      <% if (!order.shippingCost || order.shippingCost === 0) { %>
        <span class="free-shipping">FREE</span>
      <% } else { %>
        ₹<%= order.shippingCost.toFixed(2) %>
      <% } %>
    </span>
  </div>

  <hr class="summary-divider">

  <!-- Total Before Wallet -->
  <div class="summary-row total">
    <span class="summary-label"><strong>Total </strong></span>
    <span class="summary-value">
      <strong>
        ₹<%= (
          ((order.totalPrice || 0) - (order.discount || 0) - (order.couponDiscount || 0))
          + (order.shippingCost || 0)
        ).toFixed(2) %>
      </strong>
    </span>
  </div>

  <!-- Wallet Used -->
  <% if (typeof order.walletUsed === 'number' && order.walletUsed > 0) { %>
    <div class="summary-row">
      <span class="summary-label">Wallet Used</span>
      <span class="summary-value discount">
        -₹<%= order.walletUsed.toFixed(2) %>
      </span>
    </div>
  <% } %>

  <hr class="summary-divider">

  <!-- Final Paid Amount -->
  <div class="summary-row final-paid">
    <span class="summary-label"><strong>Amount Paid</strong></span>
    <span class="summary-value">
      <strong>₹<%= (order.finalAmount || 0).toFixed(2) %></strong>
    </span>
  </div>
</div>

