            <!-- Cancel Product Modal -->
            <div id="cancelProductModal" class="modal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3><i class="fas fa-times-circle"></i> Cancel Product</h3>
                        <span class="close" onclick="closeCancelProductModal()">&times;</span>
                    </div>
                    <div class="modal-body">
                        <p>Please select a reason for canceling this product:</p>
                        <select id="cancelReason" class="form-select">
                            <option value="">-- Select Reason --</option>
                            <option value="Ordered by mistake">Ordered by mistake</option>
                            <option value="Found a better price">Found a better price</option>
                            <option value="Delivery taking too long">Delivery taking too long</option>
                            <option value="Product not needed anymore">Product not needed anymore</option>
                            <option value="Other">Other</option>
                        </select>
                        <textarea id="cancelOtherReason" class="reason-textarea" placeholder="Enter your reason..."
                            style="display: none;"></textarea>

                        <div class="modal-buttons">
                            <button class="btn-modal btn-modal-cancel" onclick="closeCancelProductModal()">Back</button>
                            <button class="btn-modal btn-modal-confirm" onclick="confirmCancelProduct()">Confirm
                                Cancel</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Return Product Modal -->
            <div id="returnProductModal" class="modal">
                <div class="modal-content">
                    <div class="modal-header">
                        <h3><i class="fas fa-undo"></i> Return Product</h3>
                        <span class="close" onclick="closeReturnProductModal()">&times;</span>
                    </div>
                    <div class="modal-body">
                        <p>Please select a reason for returning this product:</p>
                        <select id="returnReason" class="form-select">
                            <option value="">-- Select Reason --</option>
                            <option value="Received damaged product">Received damaged product</option>
                            <option value="Wrong item delivered">Wrong item delivered</option>
                            <option value="Product not as described">Product not as described</option>
                            <option value="Other">Other</option>
                        </select>
                        <textarea id="returnOtherReason" class="reason-textarea" placeholder="Enter your reason..."
                            style="display: none;"></textarea>

                        <div class="modal-buttons">
                            <button class="btn-modal btn-modal-cancel" onclick="closeReturnProductModal()">Back</button>
                            <button class="btn-modal btn-modal-return" onclick="confirmReturnProduct()">Confirm
                                Return</button>
                        </div>
                    </div>
                </div>
            </div>

            
            <script>
                let selectedOrderId = null;
                let selectedProductId = null;

                // Cancel Product Modal Functions
                function cancelProduct(orderId, productId) {
                    selectedOrderId = orderId;
                    selectedProductId = productId;
                    document.getElementById('cancelProductModal').style.display = 'block';
                }

                function closeCancelProductModal() {
                    document.getElementById('cancelProductModal').style.display = 'none';
                    document.getElementById('cancelReason').value = '';
                    document.getElementById('cancelOtherReason').style.display = 'none';
                }

                document.getElementById('cancelReason').addEventListener('change', function () {
                    document.getElementById('cancelOtherReason').style.display = this.value === 'Other' ? 'block' : 'none';
                });

                function confirmCancelProduct() {
                    const reason = document.getElementById('cancelReason').value;
                    const other = document.getElementById('cancelOtherReason').value;

                    if (!reason && !other) {
                        swal("Please select or enter a reason!");
                        return;
                    }

                    const finalReason = reason === 'Other' ? other : reason;

                    fetch(`/orders/${selectedOrderId}/items/${selectedProductId}/cancel`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason: finalReason })
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                swal("Cancelled!", "Your product has been canceled successfully.", "success")
                                    .then(() => location.reload());
                            } else {
                                swal("Error!", data.message || "Something went wrong.", "error");
                            }
                        });

                    closeCancelProductModal();
                }

                // Return Product Modal Functions
                function returnProduct(orderId, productId) {
                    selectedOrderId = orderId;
                    selectedProductId = productId;
                    document.getElementById('returnProductModal').style.display = 'block';
                }

                function closeReturnProductModal() {
                    document.getElementById('returnProductModal').style.display = 'none';
                    document.getElementById('returnReason').value = '';
                    document.getElementById('returnOtherReason').style.display = 'none';
                }

                document.getElementById('returnReason').addEventListener('change', function () {
                    document.getElementById('returnOtherReason').style.display = this.value === 'Other' ? 'block' : 'none';
                });

                function confirmReturnProduct() {
                    const reason = document.getElementById('returnReason').value;
                    const other = document.getElementById('returnOtherReason').value;

                    if (!reason) {
                        swal("Error!", "Please select a reason!", "error");
                        return;
                    }

                    if (reason === 'Other' && !other.trim()) {
                        swal("Error!", "Please enter your reason!", "error");
                        return;
                    }

                    const finalReason = reason === 'Other' ? other : reason;

                    swal({
                        title: "Processing...",
                        text: "Please wait while we process your return request",
                        icon: "info",
                        buttons: false,
                        closeOnClickOutside: false,
                    });

                    // Updated URL to match new route
                    fetch(`/orders/${selectedOrderId}/return/${selectedProductId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reason: finalReason })
                    })
                        .then(res => {
                            if (!res.ok) {
                                throw new Error(`HTTP error! status: ${res.status}`);
                            }
                            return res.json();
                        })
                        .then(data => {
                            closeReturnProductModal();
                            if (data.success) {
                                swal("Success!", data.message, "success")
                                    .then(() => location.reload());
                            } else {
                                swal("Error!", data.message || "Something went wrong.", "error");
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            closeReturnProductModal();
                            swal("Error!", "Failed to process return request. Please try again.", "error");
                        });
                }

                // Close modal when clicking outside
                window.onclick = function (event) {
                    const cancelModal = document.getElementById('cancelProductModal');
                    const returnModal = document.getElementById('returnProductModal');
                    if (event.target === cancelModal) cancelModal.style.display = 'none';
                    if (event.target === returnModal) returnModal.style.display = 'none';
                };
                
        // Download Invoice
        async function downloadInvoice(orderId) {
            try {
                const response = await fetch(`/orders/${orderId}/invoice`);
                
                if (response.ok) {
                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `MilliMillet-Invoice-${orderId}.pdf`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                    
                    swal("Success!", "Invoice downloaded successfully", "success");
                } else {
                    swal("Error!", "Failed to download invoice", "error");
                }
            } catch (error) {
                console.error('Error:', error);
                swal("Error!", "Something went wrong. Please try again.", "error");
            }
        }


          async function retryPayment(orderId, amount) {
    console.log(" Retry Payment Started:", orderId, amount); // ✅ Check if function runs
    
    try {
        // Show loading
        swal({
            title: "Processing...",
            text: "Please wait",
            icon: "info",
            buttons: false,
            closeOnClickOutside: false
        });

        console.log("📡 Fetching /create-retry-order..."); // ✅ Check if fetch starts

        // Create new Razorpay order for retry
        const response = await fetch('/create-retry-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: orderId })
        });

        console.log("Response received:", response.status); // ✅ Check response status

        const data = await response.json();
        console.log(" Response data:", data); // ✅ Check data
        
        if (!data.success) {
            console.error("❌ Error:", data.message);
            swal("Error", data.message, "error");
            return;
        }

        swal.close();
        console.log(" Opening Razorpay modal...");

     

        // Open Razorpay modal
        const options = {
            key: data.key,
            amount: data.order.amount,
            currency: "INR",
            name: "Milli Millet Ecommerce",
            description: "Retry Payment for Order #" + orderId,
            order_id: data.order.id,
            handler: async function (response) {
                // Payment success
                const verifyRes = await fetch("/verify-payment", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        paymentResponse: response,
                        orderId: orderId  // Pass original orderId
                    })
                });

                const verifyData = await verifyRes.json();

                if (verifyData.success) {
                    swal("Success!", "Payment successful!", "success")
                        .then(() => {
                            window.location.href = `/ordersuccess?orderId=${orderId}`;
                        });
                } else {
                    swal("Error", verifyData.message, "error");
                }
            },
            modal: {
                ondismiss: function() {
                    swal("Cancelled", "Payment was cancelled", "warning");
                }
            },
            theme: { color: "#3399cc" }
        };

        const rzp = new Razorpay(options);
        
        rzp.on('payment.failed', function (response) {
            swal("Payment Failed", response.error.description, "error");
        });
        
        rzp.open();

    } catch (error) {
        console.error(error);
        swal("Error", "Something went wrong", "error");
    }
}









window.retryPayment = async function (orderId) {
  console.log("🔥 Retry Payment clicked:", orderId);

  try {
    swal({
      title: "Processing...",
      text: "Please wait",
      icon: "info",
      buttons: false,
      closeOnClickOutside: false
    });

    // 🔥 MUST include credentials
    const response = await fetch('/create-retry-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: "include",
      body: JSON.stringify({ orderId })
    });

    const data = await response.json();
    console.log("Retry order response:", data);

    if (!data.success) {
      swal("Error", data.message || "Retry failed", "error");
      return;
    }

    swal.close();

    const options = {
      key: data.key,
      amount: data.order.amount,
      currency: "INR",
      name: "Milli Millet Ecommerce",
      description: "Retry Payment for Order #" + orderId,
      order_id: data.order.id,

      handler: async function (response) {
        const verifyRes = await fetch("/verify-payment", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({
            paymentResponse: response
          })
        });

        const verifyData = await verifyRes.json();

        if (verifyData.success) {
          swal("Success!", "Payment successful!", "success")
            .then(() => {
              window.location.href =
                `/ordersuccess?orderId=${verifyData.orderId}`;
            });
        } else {
          swal("Error", verifyData.message || "Verification failed", "error");
        }
      },

      modal: {
        ondismiss: function () {
          swal("Cancelled", "Payment was cancelled", "warning");
        }
      },

      theme: { color: "#3399cc" }
    };

    const rzp = new Razorpay(options);

    rzp.on('payment.failed', function (response) {
      swal("Payment Failed", response.error.description, "error");
    });

    rzp.open();

  } catch (error) {
    console.error("Retry payment error:", error);
    swal("Error", "Something went wrong", "error");
  }
};

</script>


