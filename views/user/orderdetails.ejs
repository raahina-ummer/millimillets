<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details | MilliMillet</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"></script>
        <style>
* {
    font-family: 'Nunito Sans', sans-serif;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #E8DCC4;
}

.order-detail-wrapper {
    background-color: #E8DCC4;
    min-height: 100vh;
    padding: 40px 0;
}

.order-detail-container {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 30px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ========== SECTION CARDS ========== */
.detail-section {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(139, 115, 85, 0.08);
    margin-bottom: 25px;
    overflow: hidden;
}

.section-header {
    background: linear-gradient(135deg, #8B7355 0%, #755e45 100%);
    padding: 18px 25px;
}

.section-header h3 {
    margin: 0;
    color: white;
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.section-content {
    padding: 25px;
}

/* ========== ORDER HEADER INFO ========== */
.order-header-info {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.info-item {
    text-align: center;
    padding: 20px 15px;
    background: linear-gradient(135deg, #f9f6f1 0%, #E8DCC4 100%);
    border-radius: 10px;
    border: 2px solid #d4c5b0;
    transition: all 0.3s ease;
}

.info-item:hover {
    border-color: #8B7355;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(139, 115, 85, 0.15);
}

.info-label {
    font-size: 0.75rem;
    color: #755e45;
    margin-bottom: 8px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

.info-value {
    font-size: 1.1rem;
    color: #333;
    font-weight: 700;
}

/* ========== STATUS BADGES ========== */
.order-status {
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    display: inline-block;
    letter-spacing: 0.5px;
}

.status-pending { background: #f2e4b6; color: #856404; }
.status-processing { background: #afc2de; color: #084298; }
.status-shipped { background: #a7dbc4; color: #0f5132; }
.status-delivered { background: #b3d3af; color: #155724; }
.status-canceled, .status-cancelled { background: #d6a9ad; color: #842029; }
.status-return-request { background: #c9bfa1; color: #664d03; }
.status-returned { background: #9eafd4; color: #41464b; }

/* ========== TIMELINE ========== */
.timeline {
    position: relative;
    padding: 20px 0;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, #8B7355 0%, #d4c5b0 100%);
}

.timeline-item {
    position: relative;
    padding-left: 60px;
    margin-bottom: 30px;
}

.timeline-item:last-child {
    margin-bottom: 0;
}

.timeline-icon {
    position: absolute;
    left: 8px;
    top: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #8B7355;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    box-shadow: 0 2px 8px rgba(139, 115, 85, 0.3);
    z-index: 1;
}

.timeline-icon.pending {
    background: #d4c5b0;
    color: #8B7355;
}

.timeline-content h4 {
    margin: 0 0 6px;
    color: #333;
    font-weight: 700;
    font-size: 1rem;
}

.timeline-content p {
    margin: 0;
    color: #666;
    font-size: 0.9rem;
    line-height: 1.5;
}

.timeline-date {
    font-size: 0.8rem;
    color: #999;
    margin-top: 6px;
    font-weight: 600;
}

/* ========== PRODUCT ITEMS ========== */
.product-item {
    display: flex;
    gap: 20px;
    padding: 20px;
    background: #f9f6f1;
    border-radius: 10px;
    margin-bottom: 15px;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    align-items: center;
}

.product-item:hover {
    background: #f0eae0;
    border-color: #d4c5b0;
}

.product-item:last-child {
    margin-bottom: 0;
}

.product-image {
    width: 90px;
    height: 90px;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid #d4c5b0;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.product-details {
    flex: 1;
    min-width: 0;
}

.product-name {
    font-weight: 700;
    color: #333;
    margin: 0 0 8px;
    font-size: 1rem;
}

.product-price {
    color: #8B7355;
    font-weight: 700;
    margin-bottom: 6px;
    font-size: 0.95rem;
}

.product-quantity {
    color: #755e45;
    font-size: 0.85rem;
    font-weight: 600;
}

.product-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-end;
    justify-content: center;
    min-width: 140px;
}

.product-total {
    font-weight: 700;
    color: #8B7355;
    font-size: 1.2rem;
    margin-bottom: 5px;
}

.btn-product {
    padding: 8px 20px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.8rem;
    border: 2px solid #8B7355;
    background: white;
    color: #8B7355;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
    min-width: 120px;
}

.btn-product:hover {
    background: #8B7355;
    color: white;
    transform: translateY(-2px);
}

.btn-product.return {
    border-color: #ffc107;
    color: #ffc107;
}

.btn-product.return:hover {
    background: #ffc107;
    color: #333;
}

.btn-product.cancel {
    border-color: #dc3545;
    color: #dc3545;
}

.btn-product.cancel:hover {
    background: #dc3545;
    color: white;
}

.btn-product:disabled {
    background: #e9ecef;
    border-color: #dee2e6;
    color: #6c757d;
    cursor: not-allowed;
    opacity: 0.6;
}

/* ========== ADDRESS CARD ========== */
.address-card {
    background: linear-gradient(135deg, #f9f6f1 0%, #E8DCC4 100%);
    border-radius: 10px;
    padding: 25px;
    border-left: 4px solid #8B7355;
}

.address-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    padding-bottom: 15px;
    border-bottom: 2px solid rgba(212, 197, 176, 0.5);
}

.recipient-info {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.recipient-info h4 {
    margin: 0;
    font-size: 1.1rem;
    color: #333;
    font-weight: 700;
}

.badge {
    display: inline-block;
  color: #333; 
    padding: 5px 12px;
    border-radius: 15px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.badge-home { background: #8B7355; color: white; }
.badge-work { background: #d4c5b0; color: #333; }

.badge-completed, .badge-success { background: #02290b; color: #032f0d; }
.badge-pending { background: #f2bb06; color: #856404; }
.badge-failed { background: #f8d7da; color: #721c24; }
.badge-razorpay {
  background: #04414c;
  color: #0c5460;
}

.badge-cod {
  background: #e9b302;
  color: #856404;
}

.badge-wallet {
  background: #233202;
  color: #155724;
}


.address-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.detail-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
}

.detail-item i {
    color: #8B7355;
    font-size: 16px;
    margin-top: 3px;
    min-width: 20px;
}

.detail-item span {
    color: #666;
    line-height: 1.6;
    font-size: 0.9rem;
}

.address-text p {
    color: #666;
    line-height: 1.6;
    margin: 0 0 4px;
    font-size: 0.9rem;
}

/* ========== ORDER SUMMARY SIDEBAR ========== */
.order-summary-wrapper {
    position: sticky;
    top: 20px;
}

.order-summary {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(139, 115, 85, 0.08);
    padding: 25px;
    margin-bottom: 20px;
}

.summary-title {
    margin: 0 0 20px;
    color: #8B7355;
    font-weight: 700;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 3px solid #E8DCC4;
    padding-bottom: 12px;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 0.9rem;
}

.summary-row.total {
    font-size: 1.1rem;
    color: #333;
    padding-top: 12px;
    margin-top: 12px;
    border-top: 2px solid #E8DCC4;
}

.summary-row.final-paid {
    font-size: 1.3rem;
    color: #8B7355;
    padding-top: 12px;
}

.summary-label {
    color: #666;
    font-weight: 600;
}

.summary-value {
    color: #333;
    font-weight: 700;
}

.discount {
    color: #28a745;
    font-weight: 600;
}

.free-shipping {
    color: #28a745;
    font-weight: 700;
}

.summary-divider {
    border: none;
    border-top: 1px solid #E8DCC4;
    margin: 15px 0;
}

.payment-info {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 2px solid #E8DCC4;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.payment-info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.payment-info-label {
    font-size: 0.85rem;
    color: #666;
    font-weight: 600;
}

/* ========== ACTION BUTTONS ========== */
.action-buttons-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(139, 115, 85, 0.08);
    padding: 20px;
}

.action-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.btn-action {
    width: 100%;
    padding: 14px 20px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.btn-back {
    background: #f9f6f1;
    color: #8B7355;
    border: 2px solid #d4c5b0;
}

.btn-back:hover {
    background: #E8DCC4;
    border-color: #8B7355;
    text-decoration: none;
    color: #8B7355;
}

.btn-invoice {
    background: #8B7355;
    color: white;
}

.btn-invoice:hover {
    background: #755e45;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(139, 115, 85, 0.3);
}

.btn-return {
    background: #ffc107;
    color: #333;
}

.btn-return:hover {
    background: #e0a800;
    transform: translateY(-2px);
}

/* ========== MODAL STYLES ========== */
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(5px);
}

.modal-content {
    background-color: white;
    margin: 8% auto;
    padding: 0;
    border-radius: 12px;
    width: 90%;
    max-width: 550px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.modal-header {
    padding: 20px 25px;
    border-bottom: 2px solid #E8DCC4;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, #f9f6f1 0%, #E8DCC4 100%);
    border-radius: 12px 12px 0 0;
}

.modal-header h3 {
    margin: 0;
    color: #8B7355;
    font-weight: 700;
    font-size: 1.2rem;
}

.close {
    font-size: 28px;
    font-weight: bold;
    color: #8B7355;
    cursor: pointer;
    transition: all 0.3s;
    line-height: 1;
}

.close:hover {
    color: #755e45;
    transform: rotate(90deg);
}

.modal-body {
    padding: 25px;
}

.modal-body p {
    color: #666;
    margin-bottom: 15px;
    line-height: 1.6;
}

.form-label {
    display: block;
    margin-bottom: 8px;
    color: #755e45;
    font-weight: 700;
    font-size: 0.9rem;
}

.form-select,
.reason-textarea {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid #d4c5b0;
    border-radius: 8px;
    font-size: 0.9rem;
    transition: all 0.3s;
    font-family: 'Nunito Sans', sans-serif;
}

.form-select:focus,
.reason-textarea:focus {
    border-color: #8B7355;
    outline: none;
    box-shadow: 0 0 0 3px rgba(139, 115, 85, 0.1);
}

.reason-textarea {
    min-height: 100px;
    resize: vertical;
    margin-top: 12px;
}

.modal-buttons {
    display: flex;
    gap: 12px;
    margin-top: 20px;
}

.btn-modal {
    flex: 1;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: all 0.3s;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-size: 0.85rem;
}

.btn-modal-cancel {
    background: #f9f6f1;
    color: #8B7355;
    border: 2px solid #d4c5b0;
}

.btn-modal-cancel:hover {
    background: #E8DCC4;
}

.btn-modal-confirm {
    background: #dc3545;
    color: white;
}

.btn-modal-confirm:hover {
    background: #bb2d3b;
    transform: translateY(-2px);
}

.btn-modal-return {
    background: #ffc107;
    color: #333;
}

.btn-modal-return:hover {
    background: #e0a800;
    transform: translateY(-2px);
}

/* ========== BREADCRUMB ========== */
.breadcrumb {
    background: none;
    padding: 0;
    margin-bottom: 30px;
}

.breadcrumb-item a {
    color: #8B7355;
    text-decoration: none;
    font-weight: 600;
}

.breadcrumb-item a:hover {
    color: #755e45;
    text-decoration: underline;
}

.breadcrumb-item.active {
    color: #755e45;
    font-weight: 600;
}


.btn-retry {
  position: relative;
  z-index: 9999;
  pointer-events: auto;
}

/* ========== RESPONSIVE DESIGN ========== */
@media (max-width: 1024px) {
    .order-detail-container {
        grid-template-columns: 1fr;
    }

    .order-summary-wrapper {
        order: -1;
        position: static;
    }
}

@media (max-width: 768px) {
    .order-header-info {
        grid-template-columns: repeat(2, 1fr);
    }

    .product-item {
        flex-direction: column;
        align-items: flex-start;
    }

    .product-image {
        width: 100%;
        height: 200px;
    }

    .product-actions {
        width: 100%;
        align-items: stretch;
    }

    .btn-product {
        width: 100%;
    }

    .product-total {
        text-align: left;
    }
}

@media (max-width: 480px) {
    .order-header-info {
        grid-template-columns: 1fr;
    }

    .info-item {
        padding: 15px;
    }

    .section-content {
        padding: 15px;
    }

    .order-detail-container {
        padding: 0 10px;
    }
}
    </style>

</head>

<body>
    <%- include("../partials/user/header.ejs") %>

        <div class="order-detail-wrapper">
            <div class="container">
                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb" style="background: none; padding: 0;">
                        <li class="breadcrumb-item"><a href="/" style="color: #8B7355; text-decoration: none;">Home</a>
                        </li>
                        <li class="breadcrumb-item"><a href="/orders" style="color: #8B7355; text-decoration: none;">My
                                Orders</a></li>
                        <li class="breadcrumb-item active" style="color: #755e45;">Order #<%= order.orderId %>
                        </li>
                    </ol>
                </nav>

                <div class="order-detail-container">
                    <!-- Left Column -->
                    <div>
                        <!-- Order Details Header -->
                        <div class="detail-section">
                            <div class="section-header">
                                <h3><i class="fas fa-receipt"></i> Order Details</h3>
                            </div>
                            <div class="section-content">
                                <div class="order-header-info">
                                    <div class="info-item">
                                        <div class="info-label">Order ID</div>
                                        <div class="info-value">#<%= order.orderId %>
                                        </div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Order Date</div>
                                        <div class="info-value">
                                            <%= new Date(order.createdOn).toLocaleDateString('en-US', { month: 'short' ,
                                                day: 'numeric' , year: 'numeric' }) %>
                                        </div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Status</div>
                                        <div class="info-value">
                                            <span
                                                class="order-status status-<%= order.status.toLowerCase().replace(/\s+/g, '-') %>">
                                                <%= order.status %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="info-item">
                                        <div class="info-label">Total Amount</div>
                                        <div class="info-value">₹<%= order.finalAmount.toFixed(2) %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Order Timeline -->
                        <div class="detail-section">
                            <div class="section-header">
                                <h3><i class="fas fa-clock"></i> Order Timeline</h3>
                            </div>
                            <div class="section-content">
                                <div class="timeline">
                                    <% const statusOrder=['Pending', 'Processing' , 'Shipped' , 'Delivered' ]; const
                                        currentStatusIndex=statusOrder.indexOf(order.status); const timelineEvents=[ {
                                        status: 'Delivered' , title: 'Order Delivered' ,
                                        desc: 'Your order has been successfully delivered' }, { status: 'Shipped' ,
                                        title: 'Order Shipped' , desc: 'Your order is on the way' }, {
                                        status: 'Processing' , title: 'Order Processing' ,
                                        desc: 'Your order is being prepared' }, { status: 'Pending' ,
                                        title: 'Order Confirmed' , desc: 'Your order has been placed successfully' } ];
                                        %>
                                        <% timelineEvents.forEach((event, index)=> {
                                            const eventIndex = statusOrder.indexOf(event.status);
                                            const isCompleted = currentStatusIndex >= eventIndex;
                                            %>
                                            <div class="timeline-item">
                                                <div class="timeline-icon <%= isCompleted ? '' : 'pending' %>">
                                                    <i class="fas fa-check"></i>
                                                </div>
                                                <div class="timeline-content">
                                                    <h4>
                                                        <%= event.title %>
                                                    </h4>
                                                    <p>
                                                        <%= event.desc %>
                                                    </p>
                                                    <% if (isCompleted) { %>
                                                        <div class="timeline-date">
                                                            <%= new Date(order.createdOn).toLocaleString('en-US', {
                                                                month: 'short' , day: 'numeric' , year: 'numeric' ,
                                                                hour: 'numeric' , minute: 'numeric' , hour12: true }) %>
                                                        </div>
                                                        <% } %>
                                                </div>
                                            </div>
                                            <% }); %>
                                </div>
                            </div>
                        </div>

                        <!-- Order Items -->
                        <div class="section-content">
                            <% order.orderedProducts.forEach(item=> { %>
                                <div class="product-item">
                                    <div class="product-image">
                                        <img src="<%= item.product && item.product.productImage && item.product.productImage[0] 
                         ? '/uploads/images/' + item.product.productImage[0] 
                            : '/placeholder.jpg' %>"
                                            alt="<%= item.product ? item.product.productName : 'Product Image' %>" />
                                    </div>

                                    <div class="product-details">
                                        <h4 class="product-name">
                                            <%= item.product.productName %>
                                        </h4>
                                        <div class="product-price">₹<%= item.price.toFixed(2) %>
                                        </div>
                                        <div class="product-quantity">Quantity: <%= item.quantity %>
                                        </div>
                                    </div>

                                    <div class="product-actions">
                                        <span
                                            class="order-status status-<%= (item.status || order.status).toLowerCase().replace(/\s+/g, '-') %>">
                                            <%= item.status || order.status %>
                                        </span>
                                        <div class="product-total">₹<%= (item.price * item.quantity).toFixed(2) %>
                                        </div>

                                        <!-- Show Cancel button only if item is NOT already cancelled -->
                                        <% if ((order.status==='Pending' || order.status==='Processing' ) && item.status
                                            !=='Cancelled' ) { %>
                                            <button class="btn-product cancel"
                                                onclick="cancelProduct('<%= order.orderId %>', '<%= item.product._id %>')">
                                                <i class="fas fa-times-circle"></i> Cancel
                                            </button>
                                            <% } %>

                                                <!-- Show Cancelled status if item is cancelled -->
                                                <% if (item.status==='Cancelled' ) { %>
                                                    <button class="btn-product" disabled
                                                        style="background: #6c757d; cursor: not-allowed; opacity: 0.6;">
                                                        <i class="fas fa-ban"></i> Cancelled
                                                    </button>
                                                    <% } %>

                                                        <!-- Show Return button only if delivered and NOT cancelled -->
                                                        <% if (order.status==='Delivered' && item.status !=='Cancelled'
                                                            ) { %>
                                                            <button class="btn-product return"
                                                                onclick="returnProduct('<%= order.orderId %>', '<%= item.product._id %>')">
                                                                <i class="fas fa-undo"></i> Return
                                                            </button>
                                                            <% } %>
                                    </div>
                                </div>
                                <% }); %>
                        </div>
