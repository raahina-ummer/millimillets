    function createReferralOffer() {
        window.location.href = '/admin/referral-offers';
    }

    // Close modals when clicking outside
    window.addEventListener('click', function(event) {
        if (event.target === categoryModal) closeCategoryOfferModal();
        if (event.target === productModal) closeProductOfferModal();
        if (event.target === referralModal) closeReferralOfferModal();
    });
</script>

