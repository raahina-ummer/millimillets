    function generateReferralCoupon(offerId) {
        Swal.fire({
            title: 'Generate Coupon',
            text: 'Generate a coupon for this referral offer?',
            icon: 'info',
            showCancelButton: true,
            confirmButtonColor: '#8b7355',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Generate'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/admin/referral-coupon/generate`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ referralOfferId: offerId, expiryDays: 30 })
                }).then(() => {
                    Swal.fire('Success!', 'Coupon generated successfully!', 'success');
                });
