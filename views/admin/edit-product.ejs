// GST input formatting
document.getElementById('gst').addEventListener('blur', function(e) {
    let value = e.target.value.trim();
    if (value && !value.endsWith('%')) {
        e.target.value = value + '%';
    }
});

// Form validation
function validateForm() {
    clearErrorMessages();

    const name = document.getElementById('productName').value.trim();
    const description = document.getElementById('description').value.trim();
    const regularPrice = document.getElementById('regularPrice').value.trim();
    const salePrice = document.getElementById('salePrice').value.trim();
    const quantity = document.getElementById('quantity').value.trim();
    const stock = document.getElementById('stock').value.trim();
    const category = document.getElementById('category').value;
    const weight = document.getElementById('weight').value.trim();
    const gst = document.getElementById('gst').value.trim();

    // Check existing images
    const existingImageInputs = document.querySelectorAll('[id^="imageDatas-"]');
    
    // Check new image inputs
    const newImageInputs = [
        document.getElementById('input1'),
        document.getElementById('input2'),
        document.getElementById('input3'),
        document.getElementById('input4')
    ];

    let isValid = true;

    // Product name validation
    if (name === "") {
        displayErrorMessage('productName-error', 'Product name is required.');
        isValid = false;
    } else if (name.length < 3) {
        displayErrorMessage('productName-error', 'Product name must be at least 3 characters long.');
        isValid = false;
    } else if (name.length > 100) {
        displayErrorMessage('productName-error', 'Product name must not exceed 100 characters.');
        isValid = false;
    } else if (!/^[a-zA-Z]/.test(name)) {
        displayErrorMessage('productName-error', 'Product name must start with a letter.');
        isValid = false;
    } else if (!/^[a-zA-Z][a-zA-Z0-9\s&'-]*$/.test(name)) {
        displayErrorMessage('productName-error', 'Product name can only contain letters, numbers, spaces, and basic punctuation (&, \', -).');
        isValid = false;
    }

    // Description validation
    if (description === "") {
        displayErrorMessage('description-error', 'Product description is required.');
        isValid = false;
    } else if (description.length < 10) {
        displayErrorMessage('description-error', 'Description must be at least 10 characters long.');
        isValid = false;
    } else if (description.length > 1000) {
        displayErrorMessage('description-error', 'Description must not exceed 1000 characters.');
        isValid = false;
    }

    // Category validation
    if (category === "") {
        displayErrorMessage('category-error', 'Please select a category.');
        isValid = false;
    }

    // Weight validation
    if (weight === "") {
        displayErrorMessage('weight-error', 'Weight is required.');
        isValid = false;
    } else if (!/^\d+(\.\d{1,2})?$/.test(weight)) {
        displayErrorMessage('weight-error', 'Please enter a valid weight (numbers only, up to 2 decimal places).');
        isValid = false;
    } else if (parseFloat(weight) <= 0) {
        displayErrorMessage('weight-error', 'Weight must be greater than 0.');
        isValid = false;
    }

    // GST validation
    if (gst === "") {
        displayErrorMessage('gst-error', 'GST is required.');
        isValid = false;
    } else {
        const gstValue = gst.replace('%', '');
        if (!/^\d+(\.\d{1,2})?$/.test(gstValue)) {
            displayErrorMessage('gst-error', 'Please enter a valid GST percentage.');
            isValid = false;
        } else if (parseFloat(gstValue) < 0 || parseFloat(gstValue) > 100) {
            displayErrorMessage('gst-error', 'GST must be between 0% and 100%.');
            isValid = false;
        }
    }

    // Regular price validation
    if (regularPrice === "") {
        displayErrorMessage('regularPrice-error', 'Regular price is required.');
        isValid = false;
    } else if (!/^\d+(\.\d{1,2})?$/.test(regularPrice)) {
        displayErrorMessage('regularPrice-error', 'Please enter a valid price.');
        isValid = false;
    } else if (parseFloat(regularPrice) <= 0) {
        displayErrorMessage('regularPrice-error', 'Price must be greater than 0.');
        isValid = false;
    }

    // Sale price validation
    if (salePrice !== "") {
        if (!/^\d+(\.\d{1,2})?$/.test(salePrice)) {
            displayErrorMessage('salePrice-error', 'Please enter a valid sale price.');
            isValid = false;
        } else if (parseFloat(salePrice) < 0) {
            displayErrorMessage('salePrice-error', 'Sale price cannot be negative.');
            isValid = false;
        } else if (regularPrice !== "" && parseFloat(salePrice) >= parseFloat(regularPrice)) {
            displayErrorMessage('salePrice-error', 'Sale price must be less than regular price.');
            isValid = false;
        }
    }

    // Quantity validation
    if (quantity === "") {
        displayErrorMessage('quantity-error', 'Quantity is required.');
        isValid = false;
    } else if (!/^\d+$/.test(quantity)) {
        displayErrorMessage('quantity-error', 'Please enter a valid quantity (whole numbers only).');
        isValid = false;
    } else if (parseInt(quantity) < 0) {
        displayErrorMessage('quantity-error', 'Quantity cannot be negative.');
        isValid = false;
    }

    // Stock validation
    if (stock === "") {
        displayErrorMessage('stock-error', 'Stock is required.');
        isValid = false;
    } else if (!/^\d+$/.test(stock)) {
        displayErrorMessage('stock-error', 'Please enter a valid stock amount (whole numbers only).');
        isValid = false;
    } else if (parseInt(stock) < 0) {
        displayErrorMessage('stock-error', 'Stock cannot be negative.');
        isValid = false;
    }

    // Image validation - must have at least one (existing or new)
    const hasExistingImages = existingImageInputs.length > 0;
    const hasNewImages = newImageInputs.some(input => input.files.length > 0);

    if (!hasExistingImages && !hasNewImages) {
        displayErrorMessage("images-error-1", 'At least one product image is required.');
        isValid = false;
    }

    // Display submit error if validation fails
    const submitError = document.getElementById('submit-error');
    if (!isValid) {
        submitError.innerText = "Please fix the errors above before submitting.";
        // Scroll to first error
        const firstError = document.querySelector('.error-message:not(:empty)');
        if (firstError) {
            firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    } else {
        submitError.innerText = "";
    }

    return isValid;
}

function displayErrorMessage(id, message) {
    const errorElement = document.getElementById(id);
    if (errorElement) {
        errorElement.innerText = message;
    }
}

function clearErrorMessages() {
    document.querySelectorAll('.error-message').forEach((el) => el.innerText = '');
}

// Form submission
document.getElementById('editProductForm').addEventListener('submit', function(e) {
    e.preventDefault();

    if (validateForm()) {
        // Show loading state
        const submitBtn = document.querySelector('.btn-save');
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
        submitBtn.style.cursor = 'not-allowed';

        Swal.fire({
            title: 'Success!',
            text: 'Product updated successfully!',
            icon: 'success',
            confirmButtonText: 'OK',
            allowOutsideClick: false,
            background: '#c4a574',
            color: '#2c2c2c',
            confirmButtonColor: '#5a4a3a'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById("editProductForm").submit();
            } else {
                // Reset button if cancelled
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
                submitBtn.style.cursor = 'pointer';
            }
        });
    }
});

// Cancel button
document.querySelector('.btn-cancel').addEventListener('click', function() {
    if (formModified) {
        if (confirm('Are you sure you want to cancel? Any unsaved changes will be lost.')) {
            formModified = false;
            window.location.href = '/admin/products';
        }
    } else {
        window.location.href = '/admin/products';
    }
});

// Close cropper on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.querySelectorAll('.image-cropper.active').forEach(container => {
            container.classList.remove('active');
            const index = container.id.replace('cropperContainer', '');
            if (croppers[index]) {
                croppers[index].destroy();
            }
        });
    }
});

// Clear input when clicking outside cropper
document.querySelectorAll('.image-cropper').forEach(container => {
    container.addEventListener('click', function(e) {
        if (e.target === container) {
            const index = container.id.replace('cropperContainer', '');
            container.classList.remove('active');
            if (croppers[index]) {
                croppers[index].destroy();
            }
            // Clear the file input
            const input = document.getElementById('input' + index);
            input.value = '';
            // Hide the preview image
            const img = document.getElementById('imgView' + index);
            img.style.display = 'none';
            img.src = '';
            // Show placeholder again
            const placeholder = img.parentElement.querySelector('.upload-placeholder, .browse-text');
            if (placeholder) {
                placeholder.style.display = '';
            }
        }
    });
});

// Character counter for description
const descriptionField = document.getElementById('description');
if (descriptionField) {
    descriptionField.addEventListener('input', function() {
        const maxLength = 1000;
        const currentLength = this.value.length;
        const remaining = maxLength - currentLength;
        
        if (remaining < 100 && currentLength > 0) {
            const errorDiv = document.getElementById('description-error');
            if (!this.value.trim()) {
                errorDiv.innerText = '';
                errorDiv.style.color = '#dc3545';
            } else {
                errorDiv.innerText = `${remaining} characters remaining`;
                errorDiv.style.color = remaining < 0 ? '#dc3545' : '#666';
            }
        } else {
            const errorDiv = document.getElementById('description-error');
            if (!errorDiv.innerText.includes('required') && !errorDiv.innerText.includes('least')) {
                errorDiv.innerText = '';
            }
        }
    });
}

// Prevent form submission on Enter key (except in textarea)
document.getElementById('editProductForm').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
        e.preventDefault();
    }
});

// Confirm before leaving page with unsaved changes
let formModified = false;

document.getElementById('editProductForm').addEventListener('input', function() {
    formModified = true;
});

document.getElementById('editProductForm').addEventListener('change', function() {
    formModified = true;
});

window.addEventListener('beforeunload', function(e) {
    if (formModified) {
        e.preventDefault();
        e.returnValue = '';
        return '';
    }
});

// Reset formModified on successful submit
document.getElementById('editProductForm').addEventListener('submit', function() {
    formModified = false;
});

// Initialize console message
console.log('Edit Product form initialized successfully');
console.log('Form validation: Active');
console.log('Image cropper: Ready');
console.log('Product ID: <%= product._id %>');
</script>

