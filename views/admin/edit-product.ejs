<script>

let variantCount = <%- JSON.stringify(product?.variant?.length || 1) %>;


// Add new variant
function addVariant() {
    const container = document.getElementById('variants-container');
    const variantHTML = `
        <div class="variant-item" data-variant-index="${variantCount}">
            <button type="button" class="btn-remove-variant" onclick="removeVariant(this)">
                <i class="fas fa-times"></i>
            </button>
            
            <div class="variant-label">Variant ${variantCount + 1}</div>
            
            <div class="form-row-3">
                <div class="form-group">
                    <label>Weight</label>
                    <input type="text" name="variants[${variantCount}][weight]" class="form-control variant-weight" placeholder="500">
                    <div class="error-message"></div>
                </div>
                <div class="form-group">
                    <label>Unit</label>
                    <select class="form-select variant-unit" name="variants[${variantCount}][unit]">
                        <option value="grm">grm</option>
                        <option value="kg">kg</option>
                        <option value="ml">ml</option>
                        <option value="ltr">ltr</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Regular Price</label>
                    <input type="text" name="variants[${variantCount}][regularPrice]" class="form-control variant-regular-price" placeholder="₹">
                    <div class="error-message"></div>
                </div>
            </div>

            <div class="form-row-3">
                <div class="form-group">
                    <label>Sale Price</label>
                    <input type="text" name="variants[${variantCount}][salePrice]" class="form-control variant-sale-price" placeholder="₹">
                    <div class="error-message"></div>
                </div>
                <div class="form-group">
                    <label>Stock</label>
                    <input type="text" name="variants[${variantCount}][stock]" class="form-control variant-stock" placeholder="Available">
                    <div class="error-message"></div>
                </div>
            </div>
        </div>
    `;
    
    container.insertAdjacentHTML('beforeend', variantHTML);
    variantCount++;
    formModified = true;
    
    // Add input validation for new variant
    addVariantInputValidation();
}

// Remove variant
function removeVariant(button) {
    const variantsContainer = document.getElementById('variants-container');
    const variantItems = variantsContainer.querySelectorAll('.variant-item');
    
    if (variantItems.length <= 1) {
        Swal.fire({
            title: 'Cannot Remove',
            text: 'At least one variant is required for the product.',
            icon: 'warning',
            confirmButtonColor: '#8b7355',
            background: '#ffffff'
        });
        return;
    }
    
    Swal.fire({
        title: 'Remove Variant?',
        text: 'Are you sure you want to remove this variant?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, remove it!',
        background: '#ffffff'
    }).then((result) => {
        if (result.isConfirmed) {
            button.closest('.variant-item').remove();
            updateVariantLabels();
            formModified = true;
        }
    });
}

// Update variant labels after removal
function updateVariantLabels() {
    const variants = document.querySelectorAll('.variant-item');
    variants.forEach((variant, index) => {
        const label = variant.querySelector('.variant-label');
        if (label) {
            label.textContent = `Variant ${index + 1}`;
        }
        variant.setAttribute('data-variant-index', index);
    });
}

// Add input validation for variant fields
function addVariantInputValidation() {
    document.querySelectorAll('.variant-regular-price, .variant-sale-price, .variant-weight').forEach(input => {
        input.removeEventListener('input', handlePriceInput);
        input.addEventListener('input', handlePriceInput);
    });
    
    document.querySelectorAll('.variant-stock').forEach(input => {
        input.removeEventListener('input', handleStockInput);
        input.addEventListener('input', handleStockInput);
    });
}

function handlePriceInput(e) {
    const value = e.target.value;
    if (value && !/^\d*\.?\d{0,2}$/.test(value)) {
        e.target.value = value.slice(0, -1);
    }
}

function handleStockInput(e) {
    const value = e.target.value;
    if (value && !/^\d*$/.test(value)) {
        e.target.value = value.slice(0, -1);
    }
}

// Initialize variant input validation
addVariantInputValidation();
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
let croppers = {};

// Delete single image function
function deleteSingleImage(imageId, productId, index) {
    Swal.fire({
        title: 'Delete Image?',
        text: 'Are you sure you want to delete this image?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'Yes, delete it!',
        background: '#ffffff'
    }).then((result) => {
        if (result.isConfirmed) {
            deleteSingleImageFetch(imageId, productId, index);
        }
    });
}

// Delete image using Fetch API
async function deleteSingleImageFetch(imageId, productId, index) {
    try {
        const response = await fetch('/admin/deleteImage', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                imageNameToServer: imageId,
                productIdToServer: productId
            })
        });

        const data = await response.json();

        if (data.status === true) {
            const imageElement = document.getElementById('existing-image-' + index);
            if (imageElement) {
                imageElement.remove();
            }
            
            Swal.fire({
                title: 'Deleted!',
                text: 'Image has been deleted.',
                icon: 'success',
                confirmButtonColor: '#8b7355',
                background: '#ffffff'
            });
        } else {
            Swal.fire({
                title: 'Error!',
                text: data.error || 'Failed to delete image.',
                icon: 'error',
                confirmButtonColor: '#dc3545',
                background: '#ffffff'
            });
        }
    } catch (error) {
        console.error('Delete error:', error);
        Swal.fire({
            title: 'Error!',
            text: 'Failed to delete image.',
            icon: 'error',
            confirmButtonColor: '#dc3545',
            background: '#ffffff'
        });
    }
}

// Image preview and cropper initialization
let selectedImages = {};

function viewImage(event, index) {
  const input = event.target;
  const file = input.files[0];
  if (!file) return;

  const existingImageInputs = document.querySelectorAll(
  'input[name="existingImages[]"], input[name="existingImages"]'
);


  const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
  if (!validTypes.includes(file.type)) {
    displayErrorMessage(`images-error-${index}`, 'Invalid image type');
    input.value = '';
    return;
  }

  if (file.size > 5 * 1024 * 1024) {
    displayErrorMessage(`images-error-${index}`, 'Image must be under 5MB');
    input.value = '';
    return;
  }


  const image = document.getElementById(`imgView${index}`);
  const cropperContainer = document.getElementById(`cropperContainer${index}`);
  const croppedImage = document.getElementById(`croppedImg${index}`);
  const saveBtn = document.getElementById(`saveButton${index}`);
  const cancelBtn = document.getElementById(`cancelCrop${index}`);

  const reader = new FileReader();

  reader.onload = () => {
    image.src = reader.result;
    image.style.display = 'block';

    const placeholder = image.parentElement.querySelector(
      '.upload-placeholder, .browse-text'
    );
    if (placeholder) placeholder.style.display = 'none';

    croppedImage.src = reader.result;
    cropperContainer.classList.add('active');

    selectedImages[index] = true;

    if (croppers[index]) croppers[index].destroy();

    // ✅ SAME PROFESSIONAL CROPPER AS ADD PRODUCT
    croppers[index] = new Cropper(croppedImage, {
      viewMode: 1,
      autoCropArea: 0.9,
      responsive: true,
      background: false,
      movable: true,
      zoomable: true,
      cropBoxResizable: true,
      cropBoxMovable: true
    });

    // SAVE
    saveBtn.onclick = () => {
      const canvas = croppers[index].getCroppedCanvas({
        width: 800,
        height: 800,
        imageSmoothingQuality: 'high'
      });

      image.src = canvas.toDataURL('image/jpeg', 0.9);

      canvas.toBlob(blob => {
        const file = new File(
          [blob],
          `product-${Date.now()}-${index}.jpg`,
          { type: 'image/jpeg' }
        );

        const dt = new DataTransfer();
        dt.items.add(file);
        input.files = dt.files;

        showRemoveIcon(index);
        cleanupCropper(index);
        displayErrorMessage(`images-error-${index}`, '');
      });
    };

    // CANCEL
    cancelBtn.onclick = () => cancelCrop(index);
  };

  reader.readAsDataURL(file);
}


document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll('input[type="file"][id^="input"]').forEach(input => {
    input.addEventListener('change', e => {
      const index = input.id.replace('input', '');
      viewImage(e, index);
    });
  });
});


function cancelCrop(index) {
  const input = document.getElementById(`input${index}`);
  const image = document.getElementById(`imgView${index}`);
  const croppedImage = document.getElementById(`croppedImg${index}`);
  const cropperContainer = document.getElementById(`cropperContainer${index}`);

  if (croppers[index]) {
    croppers[index].destroy();
    delete croppers[index];
  }

  input.value = '';
  image.src = '';
  image.style.display = 'none';
  croppedImage.src = '';

  delete selectedImages[index];
  cropperContainer.classList.remove('active');

  const placeholder = image.parentElement.querySelector(
    '.upload-placeholder, .browse-text'
  );
  if (placeholder) placeholder.style.display = 'block';
}

function cleanupCropper(index) {
  const cropperContainer = document.getElementById(`cropperContainer${index}`);

  if (croppers[index]) {
    croppers[index].destroy();
    delete croppers[index];
  }

  cropperContainer.classList.remove('active');
}


// Form validation with variants
function validateForm() {
    clearErrorMessages();

    const name = document.getElementById('productName').value.trim();
    const description = document.getElementById('description').value.trim();
    const category = document.getElementById('category').value;
    const gst = document.getElementById('gst').value.trim();
    const variants = document.querySelectorAll('.variant-item');
    
    let isValid = true;

    // Product name validation
    if (name === "") {
        displayErrorMessage('productName-error', 'Product name is required.');
        isValid = false;
    } else if (name.length < 3) {
        displayErrorMessage('productName-error', 'Product name must be at least 3 characters long.');
        isValid = false;
    } else if (name.length > 100) {
        displayErrorMessage('productName-error', 'Product name must not exceed 100 characters.');
        isValid = false;
    } else if (!/^[a-zA-Z]/.test(name)) {
        displayErrorMessage('productName-error', 'Product name must start with a letter.');
        isValid = false;
    } else if (!/^[a-zA-Z][a-zA-Z0-9\s&'-]*$/.test(name)) {
        displayErrorMessage('productName-error', 'Product name can only contain letters, numbers, spaces, and basic punctuation (&, \', -).');
        isValid = false;
    }

    // Description validation
    if (description === "") {
        displayErrorMessage('description-error', 'Product description is required.');
        isValid = false;
    } else if (description.length < 10) {
        displayErrorMessage('description-error', 'Description must be at least 10 characters long.');
        isValid = false;
    } else if (description.length > 1000) {
        displayErrorMessage('description-error', 'Description must not exceed 1000 characters.');
        isValid = false;
    }

    // Category validation
    if (category === "") {
        displayErrorMessage('category-error', 'Please select a category.');
        isValid = false;
    }

    // GST validation
    if (gst === "") {
        displayErrorMessage('gst-error', 'GST is required.');
        isValid = false;
    } else {
        const gstValue = gst.replace('%', '');
        if (!/^\d+(\.\d{1,2})?$/.test(gstValue)) {
            displayErrorMessage('gst-error', 'Please enter a valid GST percentage.');
            isValid = false;
        } else if (parseFloat(gstValue) < 0 || parseFloat(gstValue) > 100) {
            displayErrorMessage('gst-error', 'GST must be between 0% and 100%.');
            isValid = false;
        }
    }

    // Validate each variant
    if (variants.length === 0) {
        displayErrorMessage('variants-error', 'At least one variant is required.');
        isValid = false;
    } else {
        variants.forEach((variant, index) => {
            const weight = variant.querySelector('.variant-weight').value.trim();
            const regularPrice = variant.querySelector('.variant-regular-price').value.trim();
            const salePrice = variant.querySelector('.variant-sale-price').value.trim();
            const stock = variant.querySelector('.variant-stock').value.trim();

            const weightError = variant.querySelector('.variant-weight').nextElementSibling;
            const regularPriceError = variant.querySelector('.variant-regular-price').nextElementSibling;
            const salePriceError = variant.querySelector('.variant-sale-price').nextElementSibling;
            const stockError = variant.querySelector('.variant-stock').nextElementSibling;

            // Weight validation
            if (weight === "") {
                weightError.innerText = 'Weight is required.';
                isValid = false;
            } else if (!/^\d+(\.\d{1,2})?$/.test(weight)) {
                weightError.innerText = 'Please enter a valid weight.';
                isValid = false;
            } else if (parseFloat(weight) <= 0) {
                weightError.innerText = 'Weight must be greater than 0.';
                isValid = false;
            }

            // Regular price validation
            if (regularPrice === "") {
                regularPriceError.innerText = 'Regular price is required.';
                isValid = false;
            } else if (!/^\d+(\.\d{1,2})?$/.test(regularPrice)) {
                regularPriceError.innerText = 'Please enter a valid price.';
                isValid = false;
            } else if (parseFloat(regularPrice) <= 0) {
                regularPriceError.innerText = 'Price must be greater than 0.';
                isValid = false;
            }

            // Sale price validation
            if (salePrice !== "") {
                if (!/^\d+(\.\d{1,2})?$/.test(salePrice)) {
                    salePriceError.innerText = 'Please enter a valid sale price.';
                    isValid = false;
                } else if (parseFloat(salePrice) < 0) {
                    salePriceError.innerText = 'Sale price cannot be negative.';
                    isValid = false;
                } else if (regularPrice !== "" && parseFloat(salePrice) >= parseFloat(regularPrice)) {
                    salePriceError.innerText = 'Sale price must be less than regular price.';
                    isValid = false;
                }
            }

            // Stock validation
            if (stock === "") {
                stockError.innerText = 'Stock is required.';
                isValid = false;
            } else if (!/^\d+$/.test(stock)) {
                stockError.innerText = 'Please enter a valid stock amount.';
                isValid = false;
            } else if (parseInt(stock) < 0) {
                stockError.innerText = 'Stock cannot be negative.';
                isValid = false;
            }
        });
    }

   // ---------- IMAGE VALIDATION (EDIT PRODUCT SAFE) ----------
const existingImageInputs = document.querySelectorAll(
  'input[name="existingImages[]"], input[name="existingImages"]'
);

const newImageInputs = document.querySelectorAll(
  'input[type="file"][id^="input"]'
);

const hasExistingImages = existingImageInputs.length > 0;

const hasNewImages = Array.from(newImageInputs).some(
  input => input.files && input.files.length > 0
);

if (!hasExistingImages && !hasNewImages) {
  const firstImageError = document.querySelector('[id^="images-error-"]');
  if (firstImageError) {
    firstImageError.innerText = 'At least one product image is required.';
  }
  isValid = false;
}

    const submitError = document.getElementById('submit-error');
    if (!isValid) {
        submitError.innerText = "Please fix the errors above before submitting.";
        const firstError = document.querySelector('.error-message:not(:empty)');
        if (firstError) {
            firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    } else {
        submitError.innerText = "";
    }

    return isValid;
}

function displayErrorMessage(id, message) {
    const errorElement = document.getElementById(id);
    if (errorElement) {
        errorElement.innerText = message;
    }
}

function clearErrorMessages() {
    document.querySelectorAll('.error-message').forEach((el) => el.innerText = '');
}

// Form submission
document.getElementById('editProductForm').addEventListener('submit', async function(e) {
    e.preventDefault();

    if (validateForm()) {
        const submitBtn = document.querySelector('.btn-save');
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
        submitBtn.style.cursor = 'not-allowed';

        try {
            const formData = new FormData(document.getElementById('editProductForm'));
            const productId = document.querySelector('[data-product-id]')?.getAttribute('data-product-id') || window.location.pathname.split('/').pop();

            const response = await fetch(`/admin/editProduct/${productId}`, {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                Swal.fire({
                    title: 'Success!',
                    text: result.message || 'Product updated successfully!',
                    icon: 'success',
                    confirmButtonText: 'OK',
                    allowOutsideClick: false,
                    background: '#ffffff',
                    color: '#2c2c2c',
                    confirmButtonColor: '#8b7355'
                }).then((result) => {
                    if (result.isConfirmed) {
                        formModified = false;
                        window.location.href = '/admin/products';
                    }
                });
            } else {
                Swal.fire({
                    title: 'Error!',
                    text: result.error || 'Failed to update product.',
                    icon: 'error',
                    confirmButtonText: 'OK',
                    background: '#ffffff',
                    color: '#2c2c2c',
                    confirmButtonColor: '#dc3545'
                });

                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
                submitBtn.style.cursor = 'pointer';
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                title: 'Error!',
                text: 'An error occurred while updating the product.',
                icon: 'error',
                confirmButtonText: 'OK',
                background: '#ffffff',
                color: '#2c2c2c',
                confirmButtonColor: '#dc3545'
            });

            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
            submitBtn.style.cursor = 'pointer';
        }
    }
});

// Cancel button
document.querySelector('.btn-cancel').addEventListener('click', function() {
    if (formModified) {
        if (confirm('Are you sure you want to cancel? Any unsaved changes will be lost.')) {
            formModified = false;
            window.location.href = '/admin/products';
        }
    } else {
        window.location.href = '/admin/products';
    }
});

// Close cropper on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.querySelectorAll('.image-cropper.active').forEach(container => {
            container.classList.remove('active');
            const index = container.id.replace('cropperContainer', '');
            if (croppers[index]) {
                croppers[index].destroy();
            }
        });
    }
});

// Clear input when clicking outside cropper
document.querySelectorAll('.image-cropper').forEach(container => {
    container.addEventListener('click', function(e) {
        if (e.target === container) {
            const index = container.id.replace('cropperContainer', '');
            container.classList.remove('active');
            if (croppers[index]) {
                croppers[index].destroy();
            }
            const input = document.getElementById('input' + index);
            input.value = '';
            const img = document.getElementById('imgView' + index);
            img.style.display = 'none';
            img.src = '';
            const placeholder = img.parentElement.querySelector('.upload-placeholder, .browse-text');
            if (placeholder) {
                placeholder.style.display = '';
            }
        }
    });
});

// Character counter for description
const descriptionField = document.getElementById('description');
if (descriptionField) {
    descriptionField.addEventListener('input', function() {
        const maxLength = 1000;
        const currentLength = this.value.length;
        const remaining = maxLength - currentLength;
        
        if (remaining < 100 && currentLength > 0) {
            const errorDiv = document.getElementById('description-error');
            if (!this.value.trim()) {
                errorDiv.innerText = '';
                errorDiv.style.color = '#dc3545';
            } else {
                errorDiv.innerText = `${remaining} characters remaining`;
                errorDiv.style.color = remaining < 0 ? '#dc3545' : '#666';
            }
        } else {
            const errorDiv = document.getElementById('description-error');
            if (!errorDiv.innerText.includes('required') && !errorDiv.innerText.includes('least')) {
                errorDiv.innerText = '';
            }
        }
    });
}

// Prevent form submission on Enter key (except in textarea)
document.getElementById('editProductForm').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
        e.preventDefault();
    }
});

// Track form modifications
let formModified = false;
document.getElementById('editProductForm').addEventListener('input', function() {
    formModified = true;
});
document.getElementById('editProductForm').addEventListener('change', function() {
    formModified = true;
});

window.addEventListener('beforeunload', function(e) {
    if (formModified) {
        e.preventDefault();
        e.returnValue = '';
        return '';
    }
});
 const gstInput = document.getElementById("gst");
gstInput.addEventListener("input", () => {
  const value = parseFloat(gstInput.value);
  const error = document.getElementById("gst-error");

  if (isNaN(value) || value < 0 || value > 100) {
    error.innerText = "GST must be between 0 and 100";
  } else {
    error.innerText = "";
  }
});

function showRemoveIcon(index) {
  let btn = document.getElementById(`removeImage${index}`);
  if (btn) return;

  const parent = document.getElementById('imgView'+index).parentElement;
  parent.style.position = 'relative';

  btn = document.createElement('span');
  btn.id = `removeImage${index}`;
  btn.innerHTML = '❌';

  btn.style.cssText = `
    position:absolute;
    top:5px;
    right:5px;
    cursor:pointer;
    font-size:18px;
    z-index:2;
  `;

  btn.onclick = (e) => {
    e.stopPropagation();
    removeImage(index);
  };

  parent.appendChild(btn);
}


