<div class="product-management-container">
    <div class="content-wrapper">
        <!-- Page Header -->
        <div class="page-header">
            <h2 class="page-title">Edit Product</h2>
            <a href="/admin/products" class="btn-back">
                <i class="fas fa-arrow-left"></i> Back to Products
            </a>
        </div>

        <!-- Page Container -->
        <div class="page-container">
            <!-- Edit Product Modal/Form -->
            <div class="edit-product-modal">
                <div class="modal-header-custom">
                    <h3>Edit Product Details</h3>
                    <button class="btn-close-modal" type="button" onclick="window.location.href='/admin/products'">&times;</button>
                </div>
               
                <!-- FORM OPENS HERE -->
                <form id="editProductForm" data-product-id="<%= product._id %>" method="POST" enctype="multipart/form-data">
                    <div class="modal-body">
                        <!-- Left Section: Image Uploads & Description -->
                        <div class="image-upload-section">
                            <!-- Existing Images -->
                            <% if(product.productImage && product.productImage.length > 0) { %>
                                <div class="existing-images">
                                    <div class="existing-images-title">Existing Images</div>
                                    <div class="existing-images-grid">
                                        <% product.productImage.forEach((image, index) => { %>
                                            <div class="existing-image-item" id="existing-image-<%= index %>">
                                                <input type="hidden" name="existingImages[]" value="<%= image %>" id="imageDatas-<%= index %>">
                                                <img src="/uploads/images/<%= image %>" alt="Product Image <%= index + 1 %>">
                                                <button type="button" class="delete-image-btn" onclick="deleteSingleImage('<%= image %>', '<%= product._id %>', '<%= index %>')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } %>
<% const existingCount = product.productImage ? product.productImage.length : 0; %>
<% const remainingSlots = 4 - existingCount; %>

<% if (remainingSlots > 0) { %>

  <!-- Image Upload Slots -->
  <div class="additional-images-grid">

    <% for (let i = existingCount + 1; i <= 4; i++) { %>

      <div class="additional-image-upload">

        <input
          type="file"
          id="input<%= i %>"
          name="images"
          accept="image/*"
          hidden
        >

        <label for="input<%= i %>" class="image-upload-label-small">
          <img id="imgView<%= i %>" src="" alt="" style="display:none;">
          <span class="browse-text">Add Image</span>
        </label>

        <div id="images-error-<%= i %>" class="error-message"></div>

      </div>
    <% } %>

  </div>

<% } else { %>

  <p class="text-muted">
    Maximum of 4 images already added.
  </p>

<% } %>



        <!-- Cropper -->

        <% for (let i = existingCount + 1; i <= 4; i++) { %>
        <div class="image-cropper" id="cropperContainer<%= i %>">
  <img src="" id="croppedImg<%= i %>">

  <div class="cropper-actions">
    <button
      type="button"
      id="saveButton<%= i %>"
      class="btn btn-primary"
    >
      Save Crop
    </button>

    <button
      type="button"
      id="cancelCrop<%= i %>"
      class="btn btn-outline-secondary"
    >
      Cancel
    </button>
  </div>
</div>
 <% } %>


                            <!-- Description -->
                            <div class="form-group-description">
                                <label>Description</label>
                                <textarea name="description" id="description" class="form-control" placeholder="Enter product description..."><%= product.description %></textarea>
                                <div id="description-error" class="error-message"></div>
                            </div>
                        </div>

                        <!-- Right Section: Form Fields -->
                        <div class="form-fields-section">
                            <!-- Product Name -->
                            <div class="form-group">
                                <label>Product Name</label>
                                <input type="text" name="productName" id="productName" class="form-control" placeholder="Enter product name" value="<%= product.productName %>">
                                <div id="productName-error" class="error-message"></div>
                            </div>

                            <!-- Category -->
                            <div class="form-group">
                                <label>Category</label>
                                <select class="form-select" id="category" name="category">
                                    <option value="">Select category</option>
                                    <% if(typeof cat !== 'undefined' && cat.length > 0) { %>
                                        <% cat.forEach(category => { 
                                            const isSelected = product.category && product.category._id && product.category._id.toString() === category._id.toString();
                                        %>
                                            <option value="<%= category.name %>" <%= isSelected ? 'selected' : '' %>><%= category.name %></option>
                                        <% }); %>
                                    <% } %>
                                </select>
                                <div id="category-error" class="error-message"></div>
                            </div>

                            <!-- Date and GST Row -->
                            <div class="form-row">
                                
                                <div class="form-group">
  <label>GST (%)</label>
  <input
    type="number"
    name="gst"
    id="gst"
    class="form-control"
    placeholder="18"
    min="0"
    max="100"
    step="0.01"
