<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Add New Product</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <!-- Cropper.js CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/cropperjs/dist/cropper.min.css"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background-color: #d4c5a9;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
      }

      .admin-container {
        display: flex;
        min-height: 100vh;
      }

      /* Sidebar Styles */
      .sidebar {
        width: 250px;
        background-color: #3a3a3a;
        position: fixed;
        height: 100vh;
        left: 0;
        top: 0;
        display: flex;
        flex-direction: column;
      }

      .logo-section {
        background-color: #d4c5a9;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .logo-icon {
        width: 32px;
        height: 32px;
        color: #8b6f47;
      }

      .logo-text {
        font-size: 18px;
        font-weight: 700;
        color: #8b6f47;
        letter-spacing: 0.5px;
        text-transform: uppercase;
      }

      .sidebar-menu {
        padding: 20px 0;
        flex: 1;
      }

      .menu-item {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 14px 25px;
        color: #b8b8b8;
        text-decoration: none;
        transition: all 0.3s;
        font-size: 14px;
        font-weight: 500;
        border-left: 3px solid transparent;
      }

      .menu-item:hover,
      .menu-item.active {
        background-color: #4a4a4a;
        color: #fff;
        border-left-color: #d4c5a9;
      }

      .menu-item i {
        font-size: 20px;
        width: 24px;
        text-align: center;
      }

      /* Main Content */
      .content-main {
        margin-left: 250px;
        background-color: #d4c5a9;
        min-height: 100vh;
        width: calc(100% - 250px);
        padding: 40px;
      }

      /* Modal Overlay */
      .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
      }

      /* Add Product Modal */
      .add-product-modal {
        background-color: #b8a67d;
        border-radius: 16px;
        width: 90%;
        max-width: 800px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        position: relative;
      }

      .modal-header-custom {
        background-color: #b8a67d;
        padding: 25px 30px;
        border-bottom: 2px solid rgba(0, 0, 0, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-radius: 16px 16px 0 0;
      }

      .modal-title-custom {
        font-size: 24px;
        font-weight: 700;
        color: #2c2c2c;
        margin: 0;
      }

      .modal-close {
        background: none;
        border: none;
        font-size: 28px;
        color: #2c2c2c;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
      }

      .modal-close:hover {
        color: #000;
        transform: rotate(90deg);
      }

      .modal-body-custom {
        padding: 30px;
      }

      /* Image Upload Section */
      .image-upload-section {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 15px;
        margin-bottom: 30px;
      }

      .image-upload-box {
        background-color: #fff;
        border: 2px dashed #ccc;
        border-radius: 12px;
        aspect-ratio: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
      }

      .image-upload-box:hover {
        border-color: #8b6f47;
        background-color: #f9f9f9;
      }

      .image-upload-box.large {
        grid-row: span 2;
      }

      .image-upload-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .upload-placeholder {
        text-align: center;
        color: #999;
      }

      .upload-placeholder i {
        font-size: 32px;
        color: #ccc;
        margin-bottom: 10px;
      }

      .upload-placeholder p {
        font-size: 12px;
        margin: 0;
      }

      .remove-image-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        background-color: rgba(239, 68, 68, 0.9);
        color: white;
        border: none;
        border-radius: 50%;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 14px;
        z-index: 10;
      }

      /* Description Section */
      .description-section {
        margin-bottom: 30px;
      }

      .section-label {
        font-size: 14px;
        font-weight: 600;
        color: #2c2c2c;
        margin-bottom: 10px;
        display: block;
      }

      .description-textarea {
        width: 100%;
        background-color: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 12px;
        font-size: 13px;
        color: #2c2c2c;
        resize: vertical;
        min-height: 80px;
      }

      .description-textarea:focus {
        outline: none;
        border-color: #8b6f47;
      }

      /* Variant Selection */
      .variant-section {
        margin-bottom: 25px;
      }

      .variant-label {
        font-size: 13px;
        font-weight: 600;
        color: #2c2c2c;
        margin-bottom: 8px;
        display: block;
      }

      .variant-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .variant-btn {
        background-color: #fff;
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        color: #2c2c2c;
        cursor: pointer;
        transition: all 0.3s;
      }

      .variant-btn:hover {
        border-color: #8b6f47;
      }

      .variant-btn.active {
        background-color: #8b6f47;
        border-color: #8b6f47;
        color: #fff;
      }

      /* Variant Selection */
      .variant-section {
        margin-bottom: 25px;
      }

      .variant-label {
        font-size: 13px;
        font-weight: 600;
        color: #2c2c2c;
        margin-bottom: 8px;
        display: block;
      }

      .variant-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      .variant-btn {
        background-color: #fff;
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        color: #2c2c2c;
        cursor: pointer;
        transition: all 0.3s;
      }

      .variant-btn:hover {
        border-color: #8b6f47;
      }

      .variant-btn.active {
        background-color: #8b6f47;
        border-color: #8b6f47;
        color: #fff;
      }

      /* Form Fields */
      .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
      }

      .form-group {
        display: flex;
        flex-direction: column;
      }

      .form-group.full-width {
        grid-column: span 2;
      }

      .form-label-custom {
        font-size: 13px;
        font-weight: 600;
        color: #2c2c2c;
        margin-bottom: 8px;
      }

      .form-input-custom {
        background-color: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        color: #2c2c2c;
        transition: all 0.3s;
      }

      .form-input-custom:focus {
        outline: none;
        border-color: #8b6f47;
      }

      .form-input-custom::placeholder {
        color: #999;
      }

      .form-select-custom {
        background-color: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 13px;
        color: #2c2c2c;
        cursor: pointer;
        transition: all 0.3s;
      }

      .form-select-custom:focus {
        outline: none;
        border-color: #8b6f47;
      }

      /* Modal Footer */
      .modal-footer-custom {
        padding: 20px 30px;
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        border-top: 2px solid rgba(0, 0, 0, 0.1);
      }

      .btn-modal {
        padding: 12px 30px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
      }

      .btn-cancel {
        background-color: #9ca3af;
        color: #fff;
      }

      .btn-cancel:hover {
        background-color: #6b7280;
      }

      .btn-add {
        background-color: #2c2c2c;
        color: #fff;
      }

      .btn-add:hover {
        background-color: #1a1a1a;
      }

      .error-message {
        color: #ef4444;
        font-size: 12px;
        margin-top: 5px;
      }

      /* Hidden file input */
      .hidden-file-input {
        display: none;
      }

      /* Responsive */
      @media (max-width: 768px) {
        .sidebar {
          width: 80px;
        }

        .logo-text,
        .menu-item span {
          display: none;
        }

        .content-main {
          margin-left: 80px;
          width: calc(100% - 80px);
          padding: 20px;
        }

        .image-upload-section {
          grid-template-columns: 1fr;
        }

        .image-upload-box.large {
          grid-row: span 1;
        }

        .form-row {
          grid-template-columns: 1fr;
        }

        .form-group.full-width {
          grid-column: span 1;
        }
      }
    </style>
  </head>
  <body>
    <div class="admin-container">
      <!-- Main Content -->
      <main class="content-main">
        <div class="modal-overlay">
          <div class="add-product-modal">
            <!-- Modal Header -->
            <div class="modal-header-custom">
              <h2 class="modal-title-custom">Add Product</h2>
              <button class="modal-close" onclick="window.history.back()">
                &times;
              </button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body-custom">
              <form
                id="myForm"
                action="/admin/addProduct"
                method="POST"
                enctype="multipart/form-data"
                onsubmit="handleFormSubmit(event)"
              >
                <!-- Image Upload Section -->
                <div class="image-upload-section">
                  <!-- Large Image Upload -->
                  <div
                    class="image-upload-box large"
                    onclick="document.getElementById('image1').click()"
                  >
                    <div class="upload-placeholder" id="placeholder1">
                      <i class="fas fa-image"></i>
                      <p>Browse Image</p>
                    </div>
                    <img id="preview1" style="display: none" />
                    <button
                      type="button"
                      class="remove-image-btn"
                      id="remove1"
                      style="display: none"
                      onclick="removeImage(1, event)"
                    >
                      &times;
                    </button>
                  </div>
                  <input
                    type="file"
                    id="image1"
                    name="images"
                    class="hidden-file-input"
                    accept="image/*"
                    onchange="previewImage(1, event)"
                  />

                  <!-- Small Image Upload 1 -->
                  <div
                    class="image-upload-box"
                    onclick="document.getElementById('image2').click()"
                  >
                    <div class="upload-placeholder" id="placeholder2">
                      <i class="fas fa-image"></i>
                      <p>Browse Image</p>
                    </div>
                    <img id="preview2" style="display: none" />
                    <button
                      type="button"
                      class="remove-image-btn"
                      id="remove2"
                      style="display: none"
                      onclick="removeImage(2, event)"
                    >
                      &times;
                    </button>
                  </div>
                  <input
                    type="file"
                    id="image2"
                    name="images"
                    class="hidden-file-input"
                    accept="image/*"
                    onchange="previewImage(2, event)"
                  />

                  <!-- Small Image Upload 2 -->
                  <div
                    class="image-upload-box"
                    onclick="document.getElementById('image3').click()"
                  >
                    <div class="upload-placeholder" id="placeholder3">
                      <i class="fas fa-image"></i>
                      <p>Browse Image</p>
                    </div>
                    <img id="preview3" style="display: none" />
                    <button
                      type="button"
                      class="remove-image-btn"
                      id="remove3"
                      style="display: none"
                      onclick="removeImage(3, event)"
                    >
                      &times;
                    </button>
                  </div>
                  <input
                    type="file"
                    id="image3"
                    name="images"
                    class="hidden-file-input"
                    accept="image/*"
                    onchange="previewImage(3, event)"
                  />

                  <!-- Small Image Upload 3 -->
                  <div
                    class="image-upload-box"
                    onclick="document.getElementById('image4').click()"
                  >
                    <div class="upload-placeholder" id="placeholder4">
                      <i class="fas fa-image"></i>
                      <p>Browse Image</p>
                    </div>
                    <img id="preview4" style="display: none" />
                    <button
                      type="button"
                      class="remove-image-btn"
                      id="remove4"
                      style="display: none"
                      onclick="removeImage(4, event)"
                    >
                      &times;
                    </button>
                  </div>
                  <input
                    type="file"
                    id="image4"
                    name="images"
                    class="hidden-file-input"
                    accept="image/*"
                    onchange="previewImage(4, event)"
                  />
                </div>
                <div id="images-error" class="error-message"></div>

                <!-- Description -->
                <div class="description-section">
                  <label class="section-label">Description</label>
                  <textarea
                    class="description-textarea"
                    name="description"
                    id="descriptionid"
                    placeholder="Seed bars are certainly healthy since they are packed with fiber and protein. These are simple breakfast options that boost energy and are good for your health. However, you must check the ingredients used in the seed bar you are choosing since some people are allergic to certain seeds and nuts."
                  ></textarea>
                  <div id="description-error" class="error-message"></div>
                </div>

                <!-- Form Fields -->
                <div class="form-row">
                  <!-- Product Name -->
                  <div class="form-group full-width">
                    <label class="form-label-custom">Product Name</label>
                    <input
                      type="text"
                      class="form-input-custom"
                      id="productName"
                      name="productName"
                      placeholder="Enter product name"
                    />
                    <div id="productName-error" class="error-message"></div>
                  </div>

                  <!-- Category -->
                  <div class="form-group">
                    <label class="form-label-custom">Category</label>
                    <select
                      class="form-select-custom"
                      id="category"
                      name="category"
                    >
                      <% cat.forEach((c) => { %>
                      <option value="<%= c.name %>"><%= c.name %></option>
                      <% }) %>
                      <option value="Millet Muesli">Millet Muesli</option>
                      <option value="Whole Grains">Whole Grains</option>
                      <option value="Energy Bars">Energy Bars</option>
                    </select>
                  </div>

                  <!-- Date -->
                  <div class="form-group">
                    <label class="form-label-custom">Date</label>
                    <input
                      type="date"
                      class="form-input-custom"
                      name="date"
                      value="<%= new Date().toISOString().split('T')[0] %>"
                    />
                  </div>

                  <!-- Regular Price -->
                  <div class="form-group">
                    <label class="form-label-custom">Regular Price</label>
                    <input
                      type="text"
                      class="form-input-custom"
                      id="regularPrice"
                      name="regularPrice"
                      placeholder="₹0.00"
                    />
                    <div id="regularPrice-error" class="error-message"></div>
                  </div>

                  <!-- GST -->
                  <div class="form-group">
                    <label class="form-label-custom">GST</label>
                    <input
                      type="text"
                      class="form-input-custom"
                      name="gst"
                      placeholder="18%"
                    />
                  </div>

                  <!-- Sale Price -->
                  <div class="form-group">
                    <label class="form-label-custom">Sale Price</label>
                    <input
                      type="text"
                      class="form-input-custom"
                      name="salePrice"
                      placeholder="₹0.00"
                    />
                  </div>

                  <!-- Brand -->
                  <!-- <div class="form-group">
                    <label class="form-label-custom">Brand</label>
                    <select class="form-select-custom" id="brand" name="brand">
                      <option value="Millimillet">Millimillet</option>
                      <option value="HealthyCo">HealthyCo</option>
                    </select>
                  </div> -->

                  <!-- Quantity -->
                  <div class="form-group">
                    <label class="form-label-custom">Quantity</label>
                    <input
                      type="text"
                      class="form-input-custom"
                      name="quantity"
                      placeholder="Enter quantity"
                    />
                    <div id="quantity-error" class="error-message"></div>
                  </div>

                  <!-- Unit Type -->
                  <div class="form-group">
                    <label class="form-label-custom">Unit Type</label>
                    <select class="form-select-custom" name="unitType">
                      <option value="Packets">Packets</option>
                      <option value="Kg">Kg</option>
                      <option value="Grams">Grams</option>
                      <option value="Liters">Liters</option>
                      <option value="Pieces">Pieces</option>
                    </select>
                  </div>

                  <!-- Stock
                  <div class="form-group">
                    <label class="form-label-custom">Stock</label>
                    <input
                      type="text"
                      class="form-input-custom"
                      name="stock"
                      placeholder="Enter stock quantity"
                    />
                  </div> -->
                </div>

                <div id="submit-error" class="error-message"></div>

                <!-- Modal Footer -->
                <div class="modal-footer-custom">
                  <button
                    type="button"
                    class="btn-modal btn-cancel"
                    onclick="window.history.back()"
                  >
                    Cancel
                  </button>
                  <button type="submit" class="btn-modal btn-add">Add</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- JS & Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
      // Image Preview
      function previewImage(index, event) {
        event.stopPropagation();
        const file = event.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function (e) {
            const preview = document.getElementById("preview" + index);
            const placeholder = document.getElementById("placeholder" + index);
            const removeBtn = document.getElementById("remove" + index);

            preview.src = e.target.result;
            preview.style.display = "block";
            placeholder.style.display = "none";
            removeBtn.style.display = "flex";
          };
          reader.readAsDataURL(file);
        }
      }

      // Remove Image
      function removeImage(index, event) {
        event.stopPropagation();
        const preview = document.getElementById("preview" + index);
        const placeholder = document.getElementById("placeholder" + index);
        const removeBtn = document.getElementById("remove" + index);
        const input = document.getElementById("image" + index);

        preview.src = "";
        preview.style.display = "none";
        placeholder.style.display = "block";
        removeBtn.style.display = "none";
        input.value = "";
      }

      // Form Validation
      function handleFormSubmit(event) {
        event.preventDefault();
        if (validateForm()) {
          Swal.fire({
            title: "Success!",
            text: "Product added successfully!",
            icon: "success",
            confirmButtonText: "OK",
            confirmButtonColor: "#8B6F47",
          })
            .then((result) => {
              if (result.isConfirmed) {
                document.getElementById("myForm").submit();
              }
            })
            .catch((error) => {
              alert("Error: " + error);
            });
        }
      }

      function validateForm() {
        clearErrorMessages();
        const name = document.getElementById("productName").value.trim();
        const description = document
          .getElementById("descriptionid")
          .value.trim();
        const price = document.getElementById("regularPrice").value.trim();
        const quantity = document.getElementsByName("quantity")[0].value.trim();

        // Check if at least one image is uploaded
        const hasImage = ["image1", "image2", "image3", "image4"].some((id) => {
          return document.getElementById(id).files.length > 0;
        });

        let isValid = true;

        if (name === "") {
          displayErrorMessage(
            "productName-error",
            "Please enter a product name."
          );
          isValid = false;
        } else if (!/^[a-zA-Z][a-zA-Z0-9\s]*$/.test(name)) {
          displayErrorMessage(
            "productName-error",
            "Product name must start with a letter."
          );
          isValid = false;
        }

        if (description === "") {
          displayErrorMessage(
            "description-error",
            "Please enter a product description."
          );
          isValid = false;
        }

        if (!/^\d+$/.test(quantity) || parseInt(quantity) < 0) {
          displayErrorMessage(
            "quantity-error",
            "Quantity must be a non-negative integer."
          );
          isValid = false;
        }

        if (!/^\d+(\.\d{1,2})?$/.test(price) || parseFloat(price) < 0) {
          displayErrorMessage(
            "regularPrice-error",
            "Price must be a valid number."
          );
          isValid = false;
        }

        if (!hasImage) {
          displayErrorMessage(
            "images-error",
            "Please select at least one image."
          );
          isValid = false;
        }

        const submitError = document.getElementById("submit-error");
        submitError.innerText = isValid
          ? ""
          : "Please fix the errors above before submitting.";
        return isValid;
      }

      function displayErrorMessage(id, message) {
        document.getElementById(id).innerText = message;
      }

      function clearErrorMessages() {
        document
          .querySelectorAll(".error-message")
          .forEach((el) => (el.innerText = ""));
      }
    </script>
  </body>
</html>
