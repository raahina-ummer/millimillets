<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
/* ===============================
   GLOBALS
================================ */
let croppers = {};
let selectedImages = {};
  const gstInput = document.getElementById("gst");

/* ===============================
   IMAGE PREVIEW + CROPPER
================================ */
function viewImage(event, index) {
  const input = event.target;
  if (!input.files || !input.files[0]) return;

  const image = document.getElementById(`imgView${index}`);
  const cropperContainer = document.getElementById(`cropperContainer${index}`);
  const croppedImage = document.getElementById(`croppedImg${index}`);
  const saveBtn = document.getElementById(`saveButton${index}`);
  const cancelBtn = document.getElementById(`cancelCrop${index}`);

  const reader = new FileReader();

  reader.onload = () => {
    // Show preview image
    image.src = reader.result;
    image.style.display = "block";

    // Hide placeholder
    const placeholder = image.parentElement.querySelector(
      ".upload-placeholder, .browse-text"
    );
    if (placeholder) placeholder.style.display = "none";

    // Prepare cropper image
    croppedImage.src = reader.result;
    cropperContainer.classList.add("active");

    // Track image as selected
    selectedImages[index] = true;
    showRemoveIcon(index);

    // Destroy old cropper if exists
    if (croppers[index]) croppers[index].destroy();

    // 🔥 PROFESSIONAL CROPPER CONFIG
    croppers[index] = new Cropper(croppedImage, {
      viewMode: 1,
      autoCropArea: 0.9,
      responsive: true,
      background: false,
      movable: true,
      zoomable: true,
      rotatable: false,
      scalable: false,
      cropBoxResizable: true,   // 👈 rectangle or square
      cropBoxMovable: true
      // ❌ NO aspectRatio → free resize
    });

    // SAVE CROP
    saveBtn.onclick = () => {
      const canvas = croppers[index].getCroppedCanvas({
        width: 800,
        height: 800,
        imageSmoothingQuality: "high"
      });

      image.src = canvas.toDataURL("image/jpeg", 0.9);

      canvas.toBlob(blob => {
        const file = new File(
          [blob],
          `product-${Date.now()}.jpg`,
          { type: "image/jpeg" }
        );

        const dt = new DataTransfer();
        dt.items.add(file);
        input.files = dt.files;

        cleanupCropper(index);
      });
    };

    // CANCEL CROP
    cancelBtn.onclick = () => cancelCrop(index);
  };

  reader.readAsDataURL(input.files[0]);
}
function cancelCrop(index) {
  const input = document.getElementById(`input${index}`);
  const image = document.getElementById(`imgView${index}`);
  const croppedImage = document.getElementById(`croppedImg${index}`);
  const cropperContainer = document.getElementById(`cropperContainer${index}`);

  // Destroy cropper
  if (croppers[index]) {
    croppers[index].destroy();
    delete croppers[index];
  }

  // Reset input
  input.value = "";

  // Hide images
  image.src = "";
  image.style.display = "none";
  croppedImage.src = "";

  // Remove selection
  delete selectedImages[index];

  // Hide cropper UI
  cropperContainer.classList.remove("active");

  // Restore placeholder
  const placeholder = image.parentElement.querySelector(
    ".upload-placeholder, .browse-text"
  );
  if (placeholder) placeholder.style.display = "block";

  // Remove ❌ icon
  const btn = document.getElementById(`removeImage${index}`);
  if (btn) btn.remove();
}
function cleanupCropper(index) {
  const cropperContainer = document.getElementById(`cropperContainer${index}`);

  if (croppers[index]) {
    croppers[index].destroy();
    delete croppers[index];
  }

  cropperContainer.classList.remove("active");
}

function showRemoveIcon(index) {
    let btn = document.getElementById(`removeImage${index}`);
    if (btn) return;

    btn = document.createElement('span');
    btn.id = `removeImage${index}`;
    btn.innerHTML = '❌';
    btn.style.cssText = `
        cursor:pointer;
        position:absolute;
        top:5px;
        right:5px;
        font-size:18px;
    `;

    btn.onclick = () => removeImage(index);
    document.getElementById('imgView' + index).parentElement.appendChild(btn);
}

function removeImage(index) {
    const input = document.getElementById('input' + index);
    const image = document.getElementById('imgView' + index);

    input.value = '';
    image.src = '';
    image.style.display = 'none';

    delete selectedImages[index];

    const btn = document.getElementById(`removeImage${index}`);
    if (btn) btn.remove();
}

['1','2','3','4'].forEach(i => {
    document.getElementById('input' + i)
        ?.addEventListener('change', e => viewImage(e, i));
});

/* ===============================
   VARIANTS
================================ */
let variantCount = document.querySelectorAll('.variant-item').length || 1;

function addVariant() {
    const container = document.getElementById('variants-container');

    container.insertAdjacentHTML('beforeend', `
        <div class="variant-item" data-variant-index="${variantCount}">
            <button type="button" class="btn-remove-variant" onclick="removeVariant(this)">
                <i class="fas fa-times"></i>
            </button>

            <div class="variant-label">Variant ${variantCount + 1}</div>

            <div class="form-row-3">
                <div class="form-group">
                    <label>Weight</label>
                    <input type="text"
                        name="variants[${variantCount}][weight]"
                        class="form-control variant-weight">
                </div>

                <div class="form-group">
                    <label>Unit</label>
                    <select name="variants[${variantCount}][unit]"
                        class="form-select variant-unit">
                        <option value="grm">grm</option>
                        <option value="kg">kg</option>
                        <option value="ml">ml</option>
                        <option value="ltr">ltr</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Regular Price</label>
                    <input type="text"
                        name="variants[${variantCount}][regularPrice]"
                        class="form-control">
                </div>
            </div>

            <div class="form-row-3">
                <div class="form-group">
                    <label>Sale Price</label>
                    <input type="text"
                        name="variants[${variantCount}][salePrice]"
                        class="form-control">
                </div>

                <div class="form-group">
                    <label>Stock</label>
                    <input type="text"
                        name="variants[${variantCount}][stock]"
                        class="form-control">
                </div>
            </div>
        </div>
    `);

    variantCount++;
}


function removeVariant(btn) {
    const variants = document.querySelectorAll('.variant-item');
    if (variants.length <= 1) {
        Swal.fire('At least one variant is required');
        return;
    }
    btn.closest('.variant-item').remove();
}

/* ===============================
   FORM VALIDATION (FIXED)
================================ */
function validateForm() {
    const productName = document.getElementById('productName');
    const description = document.getElementById('description');
  

    let errors = [];

    if (!productName?.value.trim())
        errors.push('Product name is required');

    if (!description?.value.trim())
        errors.push('Description is required');

    const gstVal = gstInput?.value.trim();
    if (!gstVal || isNaN(gstVal) || gstVal < 0 || gstVal > 100)
        errors.push('GST must be between 0 and 100');

    document.querySelectorAll('.variant-item').forEach((v, i) => {
        const weight = v.querySelector('[name*="weight"]').value;
        const price = v.querySelector('[name*="regularPrice"]').value;
        const stock = v.querySelector('[name*="stock"]').value;

        if (!weight || weight <= 0)
            errors.push(`Variant ${i + 1}: Weight must be positive`);

        if (!price || price <= 0)
            errors.push(`Variant ${i + 1}: Regular price must be positive`);

        if (stock === '' || stock < 0)
            errors.push(`Variant ${i + 1}: Stock must be 0 or more`);
    });

    const imageCount = Object.keys(selectedImages).length;
    if (imageCount < 3)
        errors.push('At least 3 product images are required');

    if (imageCount > 4)
        errors.push('Maximum 4 images allowed');

    if (errors.length) {
        Swal.fire({
            icon: 'error',
            title: 'Validation Error',
            html: `<ul style="text-align:left">${errors.map(e => `<li>${e}</li>`).join('')}</ul>`
        });
        return false;
    }

    return true;
}

/* ===============================
   FORM SUBMIT
================================ */
document.getElementById('addProductForm')
    .addEventListener('submit', async function (e) {
        e.preventDefault();

        if (!validateForm()) return;

        const formData = new FormData(this);

        try {
            const response = await fetch('/admin/addProduct', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (!response.ok || !data.success) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: data.message || 'Failed to add product'
                });
                return;
            }

            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: data.message || 'Product added successfully'
            }).then(() => {
                window.location.href = '/admin/products';
            });

        } catch (err) {
            Swal.fire({
                icon: 'error',
                title: 'Server Error',
                text: 'Please try again later'
            });
        }
    });


    // Close (X) button
document.querySelector('.btn-close-modal')?.addEventListener('click', () => {
  window.location.href = '/admin/products';
});

// Cancel button
document.querySelector('.btn-cancel')?.addEventListener('click', () => {
  window.location.href = '/admin/products';
});


function confirmExit() {
  Swal.fire({
    title: 'Discard changes?',
    text: 'Any unsaved data will be lost.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Yes, leave',
    cancelButtonText: 'Stay'
  }).then(result => {
    if (result.isConfirmed) {
      window.location.href = '/admin/products';
    }
  });
}

document.querySelector('.btn-close-modal')?.addEventListener('click', confirmExit);
document.querySelector('.btn-cancel')?.addEventListener('click', confirmExit);

gstInput.addEventListener("input", () => {
  const value = parseFloat(gstInput.value);
  const error = document.getElementById("gst-error");

  if (isNaN(value) || value < 0 || value > 100) {
    error.innerText = "GST must be between 0 and 100";
  } else {
    error.innerText = "";
  }
});


</script>
