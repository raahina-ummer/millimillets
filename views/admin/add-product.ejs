    });
});

// Initialize console message
console.log('Add Product form initialized successfully');
console.log('Form validation: Active (Updated to match controller)');
console.log('Image cropper: Ready with zoom functionality');
console.log('Validation rules:');
console.log('- Weight: Must be positive');
console.log('- Regular Price: Must be positive');
console.log('- Stock: Must be non-negative');
console.log('- GST: 0-100 (numbers only, no % symbol)');
console.log('- Images: 1-4 images, PNG/JPEG/JPG/WEBP only');
console.log('- Sale Price: Optional, must be <= regular price');
</script>