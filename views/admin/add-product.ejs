<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
let croppers = {};

// Image preview and cropper initialization
function viewImage(event, index) {
    let input = event.target;
    let reader = new FileReader();
    reader.onload = function () {
        let dataURL = reader.result;
        let image = document.getElementById('imgView' + index);
        image.src = dataURL;
        image.style.display = 'block';

        // Hide placeholder
        let placeholder = image.parentElement.querySelector('.upload-placeholder, .browse-text');
        if (placeholder) {
            placeholder.style.display = 'none';
        }

        // Show cropper container
        let cropperContainer = document.getElementById('cropperContainer' + index);
        let croppedImage = document.getElementById('croppedImg' + index);
        croppedImage.src = dataURL;
        cropperContainer.classList.add('active');

        // Destroy existing cropper if any
        if (croppers[index]) {
            croppers[index].destroy();
        }

        // Initialize new Cropper instance with zoom
        croppers[index] = new Cropper(croppedImage, {
            aspectRatio: 1,
            viewMode: 1,
            guides: true,
            background: false,
            autoCropArea: 1,
            zoomable: true,
            zoomOnWheel: true,
            zoomOnTouch: true,
            wheelZoomRatio: 0.1,
            minCropBoxWidth: 100,
            minCropBoxHeight: 100
        });

        // Add zoom controls
        let zoomInBtn = document.querySelector('#zoomIn' + index);
        let zoomOutBtn = document.querySelector('#zoomOut' + index);
        let resetBtn = document.querySelector('#resetZoom' + index);

        if (zoomInBtn) {
            zoomInBtn.onclick = function() {
                croppers[index].zoom(0.1);
            };
        }

        if (zoomOutBtn) {
            zoomOutBtn.onclick = function() {
                croppers[index].zoom(-0.1);
            };
        }

        if (resetBtn) {
            resetBtn.onclick = function() {
                croppers[index].reset();
            };
        }

        // Save button click event
        let saveButton = document.querySelector('#saveButton' + index);
        saveButton.onclick = async function () {
            let croppedCanvas = croppers[index].getCroppedCanvas();
            
            // Update preview image
            image.src = croppedCanvas.toDataURL('image/jpeg', 1.0);

            // Create and assign the new file
            await croppedCanvas.toBlob(blob => {
                let imageFile = new File([blob], `cropped-img-${Date.now()}-${index}.png`, { type: "image/png" });
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(imageFile);
                input.files = dataTransfer.files;
            });

            // Hide cropper container
            cropperContainer.classList.remove('active');
            croppers[index].destroy();
        };
    };
    reader.readAsDataURL(input.files[0]);
}

// Setup image inputs
document.getElementById('input1').addEventListener('change', function(e) {
    viewImage(e, 1);
});
document.getElementById('input2').addEventListener('change', function(e) {
    viewImage(e, 2);
});
document.getElementById('input3').addEventListener('change', function(e) {
    viewImage(e, 3);
});
document.getElementById('input4').addEventListener('change', function(e) {
    viewImage(e, 4);
});

// Form validation - UPDATED TO MATCH CONTROLLER
function validateForm() {
    clearErrorMessages();

    const name = document.getElementById('productName').value.trim();
    const description = document.getElementById('description').value.trim();
    const regularPrice = document.getElementById('regularPrice').value.trim();
    const salePrice = document.getElementById('salePrice')?.value.trim();
    const stock = document.getElementById('stock').value.trim();
    const category = document.getElementById('category').value;
    const weight = document.getElementById('weight').value.trim();
    const unit = document.getElementById('unit')?.value;
    const gst = document.getElementById('gst').value.trim();
    const imageInput = document.getElementById('input1');

    let isValid = true;

    // Product name validation
    if (name === "") {
        displayErrorMessage('productName-error', 'Please enter a product name.');
        isValid = false;
    } else if (!/^[a-zA-Z][a-zA-Z0-9\s]*$/.test(name)) {
        displayErrorMessage('productName-error', 'Product name must start with a letter and can contain letters, numbers, and spaces.');
        isValid = false;
    }

    // Description validation
    if (description === "") {
        displayErrorMessage('description-error', 'Please enter a product description.');
        isValid = false;
    }

    // Category validation
    if (category === "") {
        displayErrorMessage('category-error', 'Please select a category.');
        isValid = false;
    }

    // Weight validation (must be positive)
    if (weight === "") {
        displayErrorMessage('weight-error', 'Please enter weight.');
        isValid = false;
    } else if (!/^\d+(\.\d+)?$/.test(weight) || parseFloat(weight) <= 0) {
        displayErrorMessage('weight-error', 'Weight must be a positive number.');
        isValid = false;
    }

    // Unit validation
    if (unit && unit === "") {
        displayErrorMessage('unit-error', 'Please select a unit.');
        isValid = false;
    }

    // GST validation (0-100, numbers only)
    if (gst === "") {
        displayErrorMessage('gst-error', 'Please enter GST percentage.');
        isValid = false;
    } else if (!/^\d+(\.\d+)?$/.test(gst)) {
        displayErrorMessage('gst-error', 'Please enter a valid GST percentage (numbers only).');
        isValid = false;
    } else if (parseFloat(gst) < 0 || parseFloat(gst) > 100) {
        displayErrorMessage('gst-error', 'GST must be between 0 and 100.');
        isValid = false;
    }

    // Stock validation (non-negative)
    if (stock === "") {
        displayErrorMessage('stock-error', 'Please enter stock quantity.');
        isValid = false;
    } else if (!/^\d+$/.test(stock) || parseInt(stock) < 0) {
        displayErrorMessage('stock-error', 'Stock must be a non-negative number.');
        isValid = false;
    }

    // Regular price validation (must be positive)
    if (regularPrice === "") {
        displayErrorMessage('regularPrice-error', 'Please enter regular price.');
        isValid = false;
    } else if (!/^\d+(\.\d{1,2})?$/.test(regularPrice) || parseFloat(regularPrice) <= 0) {
        displayErrorMessage('regularPrice-error', 'Regular price must be a positive number.');
        isValid = false;
    }

    // Sale price validation (optional, but if provided must be valid and <= regularPrice)
    if (salePrice && salePrice !== "") {
        if (!/^\d+(\.\d{1,2})?$/.test(salePrice) || parseFloat(salePrice) < 0) {
            displayErrorMessage('salePrice-error', 'Please enter a valid sale price.');
            isValid = false;
        } else if (parseFloat(salePrice) > parseFloat(regularPrice)) {
            displayErrorMessage('salePrice-error', 'Sale price cannot be greater than regular price.');
            isValid = false;
        }
    }

    // Image validation (required, 1-4 images, specific types)
    if (!imageInput.files || imageInput.files.length === 0) {
        displayErrorMessage("images-error-1", 'Please select at least one image.');
        isValid = false;
    } else if (imageInput.files.length > 4) {
        displayErrorMessage("images-error-1", 'Maximum 4 images allowed.');
        isValid = false;
    } else {
        const validImageTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
        for (let file of imageInput.files) {
            if (!validImageTypes.includes(file.type)) {
                displayErrorMessage("images-error-1", 'Only PNG, JPEG, JPG, and WEBP images are allowed.');
                isValid = false;
                break;
            }
        }
    }

    const submitError = document.getElementById('submit-error');
    if (!isValid) {
        submitError.innerText = "Please fix the errors above before submitting.";
    } else {
        submitError.innerText = "";
    }

    return isValid;
}

function displayErrorMessage(id, message) {
    document.getElementById(id).innerText = message;
}

function clearErrorMessages() {
    document.querySelectorAll('.error-message').forEach((el) => el.innerText = '');
}

// Form submission
document.getElementById('addProductForm').addEventListener('submit', function(e) {
    e.preventDefault();

    if (validateForm()) {
        Swal.fire({
            title: 'Success!',
            text: 'Product added successfully!',
            icon: 'success',
            confirmButtonText: 'OK',
            toast: true,
            position: "center",
            background: '#c4a574',
            color: '#2c2c2c',
            confirmButtonColor: '#5a4a3a'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById("addProductForm").submit();
            }
        });
    }
});

// Cancel button
document.querySelector('.btn-cancel').addEventListener('click', function() {
    window.location.href = '/admin/products';
});

// Close modal button (X button)
document.querySelector('.btn-close-modal').addEventListener('click', function() {
    window.location.href = '/admin/products';
});

// Auto-fill today's date
document.getElementById('date').valueAsDate = new Date();

// Prevent form submission on Enter key (except in textarea)
document.getElementById('addProductForm').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
        e.preventDefault();
    }
});

// Real-time validation for numeric fields
document.getElementById('regularPrice').addEventListener('input', function(e) {
    const value = e.target.value;
    if (value && !/^\d*\.?\d{0,2}$/.test(value)) {
        e.target.value = value.slice(0, -1);
    }
});

const salePriceField = document.getElementById('salePrice');
if (salePriceField) {
    salePriceField.addEventListener('input', function(e) {
        const value = e.target.value;
        if (value && !/^\d*\.?\d{0,2}$/.test(value)) {
            e.target.value = value.slice(0, -1);
        }
    });
}

document.getElementById('weight').addEventListener('input', function(e) {
    const value = e.target.value;
    if (value && !/^\d*\.?\d{0,2}$/.test(value)) {
        e.target.value = value.slice(0, -1);
    }
});

document.getElementById('stock').addEventListener('input', function(e) {
    const value = e.target.value;
    if (value && !/^\d*$/.test(value)) {
        e.target.value = value.slice(0, -1);
    }
});

// GST input formatting (numbers only, no % symbol)
document.getElementById('gst').addEventListener('input', function(e) {
    const value = e.target.value;
    if (value && !/^\d*\.?\d{0,2}$/.test(value)) {
        e.target.value = value.slice(0, -1);
    }
});

// Close cropper on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.querySelectorAll('.image-cropper.active').forEach(container => {
            container.classList.remove('active');
            const index = container.id.replace('cropperContainer', '');
            if (croppers[index]) {
                croppers[index].destroy();
            }
        });
    }
});

// Clear input when clicking outside cropper
document.querySelectorAll('.image-cropper').forEach(container => {
    container.addEventListener('click', function(e) {
        if (e.target === container) {
            const index = container.id.replace('cropperContainer', '');
            container.classList.remove('active');
            if (croppers[index]) {
                croppers[index].destroy();
            }
            // Clear the file input
            const input = document.getElementById('input' + index);
            input.value = '';
            // Hide the preview image
            const img = document.getElementById('imgView' + index);
            img.style.display = 'none';
            img.src = '';
            // Show placeholder again
            const placeholder = img.parentElement.querySelector('.upload-placeholder, .browse-text');
            if (placeholder) {
                placeholder.style.display = '';
            }
        }
    });
});

// Character counter for description
const descriptionField = document.getElementById('description');
if (descriptionField) {
    descriptionField.addEventListener('input', function() {
        const maxLength = 1000;
        const currentLength = this.value.length;
        const remaining = maxLength - currentLength;
        
        if (remaining < 100 && currentLength > 0) {
            const errorDiv = document.getElementById('description-error');
            if (!this.value.trim()) {
                errorDiv.innerText = '';
                errorDiv.style.color = '#dc3545';
            } else {
                errorDiv.innerText = `${remaining} characters remaining`;
                errorDiv.style.color = remaining < 0 ? '#dc3545' : '#666';
            }
        } else {
            const errorDiv = document.getElementById('description-error');
            if (!errorDiv.innerText.includes('required') && !errorDiv.innerText.includes('least')) {
                errorDiv.innerText = '';
            }
        }
    });
}

// Refresh button functionality
document.querySelector('.btn-refresh').addEventListener('click', function() {
    const form = document.getElementById('addProductForm');
    const hasData = form.querySelector('input[type="text"]').value || 
                    form.querySelector('textarea').value || 
                    document.getElementById('input1').files.length > 0;
    
    if (hasData) {
        if (confirm('Are you sure you want to refresh? Any unsaved changes will be lost.')) {
            location.reload();
        }
    } else {
        location.reload();
    }
});

// Enhanced form submission with loading state
const originalSubmitHandler = document.getElementById('addProductForm').onsubmit;
document.getElementById('addProductForm').addEventListener('submit', function(e) {
    e.preventDefault();

    if (validateForm()) {
        // Show loading state
        const submitBtn = document.querySelector('.btn-add');
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
        submitBtn.style.cursor = 'not-allowed';

        Swal.fire({
            title: 'Success!',
            text: 'Product added successfully!',
            icon: 'success',
            confirmButtonText: 'OK',
            allowOutsideClick: false,
            background: '#c4a574',
            color: '#2c2c2c',
            confirmButtonColor: '#5a4a3a'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById("addProductForm").submit();
            } else {
                // Reset button if cancelled
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
                submitBtn.style.cursor = 'pointer';
            }
        });
    }
});

// Confirm before leaving page with unsaved changes
let formModified = false;

document.getElementById('addProductForm').addEventListener('input', function() {
    formModified = true;
});

document.getElementById('addProductForm').addEventListener('change', function() {
    formModified = true;
});

window.addEventListener('beforeunload', function(e) {
    if (formModified) {
        e.preventDefault();
        e.returnValue = '';
        return '';
    }
});

// Reset formModified on successful submit
document.getElementById('addProductForm').addEventListener('submit', function() {
    formModified = false;
});

// Cancel button with confirmation
document.querySelector('.btn-cancel').addEventListener('click', function() {
    if (formModified) {
        if (confirm('Are you sure you want to cancel? Any unsaved changes will be lost.')) {
            formModified = false;
            window.location.href = '/admin/products';
        }
    } else {
        window.location.href = '/admin/products';
    }
});

// Close modal button with confirmation
document.querySelector('.btn-close-modal').addEventListener('click', function() {
    if (formModified) {
        if (confirm('Are you sure you want to close? Any unsaved changes will be lost.')) {
            formModified = false;
            window.location.href = '/admin/products';
        }
    } else {
        window.location.href = '/admin/products';
    }
});


