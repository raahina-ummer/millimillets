// GST input formatting
document.getElementById('gst').addEventListener('blur', function(e) {
    let value = e.target.value.trim();
    if (value && !value.endsWith('%')) {
        e.target.value = value + '%';
    }
});

// Close cropper on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.querySelectorAll('.image-cropper.active').forEach(container => {
            container.classList.remove('active');
            const index = container.id.replace('cropperContainer', '');
            if (croppers[index]) {
                croppers[index].destroy();
            }
        });
    }
});

// Clear input when clicking outside cropper
document.querySelectorAll('.image-cropper').forEach(container => {
    container.addEventListener('click', function(e) {
        if (e.target === container) {
            const index = container.id.replace('cropperContainer', '');
            container.classList.remove('active');
            if (croppers[index]) {
                croppers[index].destroy();
            }
            // Clear the file input
            const input = document.getElementById('input' + index);
            input.value = '';
            // Hide the preview image
            const img = document.getElementById('imgView' + index);
            img.style.display = 'none';
            img.src = '';
            // Show placeholder again
            const placeholder = img.parentElement.querySelector('.upload-placeholder, .browse-text');
            if (placeholder) {
                placeholder.style.display = '';
            }
        }
    });
});

// Character counter for description
const descriptionField = document.getElementById('description');
if (descriptionField) {
    descriptionField.addEventListener('input', function() {
        const maxLength = 1000;
        const currentLength = this.value.length;
        const remaining = maxLength - currentLength;
        
        if (remaining < 100 && currentLength > 0) {
            const errorDiv = document.getElementById('description-error');
            if (!this.value.trim()) {
                errorDiv.innerText = '';
                errorDiv.style.color = '#dc3545';
            } else {
                errorDiv.innerText = `${remaining} characters remaining`;
                errorDiv.style.color = remaining < 0 ? '#dc3545' : '#666';
            }
        } else {
            const errorDiv = document.getElementById('description-error');
            if (!errorDiv.innerText.includes('required') && !errorDiv.innerText.includes('least')) {
                errorDiv.innerText = '';
            }
        }
    });
}

// Refresh button functionality
document.querySelector('.btn-refresh').addEventListener('click', function() {
    const form = document.getElementById('addProductForm');
    const hasData = form.querySelector('input[type="text"]').value || 
                    form.querySelector('textarea').value || 
                    document.getElementById('input1').files.length > 0;
    
    if (hasData) {
        if (confirm('Are you sure you want to refresh? Any unsaved changes will be lost.')) {
            location.reload();
        }
    } else {
        location.reload();
    }
});

// Enhanced form submission with loading state
const originalSubmitHandler = document.getElementById('addProductForm').onsubmit;
document.getElementById('addProductForm').addEventListener('submit', function(e) {
    e.preventDefault();

    if (validateForm()) {
        // Show loading state
        const submitBtn = document.querySelector('.btn-add');
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
        submitBtn.style.cursor = 'not-allowed';

        Swal.fire({
            title: 'Success!',
            text: 'Product added successfully!',
            icon: 'success',
            confirmButtonText: 'OK',
            allowOutsideClick: false,
            background: '#c4a574',
            color: '#2c2c2c',
            confirmButtonColor: '#5a4a3a'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById("addProductForm").submit();
            } else {
                // Reset button if cancelled
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
                submitBtn.style.cursor = 'pointer';
            }
        });
    }
});

