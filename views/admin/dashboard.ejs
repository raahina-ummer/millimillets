<%- include('../partials/admin/header.ejs') %>

<!-- ================= DASHBOARD STYLES ================= -->
<style>
  .dashboard-container {
    padding: 40px;
    background-color: #d4c4a8;
    min-height: 100vh;
  }

  /* Page header */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    flex-wrap: wrap;
    gap: 15px;
  }

  .page-header h1 {
    font-size: 32px;
    font-weight: 700;
    color: #2d2d2d;
  }

  /* Cards */
  .card {
    background: #ffffff;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    height: 100%;
  }

  .card h3,
  .card h5 {
    font-weight: 700;
    color: #2d2d2d;
    margin-bottom: 15px;
  }

  /* KPI cards */
  .stat-card h6 {
    font-size: 13px;
    font-weight: 600;
    color: #777;
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .stat-card h3 {
    font-size: 24px;
    font-weight: 800;
    color: #2d2d2d;
  }

  /* Tables */
  table thead {
    background: #8b7355;
    color: #ffffff;
  }

  table th,
  table td {
    font-size: 14px;
    vertical-align: middle;
  }

  /* Order status */
  .status-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .status-list li {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #eee;
    font-weight: 600;
    color: #5a4632;
  }

  .status-list li:last-child {
    border-bottom: none;
  }

  /* Category rows */
  .category-row {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #eee;
    font-size: 14px;
    color: #5a4632;
  }

  .category-row:last-child {
    border-bottom: none;
  }

  .category-row strong {
    font-weight: 800;
    color: #2d2d2d;
  }

  /* Chart */
  .chart-box {
    height: 300px;
  }


  .header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.date-filter {
  display: flex;
  gap: 8px;
}

.date-filter input {
  padding: 6px 10px;
  border-radius: 6px;
  border: 1px solid #ccc;
  font-size: 14px;
}

.date-filter button {
  background: #8b7355;
  color: #fff;
  border: none;
  padding: 6px 14px;
  border-radius: 6px;
  cursor: pointer;
}
/* Sales Report button */
.sales-report-btn {
  border: 1px solid #2d2d2d;
  color: #2d2d2d;
  background: transparent;
  transition: all 0.2s ease;
}

.sales-report-btn:hover {
  background:#8b7355;   /* dark hover */
  color: #ffffff;
  border-color: #2d2d2d;
}

/* Apply button stays brown */
.date-filter button {
  background: #8b7355;
  color: #ffffff;
}

.date-filter button:hover {
  background: #755e45;   /* darker brown */
}


  @media (max-width: 768px) {
    .dashboard-container {
      padding: 20px;
    }
  }
</style>

<!-- ================= DASHBOARD CONTENT ================= -->
<div class="dashboard-container">

  <!-- Header -->
  <div class="page-header">
  <!-- LEFT -->
  <h1>Overview</h1>

  <!-- RIGHT -->
  <div class="header-actions">
   

    <form id="dateFilterForm" method="GET" action="/admin/dashboard" class="date-filter">
      <input type="date" name="fromDate" value="<%= fromDate || '' %>">
      <input type="date" name="toDate" value="<%= toDate || '' %>">
      <button type="submit">Apply</button>
    </form>

  </div>
</div>
      <!-- <% if (fromDate && toDate) { %>
  <p class="text-muted">
    Showing results from <strong><%= fromDate %></strong> to <strong><%= toDate %></strong>
  </p>
<% } %> -->


  <!-- ================= KPI ROW ================= -->
  <div class="row g-4 mb-4">
    <div class="col-lg-3 col-md-6">
      <div class="card stat-card">
        <h6>Total Orders</h6>
        <h3><%= totalOrders %></h3>
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card stat-card">
        <h6>Total Revenue</h6>
       <h3>₹ <%= totalRevenue.toFixed(2) %></h3>

      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card stat-card">
        <h6>Total Customers</h6>
        <h3><%= totalUsers %></h3>
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div class="card stat-card">
        <h6>Total Products</h6>
        <h3><%= totalProducts %></h3>
      </div>
    </div>
  </div>

  <!-- ================= CHART + CUSTOMER ================= -->
  <div class="row g-4 mb-4">
    <div class="col-lg-8">
      <div class="card">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3>Sales Overview</h3>
          <select id="salesFilter" class="form-select w-auto">
            <option value="daily">Daily</option>
            <option value="weekly">Weekly</option>
            <option value="monthly" selected>Monthly</option>
            <option value="yearly">Yearly</option>
          </select>
        </div>
        <div class="chart-box">
          <canvas id="salesChart"></canvas>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card">
        <h3>Order Status</h3>
        <ul class="status-list">
          <li>Live Orders <span><%= liveOrders %></span></li>
          <li>Pending Orders <span><%= pendingOrders %></span></li>
          <li>Delivered Orders <span><%= deliveredOrders %></span></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ================= PRODUCTS + CATEGORIES ================= -->
  <div class="row g-4">
    <div class="col-lg-6">
      <div class="card">
        <h3>Top 10 Best Selling Products</h3>
        <table class="table table-sm mt-3">
  <thead>
    <tr>
      <th>Product</th>
      <th>Sold</th>
    </tr>
  </thead>
<tbody>
  <% bestProducts.forEach(p => { %>
    <tr>
      <td><%= p.product.productName %></td>
      <td><%= p.totalSold %></td>
    </tr>
  <% }) %>
</tbody>

</table>

      </div>
    </div>

    <div class="col-lg-6">
      <div class="card">
        <h3>Top 10 Best Selling Categories</h3>
        <% bestCategories.forEach(cat => { %>
          <div class="category-row">
            <span><%= cat.category.name %></span>
            <strong><%= cat.totalSold %></strong>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

</div>

<!-- ================= SCRIPTS ================= -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
let salesChart;

function getDateParams() {
  const fromDate = document.querySelector('input[name="fromDate"]')?.value;
  const toDate = document.querySelector('input[name="toDate"]')?.value;

  const params = new URLSearchParams({
    filter: document.getElementById("salesFilter").value
  });

  if (fromDate && toDate) {
    params.append("fromDate", fromDate);
    params.append("toDate", toDate);
  }

  return params;
}

async function loadSalesChart() {
  const params = getDateParams();

  const res = await fetch(`/admin/dashboard/sales-chart?${params.toString()}`);
  const result = await res.json();

  const filter = document.getElementById("salesFilter").value;

  const labels = result.data.map(d =>
    filter === "yearly" ? d._id.year :
    filter === "monthly" ? `${d._id.month}/${d._id.year}` :
    filter === "weekly" ? `Week ${d._id.week}` :
    `${d._id.day}/${d._id.month}`
  );

  const values = result.data.map(d => d.totalRevenue);

  if (salesChart) salesChart.destroy();

  salesChart = new Chart(document.getElementById("salesChart"), {
    type: "bar",
    data: {
      labels,
      datasets: [{
        data: values,
        backgroundColor: "#8b7355",
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: { y: { beginAtZero: true } }
    }
  });
}

// Initial load
document.addEventListener("DOMContentLoaded", loadSalesChart);

// Filter change
document.getElementById("salesFilter")
  .addEventListener("change", loadSalesChart);


document.querySelector('input[name="fromDate"]')
  .addEventListener("change", e => {
    document.querySelector('input[name="toDate"]').min = e.target.value;
  });

document.getElementById("dateFilterForm")
  .addEventListener("submit", function (e) {
    const fromDate = document.querySelector('input[name="fromDate"]').value;
    const toDate = document.querySelector('input[name="toDate"]').value;

    if ((fromDate && !toDate) || (!fromDate && toDate)) {
      e.preventDefault();
      alert("Please select both From and To dates");
    }
  });




</script>


<%- include('../partials/admin/footer.ejs') %>
