.page-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

/* LEFT SIDE */
.header-left {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.title-search {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

/* SEARCH */
.product-search-form {
  display: flex;
  gap: 6px;
}

.product-search-input {
  padding: 7px 12px;
  border-radius: 6px;
  border: 1px solid #ccc;
  font-size: 14px;
  min-width: 220px;
}

.btn-search {
  padding: 7px 12px;
  border-radius: 6px;
