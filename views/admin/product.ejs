    }

    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .pagination-info {
        font-size: 13px;
        color: #666;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 6px;
    }

    .page-link {
        background: rgba(139, 115, 85, 0.2);
        border: 1px solid rgba(139, 115, 85, 0.3);
