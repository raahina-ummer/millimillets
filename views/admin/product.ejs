    }


    .old-price {
  text-decoration: line-through;
  color: #999;
  font-size: 13px;
}

.new-price {
  font-weight: 700;
  color: #28a745;
  margin-left: 6px;
}

.offer-badge {
  background: #dc3545;
  color: white;
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 4px;
  margin-left: 6px;
}

.offer-btn.active-offer {
  background: #28a745;
  color: white;
