        .main-content {
            margin-left: 0;
            padding: 20px;
        }

        .page-header-row {
            flex-direction: column;
            gap: 12px;
        }

        .btn-add-product {
            width: 100%;
            justify-content: center;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .table-responsive {
            overflow-x: auto;
        }

