<%- include('../partials/admin/header.ejs') %>

<style>
    body {
        background-color: #2c2c2c;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
    }

    .admin-container {
        display: flex;
        min-height: 100vh;
    }

    /* Sidebar Styles */
    .sidebar {
        width: 250px;
        background-color: #3a3a3a;
        padding: 0;
        position: fixed;
        height: 100vh;
        left: 0;
        top: 0;
    }

    .logo-section {
        background-color: #E8DCC4;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .logo-icon {
        width: 28px;
        height: 28px;
        color: #8B6F47;
    }

    .logo-text {
        font-size: 16px;
        font-weight: 600;
        color: #8B6F47;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .sidebar-menu {
        padding: 20px 0;
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 20px;
        color: #ccc;
        text-decoration: none;
        transition: all 0.3s;
        font-size: 14px;
        border-left: 3px solid transparent;
    }

    .menu-item:hover,
    .menu-item.active {
        background-color: #4a4a4a;
        color: #fff;
        border-left-color: #B8A572;
    }

    .menu-item i {
        font-size: 18px;
        width: 20px;
    }

    /* Main Content Area */
    .content-main {
        margin-left: 0px;
        background-color: #E8DCC4;
        min-height: 100vh;
        padding: 0;
        width: 100%;
    }

    .admin-header {
        background-color: #E8DCC4;
        padding: 20px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
       
    }

    .search-box {
        flex: 1;
        max-width: 400px;
    }

    .search-box input {
        width: 100%;
        padding: 10px 20px 10px 40px; border-bottom: 1px solid #d4c5a9;
        border-radius: 20px;
        border: 1px solid #d4c5a9;
        background-color: #fff;
        font-size: 14px;
    }

    .search-box-wrapper {
        position: relative;
    }

    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #999;
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .user-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        background-color: #8B6F47;
    }

    .user-info {
        text-align: right;
    }

    .user-name {
        font-size: 13px;
        font-weight: 600;
        color: #2c2c2c;
        margin: 0;
    }

    .user-role {
        font-size: 11px;
        color: #666;
        margin: 0;
    }

    /* Page Content */
    .page-container {
        padding: 30px;
    }

    .page-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-title-with-refresh {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-title {
        font-size: 24px;
        font-weight: 600;
        color: #2c2c2c;
        margin: 0;
    }

    .refresh-btn {
        background: none;
        border: none;
        color: #666;
        cursor: pointer;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: color 0.3s;
         margin-bottom: 25px
    }

    .refresh-btn:hover {
        color: #2c2c2c;
    }

    .btn-add-product {
        background-color: #8b7355;
        color: #fff;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.3s;
        border: none;
        cursor: pointer;
    }

    .btn-add-product:hover {
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        color: #fff;
    }

    /* Table Card */
    .table-card {
        background-color: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .table-responsive {
        overflow-x: auto;
    }

    .product-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

    .product-table thead {
        background-color: #f8f8f8;
    }

    .product-table thead th {
        padding: 15px 12px;
        font-size: 11px;
        font-weight: 600;
        color: #666;
        text-transform: uppercase;
        border-bottom: 2px solid #e8e8e8;
        text-align: left;
        white-space: nowrap;
    }

    .product-table tbody td {
        padding: 15px 12px;
        font-size: 13px;
        color: #2c2c2c;
        border-bottom: 1px solid #f5f5f5;
        vertical-align: middle;
    }

    .product-table tbody tr:hover {
        background-color: #f9f9f9;
    }

    .product-img-wrapper {
        width: 45px;
        height: 45px;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f5f5f5;
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Action Icons */
    .action-icons {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .icon-btn {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s;
        border: none;
        background-color: transparent;
    }

    .icon-btn.edit-btn {
        color: #666;
    }

    .icon-btn.edit-btn:hover {
        background-color: #f0f0f0;
        color: #2c2c2c;
    }

    .icon-btn.delete-btn {
        background-color: #2c2c2c;
        color: #fff;
    }

    .icon-btn.delete-btn:hover {
        background-color: #1a1a1a;
    }

    /* Pagination */
    .pagination-area {
        margin-top: 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 5px;
    }

    .pagination {
        display: flex;
        gap: 5px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .page-item .page-link {
        border: none;
        background-color: #fff;
        color: #2c2c2c;
        border-radius: 6px;
        padding: 8px 12px;
        font-weight: 500;
        font-size: 13px;
        text-decoration: none;
        transition: all 0.3s;
        min-width: 36px;
        text-align: center;
    }

    .page-item.active .page-link {
        background-color: #2c2c2c;
        color: #fff;
    }

    .page-item.disabled .page-link {
        background-color: #f5f5f5;
        color: #ccc;
        cursor: not-allowed;
    }

    .page-item:not(.disabled) .page-link:hover {
        background-color: #e8dcc4;
    }

    @media (max-width: 992px) {
        .sidebar {
            width: 70px;
        }

        .logo-text,
        .menu-item span {
            display: none;
        }

        .content-main {
            margin-left: 70px;
            width: calc(100% - 70px);
        }
    }
</style>

<div class="admin-container">
    <!-- Content Area -->
    <div class="content-main">
       
       <!-- Page Content -->
<div class="page-container">
    <div class="page-header-row">
        <h1 class="page-title">Product Management</h1>
        <a href="/admin/addProduct" class="btn-add-product">
            ADD PRODUCT
        </a>
    </div>
    
    <button class="refresh-btn" onclick="location.reload()">
        <i class="fas fa-sync-alt"></i> Refresh
    </button>

            <div class="table-card">
                <div class="table-responsive">
                    <table class="product-table">
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th>Product ID</th>
                                <th>Qty</th>
                                <th>Price</th>
                                <th>GST</th>
                                <th>Category</th>
                                <th>Unit/Type</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (let i = 0; i < data.length; i++) { %>
                                <tr>
                                    <!-- Product Name with Image -->
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 12px;">
                                            <div class="product-img-wrapper">
                                                <img
                                                    src="/uploads/images/<%= data[i].productImage[0] %>"
                                                    alt="<%= data[i].productName %>"
                                                    class="product-img"
                                                />
                                            </div>
                                            <span><%= data[i].productName %></span>
                                        </div>
                                    </td>
                                    
                                    <!-- Product ID -->
                                    <td>#<%= data[i].brand || '534726' %></td>
                                    
                                    <!-- Quantity -->
                                    <td><%= data[i].quantity %></td>
                                    
                                    <!-- Price -->
                                    <td><%= data[i].salePrice ? data[i].salePrice : data[i].regularPrice %></td>
                                    
                                    <!-- GST -->
                                    <!-- <td><%= data[i].category.categoryOffer || '18' %>%</td> -->
                                    
                                    <!-- Category -->
                                    <td><%= data[i].category.name %></td>
                                    
                                    <!-- Unit/Type -->
                                    <td>grm</td>
                                    
                                    <!-- Actions -->
                                    <td>
                                        <div class="action-icons">
                                            <a href="/admin/editProduct?id=<%= data[i]._id %>" class="icon-btn edit-btn" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <% if(data[i].isBlocked === false) { %>
                                                <a href="/admin/blockProduct?id=<%= data[i]._id %>" class="icon-btn delete-btn" title="Block Product" style="background-color:#28a745 ;">
                                                    <i class="fas fa-ban"></i>
                                                </a>
                                            <% } else { %>
                                                <a href="/admin/unblockProduct?id=<%= data[i]._id %>" class="icon-btn delete-btn" title="Unblock Product" style="background-color: #e92b3b;">
                                                    <i class="fas fa-check-circle"></i>
                                                </a>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="pagination-area">
                <nav aria-label="Page navigation">
                    <ul class="pagination">
                        <li class="page-item <%= currentpage === 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="?page=<%= currentpage - 1 %>">1</a>
                        </li>
                        
                        <li class="page-item active">
                            <a class="page-link" href="?page=2">2</a>
                        </li>
                        
                        <li class="page-item">
                            <a class="page-link" href="?page=3">3</a>
                        </li>
                        
                        <li class="page-item <%= currentpage === totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="?page=<%= currentpage + 1 %>">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script>
// Search functionality
document.getElementById('searchInput').addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const rows = document.querySelectorAll('.product-table tbody tr');
    
    rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(searchTerm) ? '' : 'none';
    });
});

// Delete product function
function deleteProduct(productId) {
    Swal.fire({
        title: 'Are you sure?',
        text: "You won't be able to revert this!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Yes, delete it!'
    }).then((result) => {
        if (result.isConfirmed) {
            $.ajax({
                url: '/admin/deleteProduct',
                method: 'POST',
                data: { productId: productId },
                success: (response) => {
                    if (response.status === true) {
                        Swal.fire({
                            text: 'Product has been deleted successfully',
                            icon: 'success',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Failed', response.message || 'Failed to delete product', 'error');
                    }
                },
                error: (err) => {
                    console.error(err);
                    Swal.fire('Error', 'There was an error processing your request', 'error');
                }
            });
        }
    });
}

// Add offer function (if needed)
function addOffer(productId) {
    // Your add offer implementation
    window.location.href = `/admin/addProductOffer?id=${productId}`;
}

// Remove offer function (if needed)
function removeOffer(productId) {
    // Your remove offer implementation
    window.location.href = `/admin/removeProductOffer?id=${productId}`;
}
</script>

<%- include('../partials/admin/footer.ejs') %>
