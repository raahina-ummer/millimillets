</style>

<div class="main-content">
    <!-- Page Header -->
    <div class="page-header">
  <div class="page-header-row">

    <!-- LEFT -->
    <div class="header-left">
      <div class="title-search">
        <h1 class="page-title">Product Management</h1>

        <form method="GET" action="/admin/products" class="product-search-form">
          <input
            type="text"
            name="search"
            placeholder="Search products..."
            value="<%= search || '' %>"
            class="product-search-input"
          />
          <button type="submit" class="btn-search">
            <i class="fas fa-search"></i>
          </button>
        </form>
      </div>

      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item">
            <a href="/admin/dashboard">Dashboard</a>
          </li>
          <li class="breadcrumb-item active" aria-current="page">Products</li>
        </ol>
      </nav>
    </div>

    <!-- RIGHT -->
    <div class="action-buttons">
      <a href="/admin/addProduct" class="btn-add-product">
        <i class="fas fa-plus"></i> Add Product
      </a>

      <button class="refresh-btn" onclick="location.reload()">
        <i class="fas fa-sync-alt"></i>
      </button>
    </div>

  </div>
</div>


    <!-- Products Table -->
    <div class="table-card">
        <div class="table-responsive">
            <table class="product-table">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Stock</th>
                        <th>Price</th>
                        <th>GST</th>
                        <th>Category</th>
                        <th>Unit Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (data && data.length > 0) { %>
                        <% data.forEach((product) => { %>
                            <tr>
                                <td>
                                    <div class="product-info">
                                        <div class="product-img-wrapper">
                                            <img
                                                src="/uploads/images/<%= product.productImage[0] %>"
                                                alt="<%= product.productName %>"
                                                class="product-img"
                                            />
                                        </div>
                                        <span class="product-name"><%= product.productName %></span>
                                    </div>
                                </td>
                                <!-- <td>#<%= product.brand || 'N/A' %></td> -->
                                <td><%= product.variant && product.variant.length > 0 ? product.variant[0].stock : 0 %></td>
                                <td>
  <% if (product.hasOffer) { %>
    <div class="price-with-offer">
      <span class="old-price">₹<%= product.strikePrice %></span>
      <span class="new-price">₹<%= product.finalPrice %></span>
    </div>
  <% } else { %>
    ₹<%= product.basePrice %>
  <% } %>
</td>


                                <td><%= product.gst %></td>
                                <td><%= product.category?.name || 'N/A' %></td>
                                <td><%= product.variant && product.variant.length > 0 ? product.variant[0].unitType : 'N/A' %></td>
                                <td>
                                    <div class="action-icons">
                                        <a href="/admin/editProduct?id=<%= product._id %>" class="icon-btn edit-btn" title="Edit Product">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                       <% if (product.hasOffer) { %>
  <button class="icon-btn offer-btn active-offer"
    onclick="openOfferModal('<%= product._id %>', '<%= product.productName %>')"
    title="Edit Offer">
    <i class="fas fa-tag"></i>
  </button>
<% } else { %>
  <button class="icon-btn offer-btn add-offer"
    onclick="openOfferModal('<%= product._id %>', '<%= product.productName %>')"
    title="Add Offer">
    <i class="fas fa-plus-circle"></i>
  </button>
<% } %>

                                        <% if(product.isBlocked === false) { %>
                                            <a href="/admin/blockProduct?id=<%= product._id %>" class="icon-btn block-btn" title="Block Product">
                                                <i class="fas fa-ban"></i>
                                            </a>
                                        <% } else { %>
                                            <a href="/admin/unblockProduct?id=<%= product._id %>" class="icon-btn unblock-btn" title="Unblock Product">
                                                <i class="fas fa-check-circle"></i>
                                            </a>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" style="text-align: center; padding: 40px 20px; color: #999;">
                                No products found
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
        <div class="pagination-container">
            <div class="pagination-info">
                Showing <%= ((currentPage - 1) * 10) + 1 %>-<%= Math.min(currentPage * 10, totalProducts) %> from <%= totalProducts %>

            </div>
            <nav>
                <ul class="pagination">
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                            <a class="page-link" href="/admin/products?page=<%= i %>&search=<%= search || '' %>">
                                <%= i < 10 ? '0' + i : i %>
                            </a>
                        </li>
                    <% } %>
                </ul>
            </nav>
        </div>
    <% } %>
</div>

<!-- Edit Offer Modal -->
<div id="offerModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeOfferModal()">&times;</span>
        <h2>Edit Product Offer</h2>

        <form id="offerForm">
            <input type="hidden" id="productId" name="productId" />

            <div class="form-group full">
                <label for="productTitle">Product Name</label>
                <input type="text" id="productTitle" disabled style="background-color: #f5f5f5; cursor: not-allowed;" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="discountPercentage">Discount %</label>
                    <input type="number" id="discountPercentage" name="discountPercentage" min="0" max="100" placeholder="0" />
                    <div id="discountError" class="error-message">Discount must be between 0 and 100</div>
                </div>
                <div class="form-group">
                    <label for="maxDiscountAmount">Max Discount Amount (₹)</label>
                    <input type="number" id="maxDiscountAmount" name="maxDiscountAmount" min="0" placeholder="0" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="offerDescription">Offer Description</label>
                    <input type="text" id="offerDescription" name="offerDescription" placeholder="e.g., Festival Sale, Clearance" />
                </div>
                <div class="form-group">
                    <label for="offerActive">Status</label>
                    <select id="offerActive" name="offerActive">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="offerStartDate">Start Date</label>
                    <input type="date" id="offerStartDate" name="offerStartDate" />
                </div>
                <div class="form-group">
                    <label for="offerEndDate">End Date</label>
                    <input type="date" id="offerEndDate" name="offerEndDate" />
                </div>
            </div>

            <div class="btn-group">
                <button type="submit" class="btn btn-primary">Save Offer</button>
                <button type="button" class="btn btn-secondary" onclick="closeOfferModal()">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script>
    
    const modal = document.getElementById('offerModal');
    const offerForm = document.getElementById('offerForm');

    function openOfferModal(productId, productName) {
        document.getElementById('productId').value = productId;
        document.getElementById('productTitle').value = productName;
        modal.style.display = 'block';

        // Fetch existing offer data if any
        fetchOfferData(productId);
    }

    function closeOfferModal() {
        modal.style.display = 'none';
        offerForm.reset();
    }

    function fetchOfferData(productId) {
    fetch(`/admin/product-offer/${productId}`) // ✅ Now this route exists
        .then(response => response.json())
        .then(data => {
            if (data.success && data.offer) {
                document.getElementById('discountPercentage').value = data.offer.discountPercentage || 0;
                document.getElementById('maxDiscountAmount').value = data.offer.maxDiscountAmount || 0;
                document.getElementById('offerDescription').value = data.offer.offerDescription || '';
                document.getElementById('offerActive').value = data.offer.offerActive ? 'true' : 'false';
                document.getElementById('offerStartDate').value = data.offer.offerStartDate ? new Date(data.offer.offerStartDate).toISOString().split('T')[0] : '';
                document.getElementById('offerEndDate').value = data.offer.offerEndDate ? new Date(data.offer.offerEndDate).toISOString().split('T')[0] : '';
            }
        })
        .catch(error => console.error('Error fetching offer:', error));
}

    offerForm.addEventListener('submit', async function(e) {
        e.preventDefault();

        const productId = document.getElementById('productId').value;
        const discountPercentage = parseInt(document.getElementById('discountPercentage').value);
        const maxDiscountAmount = parseInt(document.getElementById('maxDiscountAmount').value) || null;
        const offerDescription = document.getElementById('offerDescription').value;
        const offerActive = document.getElementById('offerActive').value === 'true';
        const offerStartDate = document.getElementById('offerStartDate').value;
        const offerEndDate = document.getElementById('offerEndDate').value;

        if (isNaN(discountPercentage) || discountPercentage < 0 || discountPercentage > 100) {
            document.getElementById('discountError').style.display = 'block';
            return;
        }

        document.getElementById('discountError').style.display = 'none';

        try {
            
            const response = await fetch(`/admin/product-offer/update`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productId: productId, 
                    discountPercentage,
                    maxDiscountAmount,
                    offerDescription,
                    offerActive,
                    offerStartDate,
                    offerEndDate
                })
            });

            const data = await response.json();

            if (data.success || response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: 'Offer updated successfully',
                    confirmButtonColor: '#8b7355'
                }).then(() => {
                    closeOfferModal();
                    location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: data.message || 'Failed to update offer',
                    confirmButtonColor: '#8b7355'
                });
            }
        } catch (error) {
            console.error('Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: 'An error occurred while updating the offer',
                confirmButtonColor: '#8b7355'
            });
        }
    });

    window.addEventListener('click', function(event) {
        if (event.target === modal) {
            closeOfferModal();
        }
    });
</script>

<%- include('../partials/admin/footer.ejs') %>