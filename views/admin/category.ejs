<%- include('../partials/admin/header.ejs') %>

    <style>
        :root {
            --primary-bg: #d4c4a8;
            --card-bg: #ffffff;
            --text-dark: #2d2d2d;
            --text-muted: #6c757d;
            --border-color: #e0e0e0;
        }

        body {
            background-color: var(--primary-bg);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .main-content {
            padding: 30px;
            margin-left: 250px;
        }

        .page-header {
            margin-bottom: 10px;
            
        }

        .page-title {
            font-size: 28px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 10px;
        }

        .breadcrumb {
            background: transparent;
            padding: 0;
            margin-bottom: 0;
            font-size: 14px;
        }

        .breadcrumb-item {
            color: var(--text-muted);
        }

        .breadcrumb-item.active {
            color: #a89575;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            content: "›";
            color: var(--text-muted);
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            justify-content: flex-end;
        }
        .action-buttons {
            display: flex;
  gap: 15px;
  margin-bottom: 10px;
  justify-content: flex-end;
  margin-top: 15px; /* this moves buttons slightly down */
}


        .btn-export {
            background-color: white;
            border: 1px solid var(--border-color);
            color: var(--text-dark);
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
        }

        .btn-export:hover {
            background-color: #f8f9fa;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .btn-create {
            background-color: #8b7355;
            border: none;
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
        }

        .btn-create:hover {
            background-color: #75624a;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }

        .table-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .table {
            margin-bottom: 0;
        }

        .table thead {
            background-color: #f8f9fa;
        }

        .table thead th {
            border-bottom: 2px solid var(--border-color);
            padding: 16px;
            font-weight: 600;
            font-size: 14px;
            color: var(--text-dark);
            text-transform: capitalize;
        }

        .table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
            color: var(--text-dark);
        }

        .table tbody tr:last-child td {
            border-bottom: none;
        }

        .table tbody tr:hover {
            background-color: #fafafa;
        }

        .category-checkbox {
            width: 18px;
            height: 18px;
            cursor: pointer;
            border-radius: 4px;
        }

        .category-image {
            width: 50px;
            height: 50px;
            background-color: #e8e8e8;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
        }

        .category-info {
            display: flex;
            align-items: center;
        }

        .category-name {
            font-weight: 500;
            color: var(--text-dark);
        }

        .action-icons {
            display: flex;
            gap: 10px;
        }

        .action-icon {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s;
            color: var(--text-muted);
            background-color: transparent;
            border: none;
        }

        .action-icon:hover {
            background-color: #f0f0f0;
        }

        .action-icon.edit:hover {
            color: #8b7355;
            background-color: #f5f0eb;
        }

        .action-icon.view:hover {
            color: #0d6efd;
            background-color: #e7f1ff;
        }

        .action-icon.delete:hover {
            color: #dc3545;
            background-color: #fee;
        }

        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 24px;
            border-top: 1px solid var(--border-color);
        }

        .pagination-info {
            font-size: 14px;
            color: var(--text-muted);
        }

        .pagination {
            margin-bottom: 0;
            gap: 5px;
        }

        .page-link {
            border: 1px solid var(--border-color);
            color: var(--text-dark);
            padding: 8px 14px;
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.3s;
        }

        .page-link:hover {
            background-color: #f8f9fa;
            border-color: var(--border-color);
            color: var(--text-dark);
        }

        .page-item.active .page-link {
            background-color: #8b7355;
            border-color: #8b7355;
            color: white;
        }

        .page-item.disabled .page-link {
            background-color: white;
            border-color: var(--border-color);
            color: #ccc;
        }

        .dropdown-toggle::after {
            margin-left: 8px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .main-content {
                margin-left: 0;
                padding: 20px;
            }

            .action-buttons {
                flex-direction: column;
            }

            .btn-export, .btn-create {
                width: 100%;
                justify-content: center;
            }
        }
    </style>

<body>
   

     
        <!-- Page Header with Action Buttons -->
<div class="page-header d-flex justify-content-between align-items-center flex-wrap">
    <div>
        <h1 class="page-title mb-1">Categories</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/dashboard" style="text-decoration: none; color: inherit;">Dashboard</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Categories</li>
            </ol>
        </nav>
    </div>

    <div class="action-buttons">
        <button class="btn btn-export">
            <i class="fas fa-download"></i>
            Export
        </button>
       <a href="/admin/addCategory" class="btn btn-create">
        <i class="fas fa-plus"></i>
        Create Category
    </a>
    </div>
    </div>


        <!-- Table Card -->
        <div class="table-card">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 50px;">
                                <input type="checkbox" class="category-checkbox" id="selectAll">
                            </th>
                            <th>
                                Category Name
                                <i class="fas fa-sort ms-1" style="font-size: 12px; color: #999;"></i>
                            </th>
                            <th>
                                Sold
                                <i class="fas fa-sort ms-1" style="font-size: 12px; color: #999;"></i>
                            </th>
                            <th>
                                Stock
                                <i class="fas fa-sort ms-1" style="font-size: 12px; color: #999;"></i>
                            </th>
                            <th>
                                Added
                                <i class="fas fa-sort ms-1" style="font-size: 12px; color: #999;"></i>
                            </th>
                            <th>Action</th>
                        </tr>
                    </thead>
                      <tbody>
  <% if (cat && cat.length > 0) { %>
    <% cat.forEach((category, index) => { %>
      <tr>
        <td>
          <input type="checkbox" class="category-checkbox">
        </td>
        <td>
          <div class="category-info">
            <div class="category-image">
              <i class="fas fa-image" style="color: #ccc;"></i>
            </div>
            <span class="category-name"><%= category.name %></span>
          </div>
        </td>
        <td><%= category.sold || 0 %></td>
        <td><%= category.stock || 0 %></td>
        <td><%= category.createdAt ? category.createdAt.toDateString() : "N/A" %></td>
        <td>
          <div class="action-icons">
            <button class="action-icon edit" data-id="<%= category._id %>">
              <i class="fas fa-pen"></i>
            </button>
            <button class="action-icon view" data-id="<%= category._id %>">
              <i class="fas fa-eye"></i>
            </button>
            <button class="action-icon delete" data-id="<%= category._id %>">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        </td>
      </tr>
    <% }) %>
  <% } else { %>
    <tr>
      <td colspan="6" class="text-center">No categories found.</td>
    </tr>
  <% } %>
                </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="pagination-container">
                <div class="pagination-info">
                    Showing 1-10 from 100
                </div>
                <nav>
                    <ul class="pagination">
                        <li class="page-item disabled">
                            <a class="page-link" href="#" tabindex="-1">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>
                        <li class="page-item active">
                            <a class="page-link" href="#">01</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="#">02</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="#">03</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="#">04</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="#">05</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="#">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Select All Checkbox
        document.getElementById('selectAll').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.category-checkbox:not(#selectAll)');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        // Individual checkbox change
        document.querySelectorAll('.category-checkbox:not(#selectAll)').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const allCheckboxes = document.querySelectorAll('.category-checkbox:not(#selectAll)');
                const checkedCheckboxes = document.querySelectorAll('.category-checkbox:not(#selectAll):checked');
                document.getElementById('selectAll').checked = allCheckboxes.length === checkedCheckboxes.length;
            });
        });

   
  // Edit button click
  document.querySelectorAll(".action-icon.edit").forEach(button => {
    button.addEventListener("click", function() {
      const categoryId = this.getAttribute("data-id");
      window.location.href = `/admin/editCategory?id=${categoryId}`;
    });
  });

  // Delete button click with confirmation
  document.querySelectorAll(".action-icon.delete").forEach(button => {
    button.addEventListener("click", function() {
      const categoryId = this.getAttribute("data-id");
      const confirmDelete = confirm("Are you sure you want to delete this category?");
      if (confirmDelete) {
        window.location.href = `/admin/deleteCategory?id=${categoryId}`;
      }
    });
  });


    </script>
</body>
</html>



















   