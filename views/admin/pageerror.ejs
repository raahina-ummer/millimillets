<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found | MilliMillet</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #2a2a2a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .error-container {
            background: linear-gradient(135deg, #e8dcc0 0%, #d4c4a0 100%);
            border-radius: 20px;
            padding: 80px 60px;
            max-width: 600px;
            width: 100%;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            position: relative;
            overflow: hidden;
        }

        .error-container::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(139, 111, 71, 0.1) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .error-content {
            position: relative;
            z-index: 1;
        }

        .error-icon {
            font-size: 80px;
            color: #8b6f47;
            margin-bottom: 30px;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        .error-title {
            font-size: 48px;
            font-weight: 800;
            color: #2a2a2a;
            margin-bottom: 20px;
            letter-spacing: -1px;
        }

        .error-code {
            font-size: 18px;
            font-weight: 600;
            color: #dc3545;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .error-message {
            font-size: 16px;
            color: #5a4a2a;
            margin-bottom: 40px;
            line-height: 1.6;
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: #dc3545;
            color: white;
            padding: 15px 40px;
            border-radius: 50px;
            text-decoration: none;
            font-size: 16px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
        }

        .back-button:hover {
            background: #c82333;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(220, 53, 69, 0.4);
        }

        .back-button i {
            font-size: 18px;
            transition: transform 0.3s ease;
        }

        .back-button:hover i {
            transform: translateX(-5px);
        }

        .decoration {
            position: absolute;
            opacity: 0.1;
            pointer-events: none;
        }

        .decoration-1 {
            top: 20px;
            left: 20px;
            font-size: 60px;
            color: #8b6f47;
        }

        .decoration-2 {
            bottom: 20px;
            right: 20px;
            font-size: 60px;
            color: #8b6f47;
            transform: rotate(180deg);
        }

        .decoration-3 {
            top: 50%;
            left: 10px;
            font-size: 40px;
            color: #8b6f47;
            transform: translateY(-50%);
        }

        .decoration-4 {
            top: 50%;
            right: 10px;
            font-size: 40px;
            color: #8b6f47;
            transform: translateY(-50%) rotate(180deg);
        }

        /* Alternative links */
        .helper-links {
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid rgba(90, 74, 42, 0.2);
        }

        .helper-links p {
            font-size: 14px;
            color: #5a4a2a;
            margin-bottom: 15px;
        }

        .helper-links a {
            color: #8b6f47;
            text-decoration: none;
            font-weight: 500;
            margin: 0 10px;
            transition: all 0.3s ease;
        }

        .helper-links a:hover {
            color: #6f5838;
            text-decoration: underline;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .error-container {
                padding: 60px 30px;
            }

            .error-title {
                font-size: 36px;
            }

            .error-icon {
                font-size: 60px;
            }

            .error-code {
                font-size: 16px;
            }

            .error-message {
                font-size: 14px;
            }

            .back-button {
                padding: 12px 30px;
                font-size: 14px;
            }

            .decoration-1, .decoration-2 {
                font-size: 40px;
            }

            .decoration-3, .decoration-4 {
                font-size: 30px;
            }
        }

        @media (max-width: 480px) {
            .error-container {
                padding: 40px 20px;
            }

            .error-title {
                font-size: 28px;
            }

            .error-icon {
                font-size: 50px;
            }

            .helper-links a {
                display: block;
                margin: 5px 0;
            }
        }
    </style>
</head>
<body>
    <div class="error-container">
        <!-- Decorative elements -->
        <i class="fas fa-seedling decoration decoration-1"></i>
        <i class="fas fa-seedling decoration decoration-2"></i>
        <i class="fas fa-leaf decoration decoration-3"></i>
        <i class="fas fa-leaf decoration decoration-4"></i>

        <div class="error-content">
            <!-- Error Icon -->
            <div class="error-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>

            <!-- Error Title -->
            <h1 class="error-title">Oops!</h1>

            <!-- Error Code -->
            <p class="error-code">Error 404 - Page not found</p>

            <!-- Error Message -->
            <p class="error-message">
                Your visited page not found. You may go home page.
            </p>

            <!-- Back Button -->
            <a href="/" class="back-button">
                <i class="fas fa-arrow-left"></i>
                Back to home page
            </a>

            <!-- Helper Links -->
            <div class="helper-links">
                <p>Or try these helpful links:</p>
                <a href="/"><i class="fas fa-home"></i> Home</a>
                <a href="/products"><i class="fas fa-shopping-bag"></i> Products</a>
                <a href="/contact"><i class="fas fa-envelope"></i> Contact</a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>