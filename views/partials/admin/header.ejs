<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'MilliMillet - Admin Dashboard' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- <style>
        /* === All your CSS from <style> tag === */
        <%- include('../partials/styles') %>
    </style> -->
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="logo">
            <svg class="logo-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 5L15 15L10 25L20 35L30 25L25 15L20 5Z" fill="#5a4a2a"/>
                <path d="M20 5L15 15L25 15L20 5Z" fill="#7a6a4a"/>
            </svg>
            <h2>MILLIMILLET</h2>
        </div>
        <ul class="nav-menu">
            <li class="nav-item"><a href="#" class="nav-link active"><i class="fas fa-th-large"></i><span>Dashboard</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-list"></i><span>Category</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-box"></i><span>Products</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-users"></i><span>Customers</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-shopping-cart"></i><span>Orders</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-flag"></i><span>Banner</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-ticket-alt"></i><span>Coupon</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-cog"></i><span>Settings</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-gift"></i><span>Offer</span></a></li>
            <li class="nav-item"><a href="#" class="nav-link"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="top-bar">
            <div class="user-profile">
                <img src="https://via.placeholder.com/50" alt="Rahina Ummer" class="user-avatar">
                <div class="user-info">
                    <h6>Rahina Ummer</h6>
                    <p>Admin</p>
                </div>
            </div>
        </div>
