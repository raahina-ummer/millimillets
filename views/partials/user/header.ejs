<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MilliMillet- Nature's Ancient Superfood</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f5f5f5;
      }

      /* Header Styles */
      header {
        background-color: #8b7355;
        padding: 15px 0;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        position: relative;
        z-index: 50;
      }

      .header-container {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 20px;
        gap: 20px;
      }

      /* Mobile Menu Toggle */
      .menu-toggle {
        display: none;
        background: none;
        border: none;
        color: #fff;
        font-size: 24px;
        cursor: pointer;
        padding: 5px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .logo-icon {
        width: 40px;
        height: 40px;
        background-color: #d4af37;
        border-radius: 50%;
      }

      .logo h1 {
        color: #fff;
        font-size: 24px;
        font-weight: 600;
        margin: 0;
      }

      nav ul {
        display: flex;
        list-style: none;
        gap: 30px;
        margin: 0;
        padding: 0;
      }

      nav a {
        color: #fff;
        text-decoration: none;
        font-size: 16px;
        transition: color 0.3s;
      }

      nav a:hover {
        color: #d4af37;
      }

      .header-icons {
        display: flex;
        gap: 20px;
      }

      .icon-btn {
        background: none;
        border: none;
        color: #fff;
        font-size: 20px;
        cursor: pointer;
        position: relative;
      }

      .icon-btn:hover {
        color: #d4af37;
      }

      /* Cart Badge */
      .cart-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background-color: #c53030;
        color: white;
        border-radius: 50%;
        width: 18px;
        height: 18px;
        font-size: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
      }

      .dropdown {
        position: relative;
        display: inline-block;
      }

      .dropdown-content {
        display: none;
        position: absolute;
        background-color: white;
        min-width: 180px;
        box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
        z-index: 1000;
        right: 0;
        border-radius: 8px;
        overflow: hidden;
      }

      .dropdown-content a {
        color: #2d2d2d;
        padding: 12px 16px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        transition: background-color 0.2s;
      }

      .dropdown-content a i {
        width: 20px;
        color: #8b7355;
      }

      .dropdown-content a:hover {
        background-color: #f9f6f1;
        color: #8b7355;
      }

      .dropdown:hover .dropdown-content {
        display: block;
      }

      .signin-link {
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      /* Mobile Navigation */
      .mobile-nav {
        display: none;
        position: fixed;
        top: 0;
        right: -100%;
        width: 280px;
        height: 100vh;
        background-color: #ffffff;
        box-shadow: -4px 0 15px rgba(0, 0, 0, 0.1);
        transition: right 0.3s ease;
        z-index: 1000;
        overflow-y: auto;
      }

      .mobile-nav.active {
        right: 0;
      }

      .mobile-nav-header {
        padding: 20px;
        background: linear-gradient(135deg, #8B7355 0%, #755e45 100%);
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .mobile-nav-close {
        background: none;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
      }

      .mobile-nav-links {
        padding: 20px 0;
      }

      .mobile-nav-links a {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px 20px;
        color: #2d2d2d;
        text-decoration: none;
        transition: background-color 0.3s;
      }

      .mobile-nav-links a:hover {
        background-color: #f9f6f1;
        color: #8b7355;
      }

      .mobile-nav-links a i {
        width: 20px;
        color: #8b7355;
      }

      .mobile-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 999;
      }

      .mobile-overlay.active {
        display: block;
      }

      /* Responsive */
      @media (max-width: 992px) {
        nav {
          display: none;
        }

        .menu-toggle {
          display: block;
        }

        .header-container {
          gap: 15px;
        }

        .logo h1 {
          font-size: 20px;
        }

        .header-icons {
          gap: 15px;
        }
      }

      @media (max-width: 480px) {
        .logo h1 {
          font-size: 18px;
        }

        .icon-btn {
          font-size: 18px;
        }
      }
    </style>
  </head>
  <body>
    <!-- Mobile Overlay -->
    <div class="mobile-overlay" id="mobileOverlay" onclick="toggleMobileMenu()"></div>

    <!-- Mobile Navigation -->
    <div class="mobile-nav" id="mobileNav">
      <div class="mobile-nav-header">
        <div>
          <i class="fas fa-seedling"></i>
          <span style="font-weight: 700; margin-left: 10px;">MilliMillet</span>
        </div>
        <button class="mobile-nav-close" onclick="toggleMobileMenu()">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <div class="mobile-nav-links">
        <a href="/"><i class="fas fa-home"></i> Home</a>
        <a href="/shop"><i class="fas fa-store"></i> Shop</a>
        <a href="/about"><i class="fas fa-info-circle"></i> About</a>
        <a href="/contact"><i class="fas fa-envelope"></i> Contact</a>
        
        <% if(user) { %>
          <hr style="margin: 20px 0; border-color: #e0e0e0;">
          <a href="/userProfile"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
          <a href="/orders"><i class="fas fa-shopping-bag"></i> My Orders</a>
          <a href="/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
          <a href="/address"><i class="fas fa-map-marker-alt"></i> Addresses</a>
          <a href="/editProfile"><i class="fas fa-user-edit"></i> Edit Profile</a>
          <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        <% } else { %>
          <hr style="margin: 20px 0; border-color: #e0e0e0;">
          <a href="/login"><i class="fas fa-sign-in-alt"></i> Login</a>
          <a href="/signup"><i class="fas fa-user-plus"></i> Sign Up</a>
        <% } %>
      </div>
    </div>

    <!-- Header -->
    <header>
      <div class="header-container">
        <!-- Hamburger Menu (Mobile Only) -->
        <button class="menu-toggle" onclick="toggleMobileMenu()">
          <i class="fas fa-bars"></i>
        </button>

        <div class="logo">
          <!-- <div class="logo-icon"></div> -->
          <h1>MILLIMILLET</h1>
        </div>

        <!-- Desktop Navigation -->
        <nav>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/shop">Shop</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
            <% if(user) { %>
            <li class="dropdown">
              <a href="#" class="signin-link">
                <i class="fas fa-user-circle"></i>
                <%= user.name %>
              </a>
              <div class="dropdown-content">
                <a href="/userProfile"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
                <a href="/orders"><i class="fas fa-shopping-bag"></i> My Orders</a>
                <a href="/wishlist"><i class="fas fa-heart"></i> Wishlist</a>
                <a href="/address"><i class="fas fa-map-marker-alt"></i> Addresses</a>
                <a href="/editProfile"><i class="fas fa-user-edit"></i> Edit Profile</a>
                <a href="/logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
              </div>
            </li>
            <% } else { %>
            <li><a href="/signup">Signup</a></li>
            <li><a href="/login">Login</a></li>
            <% } %>
          </ul>
        </nav>

        <!-- Header Icons -->
        <div class="header-icons">
          <button class="icon-btn" onclick="window.location.href='/shop'">
            <i class="fas fa-search"></i>
          </button>
          <button class="icon-btn" onclick="window.location.href='/wishlist'">
            <i class="fas fa-heart"></i>
          </button>
          <button class="icon-btn" onclick="window.location.href='/cart'">
            <i class="fas fa-shopping-cart"></i>
          
   <span class="cart-badge" id="cartCountDisplay"></span>

          </button>
        </div>
      </div>

      <script>
        let cartCountDisplay = document.getElementById("cartCountDisplay");

        async function fetchCount() {
          fetch("/cartCount")
          .then((res)=> res.json())
          .then((data)=>{
            console.log(data);
            if(data.cartCount)
          {
            
            cartCountDisplay.innerHTML = data.cartCount;
          }
          })
        } 

        fetchCount()
      </script>
    </header>

    <script>
      function toggleMobileMenu() {
        const mobileNav = document.getElementById('mobileNav');
        const overlay = document.getElementById('mobileOverlay');
        
        mobileNav.classList.toggle('active');
        overlay.classList.toggle('active');
      }

      // Close mobile menu when clicking a link
      document.querySelectorAll('.mobile-nav-links a').forEach(item => {
        item.addEventListener('click', function() {
          toggleMobileMenu();
        });
      });

      // Prevent body scroll when mobile menu is open
      const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
          if (mutation.target.classList.contains('active')) {
            document.body.style.overflow = 'hidden';
          } else {
            document.body.style.overflow = '';
          }
        });
      });

      const mobileNav = document.getElementById('mobileNav');
      if (mobileNav) {
        observer.observe(mobileNav, {
          attributes: true,
          attributeFilter: ['class']
        });
      }
    </script>
  </body>
</html>